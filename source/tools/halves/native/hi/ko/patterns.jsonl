{"id":"ko.p001","meaning":"विषय पार्टिकल: \"जहाँ तक … की बात है\"; तुलना, आम बातें"}
{"id":"ko.p002","meaning":"कर्ता पार्टिकल: ख़ास तौर पर कौन या क्या; नई जानकारी"}
{"id":"ko.p003","meaning":"कर्म पार्टिकल"}
{"id":"ko.p004","meaning":"को / में / पर (मंज़िल, समय)"}
{"id":"ko.p005","meaning":"में (जहाँ काम होता है) / से"}
{"id":"ko.p006","meaning":"भी (은/는/이/가/을/를 की जगह लेता है)"}
{"id":"ko.p007","meaning":"संबंध (का / की / के); अक्सर 에 बोला जाता है"}
{"id":"ko.p008","meaning":"और / के साथ"}
{"id":"ko.p009","meaning":"सिर्फ़ / ही"}
{"id":"ko.p010","meaning":"की ओर / के ज़रिए"}
{"id":"ko.p011","meaning":"विनम्र वर्तमान काल (ㅏ/ㅗ वाले स्टेम → 아요, बाक़ी → 어요, 하다 → 해요)"}
{"id":"ko.p012","meaning":"विनम्र भूतकाल"}
{"id":"ko.p013","meaning":"भविष्य / इरादा"}
{"id":"ko.p014","meaning":"नहीं (अपनी मर्ज़ी से)"}
{"id":"ko.p015","meaning":"नहीं कर सकना (क्षमता, हालात)"}
{"id":"ko.p016","meaning":"नहीं (안 से थोड़ा औपचारिक)"}
{"id":"ko.p017","meaning":"कर सकना / नहीं कर सकना"}
{"id":"ko.p018","meaning":"…करें? (सुझाव)"}
{"id":"ko.p019","meaning":"…करना चाहेंगे?"}
{"id":"ko.p020","meaning":"चलो …! (अनौपचारिक)"}
{"id":"ko.p021","meaning":"…करूँगा/करूँगी (वादा, बोलने वाले का इरादा)"}
{"id":"ko.p022","meaning":"विनम्र अनुरोध / सम्मानसूचक वर्तमान"}
{"id":"ko.p023","meaning":"(मेरे लिए) कर दीजिए"}
{"id":"ko.p024","meaning":"मत … (आदेश)"}
{"id":"ko.p025","meaning":"कुछ देखकर कहना / हल्की हैरानी"}
{"id":"ko.p026","meaning":"हल्का \"लेकिन\", बात की पृष्ठभूमि"}
{"id":"ko.p027","meaning":"है (व्यंजन के बाद / स्वर के बाद)"}
{"id":"ko.p028","meaning":"है, पास है / नहीं है"}
{"id":"ko.p029","meaning":"…करने जाना"}
{"id":"ko.p030","meaning":"…करने का मन है"}
{"id":"ko.p031","meaning":"मुझे लगता है / ऐसा लगता है"}
{"id":"ko.p032","meaning":"अगर / जब"}
{"id":"ko.p033","meaning":"चीज़ें, लोग, कप, उम्र, घंटे"}
{"id":"ko.p034","meaning":"पैसे, तारीख़, मिनट, फ़ोन नंबर, मंज़िल"}
{"id":"ko.p035","meaning":"और फिर / इसलिए / लेकिन"}
{"id":"ko.p036","meaning":"संबोधन: नाम के साथ विनम्र, पद के साथ, अनौपचारिक पुकार"}
{"id":"ko.p037","meaning":"सम्मानसूचक: कर्ता को ऊँचा दर्जा देता है (बुज़ुर्ग, ग्राहक)"}
{"id":"ko.p038","meaning":"먹다·마시다 / 자다 / 있다 की जगह आने वाले सम्मानसूचक शब्द"}
{"id":"ko.p039","meaning":"नरम करने वाला शब्द: \"ज़रा\" / \"थोड़ा\""}
{"id":"ko.p040","meaning":"\"शायद / कहीं\" — विनम्र सवाल की शुरुआत"}
{"id":"ko.p041","meaning":"\"…दीजिएगा?\" (बहुत विनम्र अनुरोध)"}
{"id":"ko.p042","meaning":"\"… तो चलेगा?\" (इजाज़त)"}
{"id":"ko.p043","meaning":"\"…कर लूँ?\""}
{"id":"ko.p044","meaning":"सहकर्मियों को पद से बुलाएँ, सिर्फ़ नाम से कभी नहीं"}
{"id":"ko.p045","meaning":"काम पर विदाई: रुकने वालों से / काम के बाद सीनियर से"}
{"id":"ko.p046","meaning":"ईमेल की शुरुआत: \"लिखने की वजह यह है कि…\""}
{"id":"ko.p047","meaning":"अनुरोध के अंत में विनम्र शब्द (ख़ुद को नीचे रखकर)"}
