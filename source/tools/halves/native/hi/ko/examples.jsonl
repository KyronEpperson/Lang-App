{"id":"ko.e203","tr":"हमारी दुकान में आपका स्वागत है।"}
{"id":"ko.e204","tr":"यह मेरा है। (अनौपचारिक)"}
{"id":"ko.e205","tr":"मेरा नाम मिनजुन है।"}
{"id":"ko.e206","tr":"उसने एक शब्द भी नहीं कहा। (लिखित शैली)"}
{"id":"ko.e207","tr":"उसने मुस्कुराते हुए जवाब दिया। (लिखित शैली)"}
{"id":"ko.e208","tr":"मुझे आपसे प्यार है। (किसी गाने की लाइन, या बरसों पुराने शादीशुदा जोड़े में)"}
{"id":"ko.e209","tr":"अपना काम ख़ुद कीजिए।"}
{"id":"ko.e210","tr":"आप सभी को नमस्ते!"}
{"id":"ko.e211","tr":"जीसू जी, कॉफ़ी पिएँगे?"}
{"id":"ko.e212","tr":"और आपका नाम क्या है?"}
{"id":"ko.e213","tr":"वहाँ वह व्यक्ति कौन है?"}
{"id":"ko.e214","tr":"वीकेंड पर आपने क्या किया?"}
{"id":"ko.e215","tr":"मैं आपकी क्या मदद करूँ?"}
{"id":"ko.e216","tr":"आप कहाँ रहते हैं?"}
{"id":"ko.e217","tr":"यह मेरी किताब है।"}
{"id":"ko.e218","tr":"वह भी अच्छा आइडिया है।"}
{"id":"ko.e219","tr":"वहाँ वह क्या है?"}
{"id":"ko.e220","tr":"यह वाला कितने का है?"}
{"id":"ko.e221","tr":"वह वाला स्वादिष्ट है?"}
{"id":"ko.e222","tr":"वहाँ वाला वह दीजिए।"}
{"id":"ko.e223","tr":"वह जगह कितने बजे तक खुली रहती है?"}
{"id":"ko.e224","tr":"ये मेरे टीचर हैं।"}
{"id":"ko.e225","tr":"वे सच में बहुत मेहरबान हैं।"}
{"id":"ko.e226","tr":"क्या वहाँ वे मालिक हैं?"}
{"id":"ko.e227","tr":"यह मेरा छोटा भाई (या छोटी बहन) है।"}
{"id":"ko.e228","tr":"वह आजकल व्यस्त है। (एक दोस्त के बारे में)"}
{"id":"ko.e229","tr":"वहाँ वह कौन है? (अनौपचारिक)"}
{"id":"ko.e230","tr":"इधर आइए।"}
{"id":"ko.e231","tr":"टॉयलेट उधर है।"}
{"id":"ko.e232","tr":"कभी भी संपर्क कीजिए।"}
{"id":"ko.e233","tr":"घर पर कोई नहीं है।"}
{"id":"ko.e234","tr":"मैंने सुबह कुछ नहीं खाया।"}
{"id":"ko.e235","tr":"किसी ने दरवाज़ा खोला।"}
{"id":"ko.e236","tr":"कुछ गड़बड़ है।"}
{"id":"ko.e237","tr":"मेरा फ़ोन घर में ही कहीं होगा।"}
{"id":"ko.e238","tr":"ख़ुद पर भरोसा रखिए।"}
{"id":"ko.e239","tr":"मैं मेट्रो से जाता/जाती हूँ।"}
{"id":"ko.e240","tr":"कितने बजे तक खुला रहता है?"}
{"id":"ko.e241","tr":"क्लास नौ बजे से है।"}
{"id":"ko.e242","tr":"मैंने एक दोस्त को तोहफ़ा दिया।"}
{"id":"ko.e243","tr":"मैंने टीचर को ईमेल भेजा।"}
{"id":"ko.e244","tr":"मैंने दादी जी को फ़ोन किया।"}
{"id":"ko.e245","tr":"दीदी का मैसेज आया।"}
{"id":"ko.e246","tr":"आज बीते कल से ज़्यादा ठंड है।"}
{"id":"ko.e247","tr":"आप कोरियाई की तरह बोलते हैं।"}
{"id":"ko.e248","tr":"मैं हर वीकेंड हाइकिंग पर जाता/जाती हूँ।"}
{"id":"ko.e249","tr":"मेरे पास सिर्फ़ हज़ार वॉन हैं।"}
{"id":"ko.e250","tr":"कॉफ़ी या चाय लेंगे?"}
{"id":"ko.e251","tr":"मैंने एक दोस्त के साथ फ़िल्म देखी।"}
{"id":"ko.e252","tr":"दादा जी आ गए हैं।"}
{"id":"ko.e253","tr":"तीन बजे के आसपास मिलते हैं।"}
{"id":"ko.e254","tr":"हर व्यक्ति एक-एक ले लीजिए।"}
{"id":"ko.e255","tr":"वैसे, कल आपके पास समय है?"}
{"id":"ko.e256","tr":"बारिश हो रही है। इसलिए छाता ले जाइए।"}
{"id":"ko.e257","tr":"महँगा है। फिर भी स्वादिष्ट है।"}
{"id":"ko.e258","tr":"यह जगह सस्ती है। ऊपर से स्वादिष्ट भी।"}
{"id":"ko.e259","tr":"मैं खाना खाकर कॉफ़ी पीता/पीती हूँ।"}
{"id":"ko.e260","tr":"महँगा है, लेकिन स्वादिष्ट है।"}
{"id":"ko.e261","tr":"मैंने बाज़ार जाकर फल ख़रीदे।"}
{"id":"ko.e262","tr":"थकान की वजह से जल्दी नींद आ गई।"}
{"id":"ko.e263","tr":"कोरिया जाएँ तो आपका क्या करने का मन है?"}
{"id":"ko.e264","tr":"बारिश हो रही है, तो टैक्सी ले लेते हैं।"}
{"id":"ko.e265","tr":"अभी व्यस्त हूँ, बाद में फ़ोन करता/करती हूँ।"}
{"id":"ko.e266","tr":"चलिए लंच करने चलते हैं।"}
{"id":"ko.e267","tr":"मैं चलते-चलते गाने सुनता/सुनती हूँ।"}
{"id":"ko.e268","tr":"स्कूल जाते हुए रास्ते में एक दोस्त मिल गया।"}
{"id":"ko.e269","tr":"वीकेंड पर मेरा काम बस सोना या फ़िल्में देखना है।"}
{"id":"ko.e270","tr":"महँगा हो तब भी, मेरा इसे ख़रीदने का मन है।"}
{"id":"ko.e271","tr":"मैं सोने से पहले किताब पढ़ता/पढ़ती हूँ।"}
{"id":"ko.e272","tr":"खाने के बाद मैं टहलने जाता/जाती हूँ।"}
{"id":"ko.e273","tr":"कोरिया जाते समय मैं तोहफ़े ख़रीदता/ख़रीदती हूँ।"}
{"id":"ko.e274","tr":"घर पहुँचते ही मुझे नींद आ गई।"}
{"id":"ko.e275","tr":"आज मेरे पास बहुत ज़्यादा काम है।"}
