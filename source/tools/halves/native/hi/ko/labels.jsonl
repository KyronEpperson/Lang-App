{"id":"ko.z.compliment","text":"तारीफ़"}
{"id":"ko.z.compliment.01","text":"बहुत शानदार / क्या बात है"}
{"id":"ko.z.compliment.02","text":"आप बेस्ट हैं"}
{"id":"ko.z.compliment.03","text":"यह तो कमाल है"}
{"id":"ko.z.compliment.04","text":"बहुत अच्छा किया"}
{"id":"ko.z.compliment.05","text":"आपकी पसंद बढ़िया है"}
{"id":"ko.z.compliment.06","text":"आप बहुत दयालु हैं"}
{"id":"ko.z.compliment.07","text":"आप होशियार हैं"}
{"id":"ko.z.compliment.08","text":"आप मज़ेदार हैं"}
{"id":"ko.z.compliment.09","text":"आपकी मुस्कान प्यारी है"}
{"id":"ko.z.compliment.10","text":"आपकी आवाज़ अच्छी है"}
{"id":"ko.z.compliment.11","text":"आप भरोसेमंद हैं"}
{"id":"ko.z.compliment.12","text":"आप पर जँचता है"}
{"id":"ko.z.compliment.13","text":"आपके होने से सहारा मिलता है"}
{"id":"ko.z.compliment.14","text":"आप लाजवाब हैं"}
{"id":"ko.z.compliment.15","text":"आपका स्वभाव बहुत अच्छा है"}
{"id":"ko.z.compliment.16","text":"आपकी कोरियाई बहुत अच्छी है"}
{"id":"ko.z.compliment.17","text":"आपमें एक अलग ही बात है"}
{"id":"ko.z.compliment.18","text":"नेकदिल इंसान"}
{"id":"ko.z.compliment.19","text":"आपसे बहुत कुछ सीखने को मिलता है"}
{"id":"ko.z.compliment.20","text":"आपके साथ सुकून मिलता है"}
{"id":"ko.z.compliment.21","text":"आपकी मेहनत कमाल की है"}
{"id":"ko.z.compliment.22","text":"आपकी सोच गहरी है"}
{"id":"ko.z.expression","text":"रोज़ की बोलचाल"}
{"id":"ko.z.expression.01","text":"सच में?"}
{"id":"ko.z.expression.02","text":"अच्छा, ऐसा है"}
{"id":"ko.z.expression.03","text":"सही है"}
{"id":"ko.z.expression.04","text":"बिल्कुल"}
{"id":"ko.z.expression.05","text":"हम्म… पता नहीं"}
{"id":"ko.z.expression.06","text":"शायद"}
{"id":"ko.z.expression.07","text":"कोई बात नहीं / ठीक है"}
{"id":"ko.z.expression.08","text":"समझ आ गया"}
{"id":"ko.z.expression.09","text":"एक मिनट"}
{"id":"ko.z.expression.10","text":"फिर से बोलिए"}
{"id":"ko.z.expression.11","text":"अब क्या करूँ / हाय"}
{"id":"ko.z.expression.12","text":"ज़बरदस्त / क्या बात है"}
{"id":"ko.z.expression.13","text":"तभी तो"}
{"id":"ko.z.expression.14","text":"ऐसा तो नहीं हो सकता"}
{"id":"ko.z.expression.15","text":"ज़ाहिर-सी बात है"}
{"id":"ko.z.expression.16","text":"हाँ, वही तो"}
{"id":"ko.z.expression.17","text":"हाय राम / उफ़"}
{"id":"ko.z.expression.18","text":"ज़रूर"}
{"id":"ko.z.expression.19","text":"मुझे ठीक से नहीं पता"}
{"id":"ko.z.expression.20","text":"बहुत दिनों बाद मिले"}
{"id":"ko.z.expression.21","text":"आज की मेहनत के लिए धन्यवाद"}
{"id":"ko.z.expression.22","text":"खाने के लिए धन्यवाद (खाने से पहले)"}
{"id":"ko.z.expression.23","text":"बहुत स्वादिष्ट था, धन्यवाद (खाने के बाद)"}
{"id":"ko.z.expression.24","text":"ध्यान से जाइए"}
{"id":"ko.z.expression.25","text":"आपका दिन अच्छा रहे"}
{"id":"ko.z.expression.26","text":"इसका मतलब क्या है?"}
{"id":"ko.z.polite","text":"शिष्टाचार की बातें"}
{"id":"ko.z.polite.01","text":"दीजिए (कुछ माँगते समय)"}
{"id":"ko.z.polite.02","text":"आपसे एक गुज़ारिश है"}
{"id":"ko.z.polite.03","text":"एक्सक्यूज़ मी / इजाज़त हो तो"}
{"id":"ko.z.polite.04","text":"सुनिए (ध्यान खींचने के लिए)"}
{"id":"ko.z.polite.05","text":"बस एक सेकंड"}
{"id":"ko.z.polite.06","text":"माफ़ कीजिए"}
{"id":"ko.z.polite.07","text":"धन्यवाद"}
{"id":"ko.z.polite.08","text":"शुक्रिया"}
{"id":"ko.z.polite.09","text":"अरे, इसमें क्या है (शाब्दिक: \"ऐसा नहीं है\")"}
{"id":"ko.z.polite.10","text":"ठीक है / जी नहीं, रहने दीजिए"}
{"id":"ko.z.polite.11","text":"नमस्ते"}
{"id":"ko.z.polite.12","text":"आराम से रहिए (रुकने वाले से)"}
{"id":"ko.z.polite.13","text":"आराम से जाइए (जाने वाले से)"}
{"id":"ko.z.polite.14","text":"मदद कीजिए"}
{"id":"ko.z.polite.15","text":"आपसे मिलकर ख़ुशी हुई (पहली मुलाक़ात में)"}
{"id":"ko.z.polite.16","text":"मिलकर अच्छा लगा"}
{"id":"ko.z.polite.17","text":"पहले आप / आगे बढ़िए"}
{"id":"ko.z.polite.18","text":"निकलने दीजिए"}
{"id":"ko.z.saying","text":"कहावत"}
{"id":"ko.z.saying.01","text":"शुरुआत करना आधी जीत है"}
{"id":"ko.z.saying.02","text":"सपने सच होते हैं"}
{"id":"ko.z.saying.03","text":"ठान लो तो सब मुमकिन है"}
{"id":"ko.z.saying.04","text":"हार मत मानो"}
{"id":"ko.z.saying.05","text":"बूँद-बूँद से घड़ा भरता है"}
{"id":"ko.z.saying.06","text":"आज ही होना था! (बुरी टाइमिंग)"}
{"id":"ko.z.saying.07","text":"बाएँ हाथ का खेल"}
{"id":"ko.z.saying.08","text":"भूखे भजन न होय गोपाला"}
{"id":"ko.z.saying.09","text":"मुस्कुराओ, क़िस्मत ख़ुद आएगी"}
{"id":"ko.z.saying.10","text":"दुख के बाद सुख आता है"}
{"id":"ko.z.saying.11","text":"लंबा सफ़र भी एक क़दम से शुरू होता है"}
{"id":"ko.z.saying.12","text":"पुरानी आदतें आसानी से नहीं छूटतीं"}
{"id":"ko.z.saying.13","text":"एक और एक ग्यारह"}
{"id":"ko.z.saying.14","text":"आज भी हिम्मत रखिए"}
{"id":"ko.z.saying.15","text":"तुमसे हो जाएगा"}
{"id":"ko.z.saying.16","text":"कोई बात नहीं, सब ठीक हो जाएगा"}
{"id":"ko.z.saying.17","text":"ज़िंदगी एक ही बार मिलती है"}
{"id":"ko.z.saying.18","text":"धीरे चलना भी ठीक है"}
{"id":"ko.z.saying.19","text":"बंदर भी पेड़ से गिर जाते हैं"}
{"id":"ko.z.saying.20","text":"मीठे बोल से बड़ा क़र्ज़ भी उतर जाता है"}
{"id":"ko.i01","text":"आपकी हर मनोकामना पूरी हो"}
{"id":"ko.i02","text":"एक पंथ दो काज"}
{"id":"ko.i03","text":"जो होता है, अच्छे के लिए होता है — बुरी क़िस्मत भी अच्छी बन सकती है"}
{"id":"ko.i04","text":"मुसीबत को अच्छे मौक़े में बदलना"}
{"id":"ko.i05","text":"कड़वे के बाद मीठा आता है"}
{"id":"ko.i06","text":"बड़ी प्रतिभाएँ देर से खिलती हैं"}
{"id":"ko.i07","text":"पहले से तैयारी हो तो कोई फ़िक्र नहीं"}
{"id":"ko.i08","text":"सात बार गिरो, आठ बार उठो"}
{"id":"ko.i09","text":"तीन दिन का जोश"}
{"id":"ko.i10","text":"बिना कहे एक-दूसरे को समझना"}
{"id":"ko.i11","text":"दुख-सुख में साथ निभाना"}
{"id":"ko.i12","text":"सोने पे सुहागा"}
{"id":"ko.i13","text":"जितना ज़्यादा, उतना अच्छा"}
{"id":"ko.i14","text":"दिन-ब-दिन तरक़्क़ी"}
{"id":"ko.i15","text":"जैसी करनी वैसी भरनी"}
{"id":"ko.i16","text":"लगन से पहाड़ भी हिल जाते हैं"}
{"id":"ko.i17","text":"कड़ी पढ़ाई से मिली कामयाबी"}
{"id":"ko.i18","text":"दूसरों की ग़लतियों से सीखना"}
{"id":"ko.i19","text":"अति हर चीज़ की बुरी होती है"}
{"id":"ko.i20","text":"ख़ुद को दूसरे की जगह रखकर देखना"}
{"id":"ko.i21","text":"जोड़ी ऊपर से बनकर आई है"}
{"id":"ko.i22","text":"अटूट, सच्चे दिल से निष्ठा"}
{"id":"ko.i23","text":"बाघ की तरह मौक़े की ताक में रहना"}
{"id":"ko.i24","text":"बचपन का दोस्त"}
{"id":"ko.i25","text":"पुराना पढ़कर नया सीखना"}
{"id":"ko.i26","text":"अच्छी तरह सोच-विचार करना"}
{"id":"ko.i27","text":"अच्छाई का इनाम, बुराई की सज़ा"}
{"id":"ko.i28","text":"एक कान से सुनना, दूसरे से निकाल देना"}
{"id":"ko.i29","text":"दस में से नौ बार"}
{"id":"ko.i30","text":"हर लड़ाई में जीत"}
{"id":"ko.i31","text":"अपने दम पर मिली कामयाबी"}
{"id":"ko.i32","text":"शुरुआती लक्ष्य पर डटे रहना"}
{"id":"ko.d.mydeck","text":"जो कुछ आप ख़ुद जोड़ें।"}
