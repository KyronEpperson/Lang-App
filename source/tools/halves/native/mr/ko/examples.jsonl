{"id":"ko.e001","tr":"एक ग्लास पाणी द्या."}
{"id":"ko.e002","tr":"जेवलात का?"}
{"id":"ko.e003","tr":"तुम्हाला मांस आवडतं का?"}
{"id":"ko.e004","tr":"हे खरंच खूप चविष्ट आहे."}
{"id":"ko.e005","tr":"मला भूक लागली आहे. काय खाऊया?"}
{"id":"ko.e006","tr":"चला, चिअर्स!"}
{"id":"ko.e007","tr":"आज हवामान छान आहे."}
{"id":"ko.e008","tr":"उद्या तुम्हाला वेळ आहे का?"}
{"id":"ko.e009","tr":"काल मी उशिरा झोपलो/झोपले."}
{"id":"ko.e010","tr":"मी आता निघत आहे!"}
{"id":"ko.e011","tr":"सोमवार नेहमी बिझी असतो."}
{"id":"ko.e012","tr":"शुक्रवारी भेटूया."}
{"id":"ko.e013","tr":"तुम्ही कोरियाला कधी आलात?"}
{"id":"ko.e014","tr":"मी रोज व्यायाम करत आहे."}
{"id":"ko.e015","tr":"आज खूप उकडतंय."}
{"id":"ko.e016","tr":"बाहेर थंडी आहे. उबदार कपडे घाला."}
{"id":"ko.e017","tr":"पाऊस पडत आहे. तुमच्याकडे छत्री आहे का?"}
{"id":"ko.e018","tr":"वा, बर्फ पडतोय!"}
{"id":"ko.e019","tr":"आज माझा मूड छान आहे."}
{"id":"ko.e020","tr":"आपण एकत्र आहोत म्हणून मी खूश आहे."}
{"id":"ko.e021","tr":"चित्रपट फार दुःखद आहे."}
{"id":"ko.e022","tr":"इंटरव्ह्यूमुळे मला टेन्शन आलंय."}
{"id":"ko.e023","tr":"तुम्ही का रागावलात?"}
{"id":"ko.e024","tr":"उद्या ट्रिप आहे म्हणून मला खूप उत्सुकता वाटतेय."}
{"id":"ko.e025","tr":"आई छान स्वयंपाक करते."}
{"id":"ko.e026","tr":"दादा, हे काय आहे?"}
{"id":"ko.e027","tr":"ताई, तुमचे कपडे छान आहेत."}
{"id":"ko.e028","tr":"मला दोन लहान भावंडं आहेत."}
{"id":"ko.e029","tr":"मी आजीकडे जात आहे."}
{"id":"ko.e030","tr":"मला कुटुंबाची आठवण येतेय."}
{"id":"ko.e031","tr":"मी मित्राबरोबर चित्रपट पाहिला."}
{"id":"ko.e032","tr":"सर / मॅडम, माझा एक प्रश्न आहे."}
{"id":"ko.e033","tr":"ती तिकडची स्त्री कोण आहे?"}
{"id":"ko.e034","tr":"इथे खूप लोक आहेत."}
{"id":"ko.e035","tr":"एक सफरचंद द्या."}
{"id":"ko.e036","tr":"दोन जण."}
{"id":"ko.e037","tr":"तीन कॉफी द्या."}
{"id":"ko.e038","tr":"मी बिअरच्या चार बाटल्या घेतल्या."}
{"id":"ko.e039","tr":"मी पाच मांजरी पाळल्या आहेत."}
{"id":"ko.e040","tr":"मी सहा पुस्तकं वाचली."}
{"id":"ko.e041","tr":"माझ्याकडे सात तिकिटं आहेत."}
{"id":"ko.e042","tr":"मी दोन तास वाट पाहिली."}
{"id":"ko.e043","tr":"मी तीन वेळा फोन केला."}
{"id":"ko.e044","tr":"मी महिनाभर कोरियात आहे."}
{"id":"ko.e045","tr":"जेवण झालं. आणि मग कॉफी प्यायली."}
{"id":"ko.e046","tr":"मला थकवा आलाय. म्हणून मी लवकर झोपणार आहे."}
{"id":"ko.e047","tr":"चविष्ट आहे. पण जरा महाग आहे."}
{"id":"ko.e048","tr":"अवघड आहे. पण मजा येते."}
{"id":"ko.e049","tr":"त्यानंतर तुम्ही काय केलंत?"}
{"id":"ko.e050","tr":"तुम्ही आधी जा."}
{"id":"ko.e051","tr":"कारण माझ्याकडे वेळ नाही."}
{"id":"ko.e052","tr":"कॉफी की चहा?"}
{"id":"ko.e053","tr":"मग उद्या भेटूया."}
{"id":"ko.e054","tr":"खरं तर मला कोरियन नीट येत नाही."}
{"id":"ko.e055","tr":"मला हे गाणं आवडतं."}
{"id":"ko.e056","tr":"हवामान खराब आहे."}
{"id":"ko.e057","tr":"घर मोठं आहे."}
{"id":"ko.e058","tr":"खोली लहान आहे."}
{"id":"ko.e059","tr":"मला खूप कामं आहेत."}
{"id":"ko.e060","tr":"हे फारच महाग आहे."}
{"id":"ko.e061","tr":"इथे स्वस्त आहे."}
{"id":"ko.e062","tr":"सध्या तुम्ही बिझी आहात का?"}
{"id":"ko.e063","tr":"कोरियनचा अभ्यास मजेशीर आहे."}
{"id":"ko.e064","tr":"आजचा दिवस खरंच दमवणारा आहे."}
{"id":"ko.e065","tr":"खरं सांग. आपलं नातं काय आहे?"}
{"id":"ko.e066","tr":"मी गंमत करत नाहीये. मला तुला गंभीरपणे डेट करावंसं वाटतं."}
{"id":"ko.e067","tr":"डिनरचे पैसे मी देईन. आता राग सोड."}
{"id":"ko.e068","tr":"आज 100 दिवस झाले. 100 दिवसांच्या शुभेच्छा!"}
{"id":"ko.e069","tr":"आवडी अगदी सारख्या आहेत. मला वाटतं आपलं छान जुळतं."}
{"id":"ko.e070","tr":"उद्याची मीटिंग किती वाजता आहे? कॅलेंडरमध्ये नाही."}
{"id":"ko.e071","tr":"या रिपोर्टची डेडलाइन कधी आहे?"}
{"id":"ko.e072","tr":"मॅनेजर, तुम्हाला जरा वेळ आहे का?"}
{"id":"ko.e073","tr":"मी आधी निघत आहे."}
{"id":"ko.e074","tr":"आज मला उशिरापर्यंत काम करायला हवं. टीम डिनर पुढच्या वेळी."}
{"id":"ko.e075","tr":"आज माझ्याकडे वेळ नाही."}
{"id":"ko.e076","tr":"इथे फोटो काढू का?"}
{"id":"ko.e077","tr":"कोरियनमध्ये बोला ना."}
{"id":"ko.e078","tr":"वाढदिवसाला मला खूप भेटवस्तू मिळाल्या."}
{"id":"ko.e079","tr":"मेट्रो स्टेशनमधून बाहेर आलात की अगदी समोरच आहे."}
{"id":"ko.e080","tr":"मी सोलमध्ये राहत आहे."}
{"id":"ko.e081","tr":"आईने किमबाप बनवला."}
{"id":"ko.e082","tr":"मलाही तसंच वाटतं."}
{"id":"ko.e083","tr":"मला कोरियाला जावंसं वाटतं."}
{"id":"ko.e084","tr":"इथून समुद्र दिसतो."}
{"id":"ko.e085","tr":"वीकेंडला मी मित्राला भेटत आहे."}
{"id":"ko.e086","tr":"आज बिल मी देईन."}
{"id":"ko.e087","tr":"इथे तुमचं नाव लिहा."}
{"id":"ko.e088","tr":"ही बॅग जरा धरा ना."}
{"id":"ko.e089","tr":"चित्रपट सात वाजता सुरू होतो."}
{"id":"ko.e090","tr":"मी रोज कोरियन गाणी ऐकत आहे."}
{"id":"ko.e091","tr":"तुम्ही आधी आत जा."}
{"id":"ko.e092","tr":"आज संध्याकाळी तुम्ही बाहेर जात आहात का?"}
{"id":"ko.e093","tr":"माझी उठायची वेळ साधारण सात वाजता असते."}
{"id":"ko.e094","tr":"जरा एक मिनिट थांबा."}
{"id":"ko.e095","tr":"मी टॉयलेट शोधत आहे."}
{"id":"ko.e096","tr":"मी घरी चालत जात आहे."}
{"id":"ko.e097","tr":"मी मेट्रोमध्ये पुस्तक वाचत आहे."}
{"id":"ko.e098","tr":"कन्व्हिनियन्स स्टोअर रात्रीसुद्धा उघडी असतात."}
{"id":"ko.e099","tr":"दार जरा बंद करा ना."}
{"id":"ko.e100","tr":"ती व्यक्ती नेहमी हसत असते."}
{"id":"ko.e101","tr":"सध्या मी कोरियन शिकत आहे."}
{"id":"ko.e102","tr":"माझा मित्र इंग्रजी शिकवतो."}
{"id":"ko.e103","tr":"मी बाजारातून फळं घेतली."}
{"id":"ko.e104","tr":"काल मी उशिरा झोपलो/झोपले."}
{"id":"ko.e105","tr":"आज उबदार कपडे घाला."}
{"id":"ko.e106","tr":"मी बसने शाळेला जात आहे."}
{"id":"ko.e107","tr":"मी पुढच्या स्टेशनवर उतरत आहे."}
{"id":"ko.e108","tr":"तुम्ही कोरियाला परत कधी येत आहात?"}
{"id":"ko.e109","tr":"मी मित्राला फोटो पाठवले."}
{"id":"ko.e110","tr":"आम्ही कराओकेमध्ये गाणी गायली."}
{"id":"ko.e111","tr":"मीटिंग पाच वाजता संपते."}
{"id":"ko.e112","tr":"चिकन मागवूया का?"}
{"id":"ko.e113","tr":"माझ्यावर विश्वास ठेवा."}
{"id":"ko.e114","tr":"छत्री विसरू नका."}
{"id":"ko.e115","tr":"जेवणाआधी मी हात धुत आहे."}
{"id":"ko.e116","tr":"घर बदलताना मित्राने मदत केली."}
{"id":"ko.e117","tr":"रस्ता माहीत नव्हता, म्हणून मी विचारलं."}
{"id":"ko.e118","tr":"फक्त एक निवडा."}
{"id":"ko.e119","tr":"जागा बदलू का?"}
{"id":"ko.e120","tr":"मला सर्दी झाली आहे."}
{"id":"ko.e121","tr":"जरा लाइट लावा ना."}
{"id":"ko.e122","tr":"सध्या सगळं छान चाललंय का?"}
{"id":"ko.e123","tr":"मी एका कंपनीत नोकरी करत आहे."}
{"id":"ko.e124","tr":"लवकर बरे व्हा."}
{"id":"ko.e125","tr":"तुम्ही विमानतळावर किती वाजता पोहोचणार आहात?"}
{"id":"ko.e126","tr":"इथे फोटो काढूया का?"}
{"id":"ko.e127","tr":"आम्ही एकाच शाळेत जातो."}
{"id":"ko.e128","tr":"अच्छा, असं का? मला माहीत नव्हतं."}
{"id":"ko.e129","tr":"कोरियन जेवण कसं वाटतं?"}
{"id":"ko.e130","tr":"कोरियन आणि इंग्रजी या भाषा खूप वेगळ्या आहेत."}
{"id":"ko.e131","tr":"हांगुल वाटतं त्यापेक्षा सोपं आहे."}
{"id":"ko.e132","tr":"कोरियन उच्चार अवघड आहेत."}
{"id":"ko.e133","tr":"तो तिकडचा डोंगर सगळ्यात उंच आहे."}
{"id":"ko.e134","tr":"तिचे केस लांब आहेत."}
{"id":"ko.e135","tr":"मेट्रो बसपेक्षा जलद आहे."}
{"id":"ko.e136","tr":"तुमच्या आजी खरंच तरुण दिसतात."}
{"id":"ko.e137","tr":"आरोग्य सगळ्यात महत्त्वाचं आहे."}
{"id":"ko.e138","tr":"तुम्हाला काय हवं आहे?"}
{"id":"ko.e139","tr":"खोली खरंच स्वच्छ आहे."}
{"id":"ko.e140","tr":"भयपट फारच भीतिदायक असतात."}
{"id":"ko.e141","tr":"कुठे दुखतंय?"}
{"id":"ko.e142","tr":"तुमचा वीकेंड मजेत जावो."}
{"id":"ko.e143","tr":"तुम्हाला पुन्हा भेटून आनंद झाला."}
{"id":"ko.e144","tr":"आल्याबद्दल थँक यू."}
{"id":"ko.e145","tr":"उशीर झाला, सॉरी."}
{"id":"ko.e146","tr":"हा तोकबोकी फार तिखट आहे."}
{"id":"ko.e147","tr":"सूप गरम आहे, म्हणून सांभाळून."}
{"id":"ko.e148","tr":"आज हवामान उबदार आहे."}
{"id":"ko.e149","tr":"वारा छान थंडगार आहे."}
{"id":"ko.e150","tr":"ग्रंथालय शांत आहे."}
{"id":"ko.e151","tr":"घरच सगळ्यात आरामदायक."}
{"id":"ko.e152","tr":"दुकानाचे मालक प्रेमळ आहेत."}
{"id":"ko.e153","tr":"हे रेस्टॉरंट बिबिंबापसाठी प्रसिद्ध आहे."}
{"id":"ko.e154","tr":"बॅग फार जड आहे."}
{"id":"ko.e155","tr":"दोघांचे चेहरे सारखे दिसतात."}
{"id":"ko.e156","tr":"चव जरा विचित्र आहे."}
{"id":"ko.e157","tr":"आज स्वयंपाक करायचा कंटाळा आलाय."}
{"id":"ko.e158","tr":"तुम्ही कोरियाला जात आहात? मला हेवा वाटतो!"}
{"id":"ko.e159","tr":"खूप खाल्लं, म्हणून पोट भरलं."}
{"id":"ko.e160","tr":"लाल कपडे तुम्हाला छान दिसतात."}
{"id":"ko.e161","tr":"मी कॉफी पीत नाही."}
{"id":"ko.e162","tr":"जरा आणखी किमची द्या."}
{"id":"ko.e163","tr":"मला पोहता येत नाही."}
{"id":"ko.e164","tr":"मला कोरियन जेवण अगदी आरामात चालतं."}
{"id":"ko.e165","tr":"मी सगळा गृहपाठ केला."}
{"id":"ko.e166","tr":"यात जरा मदत करा ना."}
{"id":"ko.e167","tr":"पुन्हा एकदा सांगा ना."}
{"id":"ko.e168","tr":"भरपूर जेवा."}
{"id":"ko.e169","tr":"चला, एकत्र दुपारचं जेवण करूया."}
{"id":"ko.e170","tr":"बँक अगदी शेजारी आहे."}
{"id":"ko.e171","tr":"मला किमची जिगे सगळ्यात जास्त आवडतो."}
{"id":"ko.e172","tr":"आज खरंच खूप मजा आली."}
{"id":"ko.e173","tr":"ही बॅग फारच महाग आहे."}
{"id":"ko.e174","tr":"माझं अजून जेवण झालं नाही."}
{"id":"ko.e175","tr":"बारा वाजले पण?"}
{"id":"ko.e176","tr":"बस लवकरच येईल."}
{"id":"ko.e177","tr":"लवकर या!"}
{"id":"ko.e178","tr":"तुम्ही इथे नेहमी येता का?"}
{"id":"ko.e179","tr":"कधीकधी मी कोणालाही सोबत न घेता चित्रपट पाहत आहे."}
{"id":"ko.e180","tr":"आई नेहमी लवकर उठते."}
{"id":"ko.e181","tr":"सतत पाऊस पडत आहे."}
{"id":"ko.e182","tr":"उद्या पुन्हा भेटूया."}
{"id":"ko.e183","tr":"मला तिखट जेवण फारसं आवडत नाही."}
{"id":"ko.e184","tr":"मला जपानी अजिबात येत नाही."}
{"id":"ko.e185","tr":"पुढच्या वेळी नक्की या."}
{"id":"ko.e186","tr":"उद्या बहुतेक पाऊस पडेल."}
{"id":"ko.e187","tr":"तुम्हाला इंग्रजी बोलता येत असेल का?"}
{"id":"ko.e188","tr":"आपण जवळजवळ पोहोचलो."}
{"id":"ko.e189","tr":"आता मी घरी जात आहे."}
{"id":"ko.e190","tr":"मी आत्ताच पोहोचलो/पोहोचले."}
{"id":"ko.e191","tr":"मी नंतर फोन करेन."}
{"id":"ko.e192","tr":"सध्या तुम्ही काय करता?"}
{"id":"ko.e193","tr":"अचानक पाऊस आला."}
{"id":"ko.e194","tr":"मी मन लावून कोरियनचा अभ्यास करत आहे."}
{"id":"ko.e195","tr":"नुसतं पाणी द्या."}
{"id":"ko.e196","tr":"मी कोणालाही सोबत न घेता प्रवास केला."}
{"id":"ko.e197","tr":"तुम्ही का आला नाहीत?"}
{"id":"ko.e198","tr":"म्योंगदोंगला कसं जायचं?"}
{"id":"ko.e199","tr":"मलाही ते आवडतं. (अनौपचारिक)"}
{"id":"ko.e200","tr":"मी मेक्सिकन आहे."}
{"id":"ko.e201","tr":"तू आज काय करत आहेस? (अनौपचारिक)"}
{"id":"ko.e202","tr":"आपण एकत्र जाऊया."}
{"id":"ko.e203","tr":"आमच्या दुकानात तुमचं स्वागत आहे."}
{"id":"ko.e204","tr":"हे माझं आहे. (अनौपचारिक)"}
{"id":"ko.e205","tr":"माझं नाव मिनजून आहे."}
{"id":"ko.e206","tr":"तो काहीच बोलला नाही. (लेखी शैली)"}
{"id":"ko.e207","tr":"तिने हसत उत्तर दिलं. (लेखी शैली)"}
{"id":"ko.e208","tr":"माझं तुमच्यावर प्रेम आहे. (गाण्यातली ओळ, किंवा खूप वर्षांचं जोडपं)"}
{"id":"ko.e209","tr":"स्वतःचं काम स्वतः करा."}
{"id":"ko.e210","tr":"सर्वांना नमस्कार!"}
{"id":"ko.e211","tr":"जीसू, कॉफी घेणार का?"}
{"id":"ko.e212","tr":"आणि तुमचं नाव काय?"}
{"id":"ko.e213","tr":"ती तिकडची व्यक्ती कोण आहे?"}
{"id":"ko.e214","tr":"वीकेंडला तुम्ही काय केलंत?"}
{"id":"ko.e215","tr":"मी तुमची काय मदत करू?"}
{"id":"ko.e216","tr":"तुम्ही कुठे राहता?"}
{"id":"ko.e217","tr":"हे माझं पुस्तक आहे."}
{"id":"ko.e218","tr":"तीसुद्धा चांगली कल्पना आहे."}
{"id":"ko.e219","tr":"ते तिकडचं काय आहे?"}
{"id":"ko.e220","tr":"हे कितीला आहे?"}
{"id":"ko.e221","tr":"ते चविष्ट आहे का?"}
{"id":"ko.e222","tr":"ते तिकडचं द्या."}
{"id":"ko.e223","tr":"ते ठिकाण किती वाजेपर्यंत उघडं असतं?"}
{"id":"ko.e224","tr":"हे माझे शिक्षक आहेत."}
{"id":"ko.e225","tr":"ते खरंच खूप प्रेमळ आहेत."}
{"id":"ko.e226","tr":"ते तिकडचे मालक आहेत का?"}
{"id":"ko.e227","tr":"हे माझं लहान भावंड आहे."}
{"id":"ko.e228","tr":"तो सध्या बिझी आहे. (मित्राबद्दल)"}
{"id":"ko.e229","tr":"ते तिकडचं कोण आहे? (अनौपचारिक)"}
{"id":"ko.e230","tr":"इकडे या."}
{"id":"ko.e231","tr":"टॉयलेट तिकडे आहे."}
{"id":"ko.e232","tr":"केव्हाही संपर्क करा."}
{"id":"ko.e233","tr":"घरी कोणीच नाही."}
{"id":"ko.e234","tr":"सकाळी मी काहीच खाल्लं नाही."}
{"id":"ko.e235","tr":"कोणीतरी दार उघडलं."}
{"id":"ko.e236","tr":"काहीतरी गडबड आहे."}
{"id":"ko.e237","tr":"माझा फोन घरातच कुठेतरी असेल."}
{"id":"ko.e238","tr":"स्वतःवर विश्वास ठेवा."}
{"id":"ko.e239","tr":"मी मेट्रोने जात आहे."}
{"id":"ko.e240","tr":"किती वाजेपर्यंत उघडं असतं?"}
{"id":"ko.e241","tr":"क्लास नऊ वाजल्यापासून आहे."}
{"id":"ko.e242","tr":"मी मित्राला भेटवस्तू दिली."}
{"id":"ko.e243","tr":"मी शिक्षकांना ईमेल पाठवला."}
{"id":"ko.e244","tr":"मी आजीला फोन केला."}
{"id":"ko.e245","tr":"ताईकडून मेसेज आला."}
{"id":"ko.e246","tr":"आज कालपेक्षा जास्त थंडी आहे."}
{"id":"ko.e247","tr":"तुम्ही कोरियन माणसासारखं बोलता."}
{"id":"ko.e248","tr":"मी दर वीकेंडला ट्रेकिंगला जात आहे."}
{"id":"ko.e249","tr":"माझ्याकडे फक्त हजार वॉन आहेत."}
{"id":"ko.e250","tr":"कॉफी किंवा चहा घेणार का?"}
{"id":"ko.e251","tr":"मी मित्राबरोबर चित्रपट पाहिला."}
{"id":"ko.e252","tr":"आजोबा आले."}
{"id":"ko.e253","tr":"तीनच्या सुमारास भेटूया."}
{"id":"ko.e254","tr":"प्रत्येकी एक घ्या."}
{"id":"ko.e255","tr":"बरं, उद्या तुम्हाला वेळ आहे का?"}
{"id":"ko.e256","tr":"पाऊस पडत आहे. म्हणून छत्री घेऊन जा."}
{"id":"ko.e257","tr":"महाग आहे. पण चविष्ट आहे."}
{"id":"ko.e258","tr":"हे ठिकाण स्वस्त आहे. शिवाय चविष्टही आहे."}
{"id":"ko.e259","tr":"जेवून मग मी कॉफी पीत आहे."}
{"id":"ko.e260","tr":"महाग आहे, पण चविष्ट आहे."}
{"id":"ko.e261","tr":"बाजारात जाऊन मी फळं घेतली."}
{"id":"ko.e262","tr":"थकवा आला होता, म्हणून मी लवकर झोपलो/झोपले."}
{"id":"ko.e263","tr":"कोरियाला गेलात तर तुम्हाला काय करावंसं वाटतं?"}
{"id":"ko.e264","tr":"पाऊस पडतोय, म्हणून टॅक्सी करूया."}
{"id":"ko.e265","tr":"मी आत्ता बिझी आहे, नंतर फोन करेन."}
{"id":"ko.e266","tr":"चला, जेवायला जाऊया."}
{"id":"ko.e267","tr":"चालताना मी गाणी ऐकत आहे."}
{"id":"ko.e268","tr":"शाळेला जाताना मला मित्र भेटला."}
{"id":"ko.e269","tr":"वीकेंडला मी एकतर झोपत आहे किंवा चित्रपट बघत आहे."}
{"id":"ko.e270","tr":"महाग असलं तरी मला घ्यावंसं वाटतं."}
{"id":"ko.e271","tr":"झोपण्याआधी मी पुस्तक वाचत आहे."}
{"id":"ko.e272","tr":"जेवल्यानंतर मी फिरायला जात आहे."}
{"id":"ko.e273","tr":"कोरियाला जाताना मी भेटवस्तू घेत आहे."}
{"id":"ko.e274","tr":"घरी पोहोचताच मला झोप लागली."}
{"id":"ko.e275","tr":"आज खूप काम आहे."}
