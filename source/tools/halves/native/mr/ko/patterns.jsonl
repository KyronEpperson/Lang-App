{"id":"ko.p001","meaning":"विषय पार्टिकल: \"…बद्दल बोलायचं तर\"; विरोध, सर्वसाधारण विधानं"}
{"id":"ko.p002","meaning":"कर्ता पार्टिकल: नेमकं कोण / काय; नवीन माहिती"}
{"id":"ko.p003","meaning":"कर्म पार्टिकल"}
{"id":"ko.p004","meaning":"ला / -ई / त (जायचं ठिकाण, वेळ)"}
{"id":"ko.p005","meaning":"त (जिथे क्रिया घडते) / हून"}
{"id":"ko.p006","meaning":"सुद्धा / -ही (은/는/이/가/을/를 ची जागा घेतो)"}
{"id":"ko.p007","meaning":"चा / ची / चं; अनेकदा 에 असा उच्चार"}
{"id":"ko.p008","meaning":"आणि / बरोबर"}
{"id":"ko.p009","meaning":"फक्त"}
{"id":"ko.p010","meaning":"कडे / ने (साधन)"}
{"id":"ko.p011","meaning":"सभ्य वर्तमानकाळ (ㅏ/ㅗ मूळ → 아요, बाकी → 어요, 하다 → 해요)"}
{"id":"ko.p012","meaning":"सभ्य भूतकाळ"}
{"id":"ko.p013","meaning":"भविष्यकाळ / इरादा (…णार आहे)"}
{"id":"ko.p014","meaning":"नाही (स्वतःची निवड)"}
{"id":"ko.p015","meaning":"जमत नाही (क्षमता, परिस्थिती)"}
{"id":"ko.p016","meaning":"नाही (안 पेक्षा थोडं औपचारिक; पीत नाही सारखा क्रम)"}
{"id":"ko.p017","meaning":"करता येतं / करता येत नाही"}
{"id":"ko.p018","meaning":"…या का? (सूचना)"}
{"id":"ko.p019","meaning":"…णार का? / …ायचंय का?"}
{"id":"ko.p020","meaning":"चल, …या! (अनौपचारिक)"}
{"id":"ko.p021","meaning":"मी …ईन (वचन, बोलणाऱ्याचा इरादा)"}
{"id":"ko.p022","meaning":"सभ्य विनंती / आदरार्थी वर्तमानकाळ"}
{"id":"ko.p023","meaning":"(माझ्यासाठी) …ून द्या"}
{"id":"ko.p024","meaning":"…ू नका (मनाई)"}
{"id":"ko.p025","meaning":"लक्षात येणं / हलकं आश्चर्य"}
{"id":"ko.p026","meaning":"सौम्य विरोध, पार्श्वभूमी"}
{"id":"ko.p027","meaning":"आहे (व्यंजनानंतर / स्वरानंतर)"}
{"id":"ko.p028","meaning":"आहे, जवळ आहे / नाही, जवळ नाही"}
{"id":"ko.p029","meaning":"…ायला जाणे"}
{"id":"ko.p030","meaning":"…वंसं वाटणं (इच्छा)"}
{"id":"ko.p031","meaning":"मला वाटतं / असं दिसतं"}
{"id":"ko.p032","meaning":"जर / …ले की"}
{"id":"ko.p033","meaning":"वस्तू, माणसं, कप, वय, तास"}
{"id":"ko.p034","meaning":"पैसे, तारखा, मिनिटं, फोन नंबर, मजले"}
{"id":"ko.p035","meaning":"आणि मग / म्हणून / पण"}
{"id":"ko.p036","meaning":"संबोधन: सभ्यपणे नाव, पद, अनौपचारिक हाक"}
{"id":"ko.p037","meaning":"आदरार्थी: कर्त्याला आदर (वडीलधारे, ग्राहक)"}
{"id":"ko.p038","meaning":"먹다·마시다 / 자다 / 있다 यांची आदरार्थी रूपं"}
{"id":"ko.p039","meaning":"सौम्य करणारा शब्द: \"जरा\""}
{"id":"ko.p040","meaning":"\"…असेल का?\" — सभ्य प्रश्नाची सुरुवात"}
{"id":"ko.p041","meaning":"\"…ाल का?\" (अतिशय सभ्य विनंती)"}
{"id":"ko.p042","meaning":"\"…लं तर चालेल का?\" (परवानगी)"}
{"id":"ko.p043","meaning":"\"…ू का?\""}
{"id":"ko.p044","meaning":"सहकाऱ्यांना पदाने हाक मारा, कधीच फक्त नावाने नाही"}
{"id":"ko.p045","meaning":"ऑफिसचे निरोप: थांबणाऱ्यांना / काम संपल्यावर वरिष्ठांना"}
{"id":"ko.p046","meaning":"ईमेलची सुरुवात: \"लिहिण्याचं कारण असं की…\""}
{"id":"ko.p047","meaning":"विनंतीचा सभ्य शेवट (नम्र)"}
