{"id":"it.g001","card":"it.c0002","a":"Dov'è la chiave?","b":"È sul tavolo, vicino al telefono."}
{"id":"it.g002","card":"it.c0003","a":"Prendiamo un gelato?","b":"Sì, volentieri! Io lo prendo al cioccolato."}
{"id":"it.g003","card":"it.c0005","a":"Non dormo bene la notte.","b":"Perché? Fa troppo caldo?"}
{"id":"it.g004","card":"it.c0013","a":"Vuoi lo zucchero nel caffè?","b":"No, grazie, lo prendo senza."}
{"id":"it.g005","card":"it.c0024","a":"Ciao, Luca! Come stai?","b":"Benissimo! E tu?"}
{"id":"it.g006","card":"it.c0022","a":"Buonasera, signor Rossi. Come sta?","b":"Bene, grazie. E Lei?"}
{"id":"it.g007","card":"it.c0030","a":"Ti presento il mio amico Matteo.","b":"Piacere, Matteo!"}
{"id":"it.g008","card":"it.c0031","a":"Grazie mille per l'aiuto!","b":"Figurati!"}
{"id":"it.g009","card":"it.c0042","a":"Ciao! Come ti chiami?","b":"Mi chiamo Giorgia, e tu?"}
{"id":"it.g010","card":"it.c0043","a":"Buongiorno, come si chiama?","b":"Mi chiamo Paolo Bianchi."}
{"id":"it.g011","card":"it.c0044","a":"Di dove sei, Megan?","b":"Sono americana, ma adesso abito a Firenze."}
{"id":"it.g012","card":"it.c0048","a":"Parli inglese?","b":"Sì, un po'. Ma parliamo in italiano!"}
{"id":"it.g013","card":"it.c0046","a":"Dove abiti adesso?","b":"Abito a Bologna, vicino all'università."}
{"id":"it.g014","card":"it.c0070","a":"Hai fratelli?","b":"Sì, ho un fratello e due sorelle."}
{"id":"it.g015","card":"it.c0054","a":"Dove abitano i tuoi genitori?","b":"I miei genitori abitano a Napoli."}
{"id":"it.g016","card":"it.c0056","a":"Come sta la nonna?","b":"Sta bene, grazie. Domenica pranziamo da lei."}
{"id":"it.g017","card":"it.c0065","a":"Chi è quel ragazzo?","b":"È il mio ragazzo, Simone."}
{"id":"it.g018","card":"it.c0072","a":"Scusa, che ore sono?","b":"Sono le cinque e dieci."}
{"id":"it.g019","card":"it.c0074","a":"Quanto costa questa borsa?","b":"Costa quaranta euro."}
{"id":"it.g020","card":"it.c0076","a":"È già l'una?","b":"Sì, andiamo a pranzo!"}
{"id":"it.g021","card":"it.c0087","a":"Mi dai il tuo numero di telefono?","b":"Certo, te lo scrivo."}
{"id":"it.g022","card":"it.c0103","a":"Che tempo fa a Milano?","b":"Oggi piove, ma domani c'è il sole."}
{"id":"it.g023","card":"it.c0093","a":"Che giorno è oggi?","b":"Oggi è giovedì."}
{"id":"it.g024","card":"it.c0098","a":"Quando è il tuo compleanno?","b":"Il mio compleanno è il tre marzo."}
{"id":"it.g025","card":"it.c0088","a":"Ci vediamo lunedì?","b":"Sì, lunedì alle dieci."}
{"id":"it.g026","card":"it.c0106","a":"Cosa prendi?","b":"Un caffè, grazie."}
{"id":"it.g027","card":"it.c0107","a":"Desidera qualcosa da bere?","b":"Un bicchiere d'acqua, per favore."}
{"id":"it.g028","card":"it.c0115","a":"Buonasera, un tavolo per due?","b":"Sì, prego, da questa parte."}
{"id":"it.g029","card":"it.c0116","a":"E per Lei, signore?","b":"Per me, gli spaghetti al pomodoro."}
{"id":"it.g030","card":"it.c0126","a":"Che taglia porta?","b":"Porto la quarantadue."}
{"id":"it.g031","card":"it.c0129","a":"Buongiorno, posso aiutarLa?","b":"Sto solo guardando, grazie."}
{"id":"it.g032","card":"it.c0127","a":"Questa giacca è molto bella. Posso provarla?","b":"Certo, i camerini sono lì."}
{"id":"it.g033","card":"it.c0139","a":"Come mi sta?","b":"Ti sta benissimo!"}
{"id":"it.g034","card":"it.c0157","a":"A che ora ti svegli la mattina?","b":"Mi sveglio alle sei e mezza."}
{"id":"it.g035","card":"it.c0142","a":"Ti alzi presto?","b":"Abbastanza: mi alzo alle sette."}
{"id":"it.g036","card":"it.c0156","a":"Abiti in una casa?","b":"No, abito in un appartamento in centro."}
{"id":"it.g037","card":"it.c0146","a":"Scusa, dov'è il bagno?","b":"In fondo al corridoio, a destra."}
{"id":"it.g038","card":"it.c0160","a":"Dov'è la stazione?","b":"Vada dritto e poi giri a destra."}
{"id":"it.g039","card":"it.c0167","a":"È lontano il Duomo?","b":"No, è a cinque minuti a piedi."}
{"id":"it.g040","card":"it.c0161","a":"C'è una farmacia qui vicino?","b":"Sì, ce n'è una in piazza."}
{"id":"it.g041","card":"it.c0176","a":"Mi sono perso. Dove siamo?","b":"Siamo vicino al Colosseo."}
{"id":"it.g042","card":"it.c0181","a":"A che ora parte il treno per Bologna?","b":"Alle diciotto e venti, dal binario tre."}
{"id":"it.g043","card":"it.c0183","a":"Solo andata o andata e ritorno?","b":"Andata e ritorno, per favore."}
{"id":"it.g044","card":"it.c0185","a":"Perché aspettiamo ancora?","b":"Il treno è in ritardo di venti minuti."}
{"id":"it.g045","card":"it.c0190","a":"Buonasera. Ho una prenotazione per due notti.","b":"Benissimo. Mi dà un documento, per favore?"}
{"id":"it.g046","card":"it.c0196","a":"Che cosa hai?","b":"Mi fa male la testa da stamattina."}
{"id":"it.g047","card":"it.c0208","a":"Buongiorno, ha qualcosa per la tosse?","b":"Sì, questo sciroppo è molto buono."}
{"id":"it.g048","card":"it.c0210","a":"Dove fa male?","b":"Qui, al ginocchio."}
{"id":"it.g049","card":"it.c0205","a":"È allergico a qualche medicina?","b":"Sì, sono allergico alla penicillina."}
{"id":"it.g050","card":"it.c0217","a":"Che lavoro fai?","b":"Faccio l'insegnante in una scuola media."}
{"id":"it.g051","card":"it.c0219","a":"Vai in ufficio oggi?","b":"No, il venerdì lavoro da casa."}
{"id":"it.g052","card":"it.c0225","a":"Usciamo stasera?","b":"Non posso, domani ho un esame."}
{"id":"it.g053","card":"it.c0226","a":"A che ora finisci oggi?","b":"Finisco alle sei, poi vado a casa."}
{"id":"it.g054","card":"it.c0233","a":"Ho fame. Mangiamo qualcosa?","b":"Sì, andiamo in pizzeria."}
{"id":"it.g055","card":"it.c0232","a":"Come stai?","b":"Sono stanco, ho lavorato tutto il giorno."}
{"id":"it.g056","card":"it.c0245","a":"Fa freddo, prendi la giacca.","b":"Hai ragione, grazie."}
{"id":"it.g057","card":"it.c0249","a":"Sabato andiamo a Venezia.","b":"Che bello! Non vedo l'ora!"}
{"id":"it.g058","card":"it.c0252","a":"Ti piace ballare?","b":"Sì, molto! E a te?"}
{"id":"it.g059","card":"it.c0256","a":"Mi piace molto il gelato.","b":"Anche a me!"}
{"id":"it.g060","card":"it.c0262","a":"Cosa hai fatto nel fine settimana?","b":"Siamo andati al mare con i bambini."}
{"id":"it.g061","card":"it.c0267","a":"Stasera gioca la Roma. Guardiamo la partita?","b":"Certo, vengo da te alle nove."}
{"id":"it.g062","card":"it.c0273","a":"Chi è?","b":"Sono io, Luca!"}
{"id":"it.g063","card":"it.c0270","a":"Quanti anni hai?","b":"Ne ho ventotto."}
{"id":"it.g064","card":"it.c0268","a":"Non vengo alla festa.","b":"Perché?"}
{"id":"it.g065","card":"it.c0282","a":"Tè o caffè?","b":"Un caffè, grazie."}
{"id":"it.g066","card":"it.c0284","a":"Sono stanca.","b":"Anch'io. Andiamo a casa?"}
{"id":"it.g067","card":"it.c0290","a":"Conosci Marco?","b":"Sì, lavoriamo insieme."}
{"id":"it.g068","card":"it.c0301","a":"Scusi, posso fare una foto?","b":"Sì, ma senza flash."}
{"id":"it.g069","card":"it.c0300","a":"Prendiamo il treno delle otto, così arriviamo prima.","b":"Sì, ha senso."}
{"id":"it.g070","card":"it.c0303","a":"Sai nuotare?","b":"Sì, ma non molto bene."}
{"id":"it.g071","card":"it.c0308","a":"Buongiorno, desidera?","b":"Vorrei un cappuccino e un cornetto."}
{"id":"it.g072","card":"it.c0318","a":"Desidera altro?","b":"No, grazie. Mi porta il conto?"}
{"id":"it.g073","card":"it.c0319","a":"Buonasera, un tavolo per due?","b":"Certo. Prego, si accomodi."}
{"id":"it.g074","card":"it.c0320","a":"E Lei, cosa prende?","b":"Per me, le lasagne."}
{"id":"it.g075","card":"it.c0322","a":"Grazie per la cena, era tutto buonissimo.","b":"Sono contenta! Vuoi un caffè?"}
{"id":"it.g076","card":"it.c0324","a":"Ho finito la maratona!","b":"Complimenti!"}
{"id":"it.g077","card":"it.c0326","a":"Andiamo al mare domenica?","b":"Ottima idea!"}
{"id":"it.g078","card":"it.c0327","a":"Ti aiuto con le borse.","b":"Grazie, sei molto gentile."}
{"id":"it.g079","card":"it.c0330","a":"Che bella casa!","b":"Grazie, troppo gentile!"}
{"id":"it.g080","card":"it.c0331","a":"Come ti sembra questo vestito?","b":"Ti sta benissimo!"}
{"id":"it.g081","card":"it.c0333","a":"Parla molto bene l'italiano!","b":"Grazie, ma ho ancora tanto da imparare."}
{"id":"it.g082","card":"it.c0325","a":"Ho fatto io questa torta.","b":"Sei bravissimo!"}
{"id":"it.g083","card":"it.c0336","a":"Che profumino! Cosa cucini?","b":"Il sugo della nonna!"}
{"id":"it.g084","card":"it.c0337","a":"Ti piace il risotto?","b":"Sì, che buono!"}
{"id":"it.g085","card":"it.c0347","a":"Il tuo italiano è perfetto!","b":"Dici? Ho ancora tanto da imparare."}
{"id":"it.g086","card":"it.c0348","a":"Sei bravissima a ballare!","b":"Ma dai, grazie!"}
{"id":"it.g087","card":"it.c0349","a":"Stai benissimo oggi!","b":"Grazie, anche tu!"}
{"id":"it.g088","card":"it.c0351","a":"Questo tiramisù è buonissimo!","b":"Grazie! È una ricetta di mia nonna."}
{"id":"it.g089","card":"it.c0342","a":"Lei è americano? Ha un'ottima pronuncia!","b":"Grazie mille, studio molto."}
{"id":"it.g090","card":"it.c0343","a":"Ti piace la mia nuova giacca?","b":"Sì, hai proprio buon gusto!"}
{"id":"it.g091","card":"it.c0350","a":"Mi piace molto il tuo giardino.","b":"Grazie, mi fa piacere!"}
{"id":"it.g092","card":"it.c0378","a":"Hai un bel sorriso.","b":"Grazie, che carino!"}
{"id":"it.g093","card":"it.c0376","a":"Sei bellissima stasera.","b":"Grazie! Anche tu stai benissimo."}
{"id":"it.g094","card":"it.c0380","a":"Hai degli occhi stupendi.","b":"Grazie, sono gli occhi di mia madre."}
{"id":"it.g095","card":"it.c0383","a":"Perché ridi?","b":"Perché mi fai ridere!"}
{"id":"it.g096","card":"it.c0388","a":"Mi piace parlare con te.","b":"Anche a me. Prendiamo un altro caffè?"}
{"id":"it.g097","card":"it.c0396","a":"Ti va di prendere un caffè?","b":"Sì, dai! Conosco un bar qui vicino."}
{"id":"it.g098","card":"it.c0397","a":"Ti va di uscire con me sabato?","b":"Sì! Dove andiamo?"}
{"id":"it.g099","card":"it.c0398","a":"Sei libera sabato sera?","b":"Mi dispiace, sabato lavoro."}
{"id":"it.g100","card":"it.c0400","a":"Mi lasci il tuo numero?","b":"Certo, ecco."}
{"id":"it.g101","card":"it.c0401","a":"Posso farti una domanda? Sei fidanzata?","b":"No, sono single. Perché?"}
{"id":"it.g102","card":"it.c0402","a":"Devo dirti una cosa: mi piaci.","b":"Anche tu mi piaci."}
{"id":"it.g103","card":"it.c0404","a":"Mi sei mancata!","b":"Anche tu! Com'è andato il viaggio?"}
{"id":"it.g104","card":"it.c0406","a":"Vieni a cena da me domani?","b":"Volentieri! A che ora?"}
{"id":"it.g105","card":"it.c0407","a":"Posso accompagnarti a casa?","b":"Mi farebbe molto piacere."}
{"id":"it.g106","card":"it.c0408","a":"Sei la ragazza più bella della festa.","b":"Lo dici a tutte?"}
{"id":"it.g107","card":"it.c0410","a":"Sei la persona più simpatica del mondo!","b":"Esagerato!"}
{"id":"it.g108","card":"it.c0409","a":"Prego, prima tu.","b":"Che galante!"}
{"id":"it.g109","card":"it.c0382","a":"Mi stai simpatico, sai?","b":"Anche tu!"}
{"id":"it.g110","card":"it.c0411","a":"Posso offrirti qualcosa da bere?","b":"Grazie, ma sono fidanzata."}
{"id":"it.g111","card":"it.c0413","a":"Ti va di uscire con me, solo noi due?","b":"Sei molto caro, ma preferisco restare amici."}
{"id":"it.g112","card":"it.c0414","a":"Andiamo a ballare stasera?","b":"Sei gentile, ma no, grazie. Sono stanca."}
{"id":"it.g113","card":"it.c0841","a":"Il museo è chiuso il lunedì.","b":"Ah! Allora andiamo domani."}
{"id":"it.g114","card":"it.c0842","a":"Oh! Che sorpresa!","b":"Ciao! Sono tornata ieri."}
{"id":"it.g115","card":"it.c0843","a":"Ci vediamo alle otto al bar.","b":"Eh? Non ho sentito."}
{"id":"it.g116","card":"it.c0844","a":"Ehi, Marco! Come va?","b":"Bene, e tu?"}
{"id":"it.g117","card":"it.c0845","a":"Ti piace il film?","b":"Beh, non è male."}
{"id":"it.g118","card":"it.c0846","a":"Dov'è Luca?","b":"Boh! Non lo so."}
{"id":"it.g119","card":"it.c0847","a":"Secondo te domani piove?","b":"Mah! Forse sì, forse no."}
{"id":"it.g120","card":"it.c0848","a":"Non ho voglia di uscire.","b":"Dai, vieni con noi!"}
{"id":"it.g121","card":"it.c0849","a":"Ho vinto cento euro!","b":"Ma dai! Davvero?"}
{"id":"it.g122","card":"it.c0850","a":"Un cappuccino, per favore.","b":"Ecco a Lei!"}
{"id":"it.g123","card":"it.c0851","a":"Ancora una foto!","b":"Basta, sono stanca!"}
{"id":"it.g124","card":"it.c0852","a":"Andiamo in vacanza a Capri?","b":"Magari! Ma non ho soldi."}
{"id":"it.g125","card":"it.c0853","a":"Il treno è in ritardo di un'ora.","b":"Uffa! Che noia!"}
{"id":"it.g126","card":"it.c0854","a":"Ahi! Mi fa male il piede.","b":"Fammi vedere."}
{"id":"it.g127","card":"it.c0855","a":"Ops! Ho rotto un bicchiere.","b":"Non fa niente."}
{"id":"it.g128","card":"it.c0856","a":"Domani non c'è scuola!","b":"Evviva!"}
{"id":"it.g129","card":"it.c0857","a":"Accidenti, ho perso le chiavi!","b":"Sono in macchina, forse?"}
{"id":"it.g130","card":"it.c0858","a":"Questa borsa costa mille euro.","b":"Cavolo! È troppo cara!"}
{"id":"it.g131","card":"it.c0859","a":"Mamma mia, che caldo!","b":"Sì, andiamo al mare!"}
{"id":"it.g132","card":"it.c0860","a":"Stasera non posso venire.","b":"Peccato! Allora un'altra volta."}
{"id":"it.g133","card":"it.c0861","a":"Il treno è arrivato in orario.","b":"Meno male!"}
{"id":"it.g134","card":"it.c0862","a":"Grazie per l'aiuto!","b":"Figurati!"}
{"id":"it.g135","card":"it.c0863","a":"Posso usare il bagno?","b":"Certo! È lì a destra."}
{"id":"it.g136","card":"it.c0864","a":"Ci vediamo alle otto?","b":"Va bene!"}
{"id":"it.g137","card":"it.c0865","a":"Non ce la faccio più!","b":"Forza, manca poco!"}
{"id":"it.g138","card":"it.c0866","a":"Attenzione! Arriva una macchina!","b":"Grazie!"}
{"id":"it.g139","card":"it.c0867","a":"Etciù!","b":"Salute!"}
{"id":"it.g140","card":"it.c0868","a":"Alla nostra amicizia!","b":"Cin cin!"}
{"id":"it.g141","card":"it.c0869","a":"Oggi è il mio compleanno!","b":"Auguri!"}
{"id":"it.g142","card":"it.c0870","a":"Il ristorante è chiuso.","b":"Vabbè, mangiamo una pizza a casa."}
{"id":"it.g143","card":"it.c0871","a":"Sei stanco?","b":"Macché! Andiamo a ballare!"}
{"id":"it.g144","card":"it.c0872","a":"C'è un insetto nella mia insalata!","b":"Che schifo! Chiama il cameriere."}
