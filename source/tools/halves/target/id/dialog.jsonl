{"id":"id.g001","card":"id.c0001","a":"Baju kamu cantik sekali.","b":"Terima kasih! Ini dari pasar."}
{"id":"id.g002","card":"id.c0002","a":"Sotonya enak?","b":"Enak, tapi agak pedas."}
{"id":"id.g003","card":"id.c0007","a":"Kamu ngantuk, ya?","b":"Ya, semalam saya tidur jam dua."}
{"id":"id.g004","card":"id.c0014","a":"Besok kita ke pantai?","b":"Ayo, ke pantai Kuta saja."}
{"id":"id.g005","card":"id.c0017","a":"Mau jus jeruk?","b":"Mau, terima kasih."}
{"id":"id.g006","card":"id.c0023","a":"Selamat pagi, Pak Budi.","b":"Selamat pagi, Emma. Apa kabar?"}
{"id":"id.g007","card":"id.c0024","a":"Halo, Rina! Apa kabar?","b":"Baik, terima kasih. Kamu?"}
{"id":"id.g008","card":"id.c0028","a":"Terima kasih banyak, Bu Sari.","b":"Sama-sama, Emma."}
{"id":"id.g009","card":"id.c0030","a":"Maaf, Pak!","b":"Tidak apa-apa."}
{"id":"id.g010","card":"id.c0029","a":"Permisi, Pak, saya mau lewat.","b":"Oh, silakan."}
{"id":"id.g011","card":"id.c0035","a":"Saya pulang dulu, ya.","b":"Selamat jalan! Hati-hati di jalan."}
{"id":"id.g012","card":"id.c0022","a":"Selamat malam, Bu. Ada kamar kosong?","b":"Selamat malam. Ada, Pak."}
{"id":"id.g013","card":"id.c0037","a":"Siapa nama Anda?","b":"Nama saya Emma."}
{"id":"id.g014","card":"id.c0038","a":"Dari mana, Mbak?","b":"Saya dari Amerika."}
{"id":"id.g015","card":"id.c0043","a":"Maaf, Pak, bisa bahasa Inggris?","b":"Sedikit saja."}
{"id":"id.g016","card":"id.c0052","a":"Sudah berapa lama di Indonesia, Mas?","b":"Baru satu minggu."}
{"id":"id.g017","card":"id.c0048","a":"Saya dari Surabaya. Kalau Anda?","b":"Saya dari Amerika, tapi saya tinggal di Bandung."}
{"id":"id.g018","card":"id.c0045","a":"Umur Anda berapa?","b":"Umur saya tiga puluh tahun."}
{"id":"id.g019","card":"id.c0071","a":"Sudah menikah, Mbak?","b":"Belum, Bu."}
{"id":"id.g020","card":"id.c0063","a":"Ini siapa?","b":"Ini kakak saya, Rina."}
{"id":"id.g021","card":"id.c0065","a":"Orang tua kamu tinggal di mana?","b":"Orang tua saya tinggal di Medan."}
{"id":"id.g022","card":"id.c0068","a":"Anak-anak di mana?","b":"Mereka di rumah nenek."}
{"id":"id.g023","card":"id.c0062","a":"Kita makan di mana?","b":"Di warung itu saja."}
{"id":"id.g024","card":"id.c0085","a":"Berapa harganya, Bu?","b":"Dua puluh lima ribu."}
{"id":"id.g025","card":"id.c0086","a":"Semuanya berapa, Mas?","b":"Semuanya delapan puluh ribu, Bu."}
{"id":"id.g026","card":"id.c0087","a":"Ada uang kecil, Pak?","b":"Maaf, hanya ada seratus ribu."}
{"id":"id.g027","card":"id.c0088","a":"Bisa bayar pakai kartu?","b":"Maaf, tunai saja, Mbak."}
{"id":"id.g028","card":"id.c0089","a":"Boleh minta nomor teleponnya?","b":"Boleh. Ini nomor telepon saya."}
{"id":"id.g029","card":"id.c0090","a":"Jam berapa sekarang?","b":"Sekarang jam tiga."}
{"id":"id.g030","card":"id.c0094","a":"Rapatnya jam berapa?","b":"Setengah tiga."}
{"id":"id.g031","card":"id.c0104","a":"Hari ini hari apa?","b":"Hari ini hari Jumat."}
{"id":"id.g032","card":"id.c0105","a":"Tanggal berapa hari ini?","b":"Hari ini tanggal tujuh belas."}
{"id":"id.g033","card":"id.c0099","a":"Besok kamu kerja?","b":"Tidak, besok hari Minggu."}
{"id":"id.g034","card":"id.c0108","a":"Mau pesan apa, Bu?","b":"Minta sate ayam satu dan es teh manis satu."}
{"id":"id.g035","card":"id.c0120","a":"Makan di sini atau dibungkus, Mas?","b":"Dibungkus saja."}
{"id":"id.g036","card":"id.c0123","a":"Sudah makan?","b":"Belum. Ayo kita makan!"}
{"id":"id.g037","card":"id.c0125","a":"Minta bon, Mbak.","b":"Baik, sebentar ya, Pak."}
{"id":"id.g038","card":"id.c0119","a":"Mau sate ayam?","b":"Maaf, saya tidak makan daging."}
{"id":"id.g039","card":"id.c0126","a":"Berapa ini, Bu?","b":"Tiga puluh ribu."}
{"id":"id.g040","card":"id.c0138","a":"Bisa kurang, Pak?","b":"Dua puluh lima ribu saja, ya."}
{"id":"id.g041","card":"id.c0132","a":"Ada warna lain, Mbak?","b":"Ada, yang biru dan yang hitam."}
{"id":"id.g042","card":"id.c0143","a":"Cari apa, Bu?","b":"Saya lihat-lihat dulu, terima kasih."}
{"id":"id.g043","card":"id.c0136","a":"Boleh dicoba, Mbak?","b":"Boleh, kamar pasnya di sana."}
{"id":"id.g044","card":"id.c0152","a":"Kamu mandi dulu, ya.","b":"Saya sudah mandi, Bu."}
{"id":"id.g045","card":"id.c0158","a":"Kamu mau ke mana?","b":"Ke warung. Saya belum makan."}
{"id":"id.g046","card":"id.c0151","a":"Kamu bangun jam berapa?","b":"Saya bangun jam enam."}
{"id":"id.g047","card":"id.c0148","a":"Kamar mandi di mana, Bu?","b":"Di sebelah dapur."}
{"id":"id.g048","card":"id.c0157","a":"Kamu sedang apa?","b":"Saya sedang memasak nasi goreng."}
{"id":"id.g049","card":"id.c0162","a":"Permisi, Pak. Di mana stasiun?","b":"Lurus saja, lalu belok kanan."}
{"id":"id.g050","card":"id.c0163","a":"Mbak, ada apotek di dekat sini?","b":"Ada, di depan masjid."}
{"id":"id.g051","card":"id.c0170","a":"Permisi, kamar kecil di mana?","b":"Di belakang, Bu, di sebelah kiri."}
{"id":"id.g052","card":"id.c0174","a":"Pasar Ubud jauh dari sini?","b":"Tidak jauh. Sepuluh menit jalan kaki."}
{"id":"id.g053","card":"id.c0176","a":"Ada kantor pos di sini?","b":"Maaf, tidak ada."}
{"id":"id.g054","card":"id.c0177","a":"Maaf, Pak, saya tersesat.","b":"Mau ke mana, Mbak?"}
{"id":"id.g055","card":"id.c0180","a":"Liburan nanti mau ke mana?","b":"Saya mau ke Bali."}
{"id":"id.g056","card":"id.c0185","a":"Ke mana, Bu?","b":"Ke bandara, Pak."}
{"id":"id.g057","card":"id.c0186","a":"Berhenti di sini, Pak.","b":"Baik, Bu. Tiga puluh ribu."}
{"id":"id.g058","card":"id.c0190","a":"Selamat malam. Ada kamar kosong?","b":"Ada, Pak. Untuk berapa malam?"}
{"id":"id.g059","card":"id.c0183","a":"Jam berapa keretanya berangkat?","b":"Jam tujuh pagi, tapi keretanya sering terlambat."}
{"id":"id.g060","card":"id.c0197","a":"Dari Ubud ke Kuta, berapa lama ke sana?","b":"Kira-kira satu jam naik mobil."}
{"id":"id.g061","card":"id.c0198","a":"Kenapa tidak masuk kerja?","b":"Saya sakit, Bu. Saya demam."}
{"id":"id.g062","card":"id.c0199","a":"Kenapa, Ayu?","b":"Kepala saya sakit sekali."}
{"id":"id.g063","card":"id.c0209","a":"Mbak, ada obat batuk?","b":"Ada. Diminum tiga kali sehari, ya."}
{"id":"id.g064","card":"id.c0213","a":"Mas, bisa tolong panggil dokter? Teman saya pingsan.","b":"Baik, tunggu sebentar."}
{"id":"id.g065","card":"id.c0214","a":"Boleh saya duduk di sini?","b":"Silakan, Bu."}
{"id":"id.g066","card":"id.c0212","a":"Pak, saya kehilangan dompet.","b":"Terakhir Ibu lihat di mana?"}
{"id":"id.g067","card":"id.c0216","a":"Kamu bekerja di mana?","b":"Saya bekerja di kantor, di Jakarta."}
{"id":"id.g068","card":"id.c0227","a":"Bapak bekerja di mana?","b":"Saya bekerja di bank, di Surabaya."}
{"id":"id.g069","card":"id.c0217","a":"Kamu sudah bekerja?","b":"Belum, saya mahasiswa."}
{"id":"id.g070","card":"id.c0230","a":"Sari, bisa bantu saya?","b":"Maaf, saya sedang sibuk. Nanti, ya."}
{"id":"id.g071","card":"id.c0231","a":"Mau jalan-jalan nanti malam?","b":"Tidak bisa. Besok ada ujian."}
{"id":"id.g072","card":"id.c0220","a":"Pak Budi ada?","b":"Beliau sedang rapat sampai jam tiga."}
{"id":"id.g073","card":"id.c0234","a":"Rumah kamu besar?","b":"Tidak, kecil. Tapi saya mau rumah besar dengan kebun."}
{"id":"id.g074","card":"id.c0243","a":"Rumah itu besar, ya.","b":"Ya, itu rumah Pak Agus."}
{"id":"id.g075","card":"id.c0236","a":"Yang mana teman kamu?","b":"Itu, orang yang tinggi."}
{"id":"id.g076","card":"id.c0247","a":"Mau yang merah atau yang biru?","b":"Yang biru saja."}
{"id":"id.g077","card":"id.c0248","a":"Itu buku apa?","b":"Ini buku yang saya beli di Bandung."}
{"id":"id.g078","card":"id.c0245","a":"Kamu suka tinggal di sini?","b":"Suka sekali. Orang Indonesia ramah."}
{"id":"id.g079","card":"id.c0252","a":"Saya lapar.","b":"Ayo makan nasi goreng."}
{"id":"id.g080","card":"id.c0253","a":"Mau jalan-jalan?","b":"Nanti saja. Saya capek."}
{"id":"id.g081","card":"id.c0264","a":"Apa hobi kamu?","b":"Saya suka berenang dan membaca."}
{"id":"id.g082","card":"id.c0262","a":"Kenapa, Rina?","b":"Adik saya belum pulang. Saya khawatir."}
{"id":"id.g083","card":"id.c0268","a":"Hari Minggu mau jalan-jalan?","b":"Mau! Ayo ke pantai."}
{"id":"id.g084","card":"id.c0263","a":"Kenapa sedih?","b":"Saya rindu keluarga saya di Amerika."}
{"id":"id.g085","card":"id.c0271","a":"Dari mana, Mas?","b":"Dari Amerika."}
{"id":"id.g086","card":"id.c0270","a":"Siapa nama Anda?","b":"Nama saya Emma."}
{"id":"id.g087","card":"id.c0280","a":"Mobil siapa ini?","b":"Mobil Pak Joko."}
{"id":"id.g088","card":"id.c0282","a":"Mau ke mana, Fajar?","b":"Ke pasar. Kamu mau ikut?"}
{"id":"id.g089","card":"id.c0278","a":"Saya mau tas itu.","b":"Yang mana? Yang hitam?"}
{"id":"id.g090","card":"id.c0283","a":"Teh atau kopi, Bu?","b":"Teh saja, terima kasih."}
{"id":"id.g091","card":"id.c0275","a":"Maaf, Bu, apa artinya kata ini?","b":"Artinya air."}
{"id":"id.g092","card":"id.c0276","a":"Saya tidak ikut besok.","b":"Kenapa?"}
{"id":"id.g093","card":"id.c0292","a":"Sudah menikah?","b":"Belum."}
{"id":"id.g094","card":"id.c0291","a":"Bu guru, ini tugas saya.","b":"Maaf, saya bukan guru. Saya mahasiswa."}
{"id":"id.g095","card":"id.c0301","a":"Saya pulang, ya.","b":"Jangan pergi! Masih sore."}
{"id":"id.g096","card":"id.c0300","a":"Mau makan?","b":"Terima kasih, saya tidak lapar."}
{"id":"id.g097","card":"id.c0302","a":"Halo, siapa namamu?","b":"Putri. Kamu?"}
{"id":"id.g098","card":"id.c0303","a":"Berapa umur Anda?","b":"Umur saya dua puluh lima tahun."}
{"id":"id.g099","card":"id.c0293","a":"Kamu tinggal di mana?","b":"Saya tinggal di kos dekat kampus."}
{"id":"id.g100","card":"id.c0305","a":"Kamu lapar?","b":"Nggak, aku udah makan."}
{"id":"id.g101","card":"id.c0307","a":"Gimana kabarnya?","b":"Baik. Kamu gimana?"}
{"id":"id.g102","card":"id.c0321","a":"Lagi apa?","b":"Lagi nonton film. Kenapa?"}
{"id":"id.g103","card":"id.c0313","a":"Lima ratus ribu.","b":"Kok mahal?"}
{"id":"id.g104","card":"id.c0319","a":"Ini kopinya.","b":"Makasih, ya."}
{"id":"id.g105","card":"id.c0320","a":"Maaf, aku telat.","b":"Nggak apa-apa."}
{"id":"id.g106","card":"id.c0859","a":"Masakan Ibu enak sekali.","b":"Ah, biasa saja. Tambah lagi, ya!"}
{"id":"id.g107","card":"id.c0863","a":"Wah, kamu jago! Sudah lama main gitar?","b":"Baru dua tahun."}
{"id":"id.g108","card":"id.c0867","a":"Bagaimana kalau kita makan malam di pantai?","b":"Ide bagus!"}
{"id":"id.g109","card":"id.c0870","a":"Ini, saya bawakan payung.","b":"Kamu baik sekali. Terima kasih!"}
{"id":"id.g110","card":"id.c0873","a":"Anak Ibu pintar sekali.","b":"Terima kasih, Mbak. Dia suka membaca."}
{"id":"id.g111","card":"id.c0875","a":"Rumah Ibu nyaman sekali.","b":"Terima kasih. Silakan duduk."}
{"id":"id.g112","card":"id.c0877","a":"Kamu cocok pakai batik.","b":"Terima kasih! Ini batik dari Solo."}
{"id":"id.g113","card":"id.c0880","a":"Bahasa Indonesianya lancar sekali!","b":"Belum lancar, masih belajar."}
{"id":"id.g114","card":"id.c0886","a":"Presentasi Anda bagus sekali.","b":"Terima kasih atas pujiannya, Pak."}
{"id":"id.g115","card":"id.c0861","a":"Ini sayur asem buatan saya.","b":"Enak sekali! Boleh minta resepnya?"}
{"id":"id.g116","card":"id.c0864","a":"Saya sudah lari sepuluh kilo.","b":"Wah, mantap!"}
{"id":"id.g117","card":"id.c0865","a":"Laporannya sudah selesai, Pak.","b":"Kerja bagus! Terima kasih."}
{"id":"id.g118","card":"id.c0884","a":"Ibu masih kelihatan muda sekali!","b":"Ah, Ibu bisa saja."}
{"id":"id.g119","card":"id.c0881","a":"Selamat pagi, Bu. Apa kabar?","b":"Wah, sudah bisa bahasa Indonesia!"}
{"id":"id.g120","card":"id.c0883","a":"Kamu pintar sekali main gitar.","b":"Ah, tidak juga. Masih belajar."}
{"id":"id.g121","card":"id.c0911","a":"Maaf, aku terlambat.","b":"Tidak apa-apa. Kamu cantik sekali malam ini."}
{"id":"id.g122","card":"id.c0914","a":"Kamu ganteng pakai kemeja itu.","b":"Makasih! Ini kemeja baru."}
{"id":"id.g123","card":"id.c0915","a":"Senyum kamu manis sekali.","b":"Ah, gombal! Tapi makasih."}
{"id":"id.g124","card":"id.c0918","a":"Kenapa kamu senyum-senyum?","b":"Kamu bikin aku ketawa terus."}
{"id":"id.g125","card":"id.c0921","a":"Gaya kamu keren. Beli di mana bajunya?","b":"Di pasar, murah!"}
{"id":"id.g126","card":"id.c0923","a":"Mata kamu indah.","b":"Kamu manis, deh."}
{"id":"id.g127","card":"id.c0925","a":"Suara kamu bagus. Kamu suka menyanyi?","b":"Iya, sejak kecil."}
{"id":"id.g128","card":"id.c0930","a":"Aku senang ngobrol sama kamu.","b":"Aku juga. Kamu asyik!"}
{"id":"id.g129","card":"id.c0934","a":"Aku suka sama kamu.","b":"Serius? Aku juga suka kamu."}
{"id":"id.g130","card":"id.c0936","a":"Permisi, boleh kenalan? Aku Ryan.","b":"Boleh. Aku Putri."}
{"id":"id.g131","card":"id.c0937","a":"Boleh minta nomor kamu?","b":"Boleh. Nanti aku kirim, ya."}
{"id":"id.g132","card":"id.c0938","a":"Mau ngopi bareng kapan-kapan?","b":"Boleh, aku mau."}
{"id":"id.g133","card":"id.c0939","a":"Malam Minggu ada acara?","b":"Belum ada. Kenapa?"}
{"id":"id.g134","card":"id.c0941","a":"Aku mau ketemu kamu lagi.","b":"Boleh banget!"}
{"id":"id.g135","card":"id.c0940","a":"Kamu sudah punya pacar?","b":"Makasih, tapi aku sudah punya pacar."}
{"id":"id.g136","card":"id.c0948","a":"Besok mau makan malam bareng?","b":"Lihat nanti, ya."}
{"id":"id.g137","card":"id.c0951","a":"Aku naksir kamu. Mau jalan sama aku?","b":"Makasih, tapi kita teman saja, ya. Kamu baik sekali."}
{"id":"id.g138","card":"id.c0950","a":"Boleh minta nomornya?","b":"Maaf, aku tidak tertarik."}
{"id":"id.g139","card":"id.c0768","a":"Hei, Budi! Mau ke mana?","b":"Ke pasar. Ikut?"}
{"id":"id.g140","card":"id.c0766","a":"Tokonya tutup hari Minggu.","b":"Oh, begitu. Terima kasih."}
{"id":"id.g141","card":"id.c0773","a":"Bahasa Indonesia kamu bagus sekali!","b":"Ah, masih belajar."}
{"id":"id.g142","card":"id.c0779","a":"Ini oleh-oleh dari Bali.","b":"Wah! Terima kasih banyak!"}
{"id":"id.g143","card":"id.c0782","a":"Kenapa?","b":"Aduh! Kaki saya sakit."}
{"id":"id.g144","card":"id.c0767","a":"Ayo, kita makan sekarang!","b":"Ayo! Saya lapar sekali."}
{"id":"id.g145","card":"id.c0774","a":"Astaga! Dompet saya tidak ada!","b":"Tenang, coba lihat di tas."}
{"id":"id.g146","card":"id.c0778","a":"Ya ampun, kamu basah sekali!","b":"Iya, tadi hujan deras."}
{"id":"id.g147","card":"id.c0789","a":"Keretanya terlambat dua jam.","b":"Waduh! Kita bisa terlambat."}
{"id":"id.g148","card":"id.c0775","a":"Di mana kuncinya?","b":"Nah, ini dia! Di bawah meja."}
{"id":"id.g149","card":"id.c0776","a":"Eh, kamu sudah makan?","b":"Belum. Ayo makan!"}
{"id":"id.g150","card":"id.c0787","a":"Makan bakso, yuk!","b":"Boleh, yuk!"}
{"id":"id.g151","card":"id.c0784","a":"Besok libur!","b":"Hore!"}
{"id":"id.g152","card":"id.c0781","a":"Ibu saya sudah sehat lagi.","b":"Syukurlah."}
{"id":"id.g153","card":"id.c0780","a":"Kucingnya lapar dan kecil.","b":"Kasihan! Ayo kita kasih makan."}
{"id":"id.g154","card":"id.c0772","a":"Anak saya sudah tiga.","b":"Masa? Kamu masih muda sekali!"}
{"id":"id.g155","card":"id.c0785","a":"Ups! Maaf, kopinya tumpah.","b":"Tidak apa-apa."}
{"id":"id.g156","card":"id.c0788","a":"Saya jemput jam tujuh, ya.","b":"Sip!"}
{"id":"id.g157","card":"id.c0771","a":"Halo? Ini Rina?","b":"Ya, ini Rina. Siapa ini?"}
{"id":"id.g158","card":"id.c0783","a":"Semoga cepat sembuh, ya.","b":"Amin. Terima kasih."}
{"id":"id.g159","card":"id.c0791","a":"Bagaimana kabarnya, Pak?","b":"Alhamdulillah, baik."}
{"id":"id.g160","card":"id.c0790","a":"Besok bisa datang?","b":"Insya Allah."}
{"id":"id.g161","card":"id.c0792","a":"Ini pacar saya, Andi.","b":"Cie! Akhirnya!"}
{"id":"id.g162","card":"id.c0786","a":"Duh, saya lupa bawa payung.","b":"Pakai payung saya saja."}
{"id":"id.g163","card":"id.c0793","a":"Mau coba durian?","b":"Idih! Baunya!"}
{"id":"id.g164","card":"id.c0777","a":"Harganya satu juta.","b":"Hah? Satu juta?"}
{"id":"id.g165","card":"id.c0769","a":"Kita bertemu di stasiun jam lima.","b":"Oke. Sampai nanti."}
{"id":"id.g166","card":"id.c0770","a":"Saya dapat pekerjaan baru!","b":"Selamat! Hebat!"}
