{"id":"ar.g001","card":"ar.c0002","a":"مَا أَوَّل حَرْف فِي «بَيْت»؟","b":"الْبَاء، بِنُقْطَة وَاحِدَة تَحْتَهَا."}
{"id":"ar.g002","card":"ar.c0006","a":"هَل «حَال» بِالْحَاء أَم بِالْهَاء؟","b":"بِالْحَاء، مِن الْحَلْق."}
{"id":"ar.g003","card":"ar.c0014","a":"هَل «صَيْف» بِالسِّين؟","b":"لَا، بِالصَّاد."}
{"id":"ar.g004","card":"ar.c0015","a":"مَا لُغَةْ الضَّاد؟","b":"هِيَ اللُّغَة الْعَرَبِيَّة."}
{"id":"ar.g005","card":"ar.c0021","a":"هَل «قَلْب» بِالْكَاف؟","b":"لَا، بِالْقَاف."}
{"id":"ar.g006","card":"ar.c0028","a":"مَا آخِر حَرْف فِي «عَرَبِيّ»؟","b":"الْيَاء."}
{"id":"ar.g007","card":"ar.c0037","a":"تَفَضَّل، هٰذِهِ قَهْوَة عَرَبِيَّة.","b":"شُكْرًا."}
{"id":"ar.g008","card":"ar.c0035","a":"مَن هٰذِهِ؟","b":"هٰذِهِ سَارَة، هِيَ مُدَرِّسَة."}
{"id":"ar.g009","card":"ar.c0044","a":"الْجَوّ حَارّ الْيَوْم.","b":"نَعَم، الشَّمْس قَوِيَّة."}
{"id":"ar.g010","card":"ar.c0048","a":"هَل عِنْدَكَ كَلْب؟","b":"نَعَم، عِنْدِي كَلْب صَغِير."}
{"id":"ar.g011","card":"ar.c0059","a":"مَا هٰذَا؟","b":"هٰذَا جَمَل."}
{"id":"ar.g012","card":"ar.c0061","a":"أَيْنَ دَرَسَ أَحْمَد؟","b":"دَرَسَ فِي الْقَاهِرَة."}
{"id":"ar.g013","card":"ar.c0063","a":"السَّلَامُ عَلَيْكُم.","b":"وَعَلَيْكُم السَّلَام، أَهْلًا وَسَهْلًا."}
{"id":"ar.g014","card":"ar.c0072","a":"مَرْحَبًا يَا سَارَة، كَيْفَ حَالُكِ؟","b":"بِخَيْر، الْحَمْدُ لِلّٰه. وَأَنْتَ؟"}
{"id":"ar.g015","card":"ar.c0067","a":"صَبَاح الْخَيْر يَا أُسْتَاذ.","b":"صَبَاح النُّور."}
{"id":"ar.g016","card":"ar.c0074","a":"شُكْرًا جَزِيلًا.","b":"عَفْوًا."}
{"id":"ar.g017","card":"ar.c0078","a":"هٰذِهِ صَدِيقَتِي مَرْيَم.","b":"تَشَرَّفْنَا يَا مَرْيَم."}
{"id":"ar.g018","card":"ar.c0079","a":"مَعَ السَّلَامَة يَا خَالِد.","b":"مَعَ السَّلَامَة، إِلَى اللِّقَاء."}
{"id":"ar.g019","card":"ar.c0081","a":"مَا اِسْمُكَ؟","b":"اِسْمِي يُوسُف. وَأَنْتِ؟"}
{"id":"ar.g020","card":"ar.c0085","a":"مِن أَيْنَ أَنْتِ يَا إِمِيلِي؟","b":"أَنَا مِن شِيكَاغُو، وَلٰكِن أَسْكُن فِي تِكْسَاس."}
{"id":"ar.g021","card":"ar.c0090","a":"أَيْنَ تَسْكُن يَا كَرِيم؟","b":"أَسْكُن فِي نِيُويُورْك."}
{"id":"ar.g022","card":"ar.c0094","a":"مَاذَا تَعْمَل؟","b":"أَنَا مُهَنْدِس، أَعْمَل فِي شَرِكَة."}
{"id":"ar.g023","card":"ar.c0097","a":"كَم عُمْرُكَ؟","b":"عُمْرِي خَمْسَة وَعِشْرُون."}
{"id":"ar.g024","card":"ar.c0099","a":"مَن هٰذِهِ؟","b":"هٰذِهِ أُمِّي."}
{"id":"ar.g025","card":"ar.c0115","a":"هَل عِنْدَكَ إِخْوَة؟","b":"نَعَم، عِنْدِي أَخ وَأُخْت."}
{"id":"ar.g026","card":"ar.c0105","a":"أَيْنَ زَوْجُكِ؟","b":"زَوْجِي فِي الْعَمَل."}
{"id":"ar.g027","card":"ar.c0109","a":"مَن هٰذَا؟","b":"هٰذَا صَدِيقِي جُون، هُوَ أَمْرِيكِيّ."}
{"id":"ar.g028","card":"ar.c0130","a":"بِكَم هٰذَا؟","b":"خَمْسُون رِيَالًا."}
{"id":"ar.g029","card":"ar.c0131","a":"كَم الثَّمَن؟","b":"عِشْرُون دِرْهَمًا."}
{"id":"ar.g030","card":"ar.c0118","a":"هَل عِنْدَكَ أَخ؟","b":"نَعَم، أَخ وَاحِد."}
{"id":"ar.g031","card":"ar.c0142","a":"مَاذَا تُرِيد؟","b":"أُرِيد قَهْوَة عَرَبِيَّة، مِن فَضْلِكَ."}
{"id":"ar.g032","card":"ar.c0152","a":"الْحِسَاب مِن فَضْلِكَ.","b":"تَفَضَّل، خَمْسُون رِيَالًا."}
{"id":"ar.g033","card":"ar.c0150","a":"كَيْفَ الْفَلَافِل؟","b":"لَذِيذ جِدًّا!"}
{"id":"ar.g034","card":"ar.c0148","a":"أَنَا جَائِع جِدًّا.","b":"وَأَنَا أَيْضًا. هَيَّا إِلَى الْمَطْعَم."}
{"id":"ar.g035","card":"ar.c0153","a":"هَل عِنْدَكَ سَيَّارَة؟","b":"نَعَم، عِنْدِي سَيَّارَة صَغِيرَة."}
{"id":"ar.g036","card":"ar.c0157","a":"هٰذِهِ شَقَّتِي الْجَدِيدَة.","b":"الشَّقَّة جَمِيلَة جِدًّا!"}
{"id":"ar.g037","card":"ar.c0167","a":"هَل عِنْدَكَ قَلَم؟","b":"نَعَم، تَفَضَّل."}
{"id":"ar.g038","card":"ar.c0169","a":"أَيْنَ الْمِفْتَاح؟","b":"هُوَ عَلَى الطَّاوِلَة فِي الْمَطْبَخ."}
{"id":"ar.g039","card":"ar.c0182","a":"كَيْفَ الْجَوّ فِي عَمَّان؟","b":"الْجَوّ جَمِيل الْيَوْم."}
{"id":"ar.g040","card":"ar.c0183","a":"أَيْنَ سَارَة؟","b":"هِيَ مَشْغُولَة الْآن."}
{"id":"ar.g041","card":"ar.c0186","a":"هَل الْعَرَبِيَّة صَعْبَة؟","b":"لَا، الْعَرَبِيَّة لَيْسَت صَعْبَة!"}
{"id":"ar.g042","card":"ar.c0174","a":"هٰذَا الْقَمِيص رَخِيص.","b":"نَعَم، وَهُوَ جَمِيل أَيْضًا."}
{"id":"ar.g043","card":"ar.c0188","a":"هَل تُحِبّ الْقَهْوَة؟","b":"نَعَم، أَشْرَب الْقَهْوَة كُلّ يَوْم."}
{"id":"ar.g044","card":"ar.c0187","a":"أَيْنَ تَعْمَل؟","b":"أَعْمَل فِي مَكْتَب فِي وَسَط الْمَدِينَة."}
{"id":"ar.g045","card":"ar.c0191","a":"مَاذَا تَدْرُسِين يَا لَيْلَى؟","b":"أَدْرُس الطِّبّ فِي الْجَامِعَة."}
{"id":"ar.g046","card":"ar.c0190","a":"مَتَى تَسْتَيْقِظ؟","b":"أَسْتَيْقِظ مُبَكِّرًا، فِي السَّاعَة السَّادِسَة."}
{"id":"ar.g047","card":"ar.c0218","a":"مَاذَا فَعَلْتَ أَمْس؟","b":"ذَهَبْتُ إِلَى السِّينَمَا مَعَ صَدِيقِي."}
{"id":"ar.g048","card":"ar.c0204","a":"أَيّ يَوْم الْيَوْم؟","b":"الْيَوْم يَوْم الْخَمِيس."}
{"id":"ar.g049","card":"ar.c0205","a":"هَل تَعْمَل غَدًا؟","b":"لَا، غَدًا يَوْم السَّبْت."}
{"id":"ar.g050","card":"ar.c0219","a":"أَيْنَ مَرْيَم؟","b":"سَافَرَت إِلَى عَمَّان الْأُسْبُوع الْمَاضِي."}
{"id":"ar.g051","card":"ar.c0221","a":"لَوْ سَمَحْتَ، أَيْنَ الْمَطْعَم؟","b":"عَلَى الْيَمِين، بِجَانِب الْفُنْدُق."}
{"id":"ar.g052","card":"ar.c0231","a":"أَيْنَ الصَّيْدَلِيَّة؟","b":"عَلَى طُول، ثُمَّ عَلَى الْيَسَار."}
{"id":"ar.g053","card":"ar.c0223","a":"هَل الْمَتْحَف قَرِيب مِن هُنَا؟","b":"نَعَم، هُوَ قَرِيب جِدًّا."}
{"id":"ar.g054","card":"ar.c0236","a":"الْبَنْك أَمَام الْمَسْجِد.","b":"آسِف، لَا أَفْهَم."}
{"id":"ar.g055","card":"ar.c0239","a":"جَوَاز السَّفَر، مِن فَضْلِكَ.","b":"تَفَضَّل."}
{"id":"ar.g056","card":"ar.c0242","a":"هَل تَتَكَلَّم الْإِنْجِلِيزِيَّة؟","b":"نَعَم، قَلِيلًا."}
{"id":"ar.g057","card":"ar.c0248","a":"مَسَاء الْخَيْر، عِنْدِي حَجْز.","b":"أَهْلًا وَسَهْلًا، مَا اِسْمُكَ؟"}
{"id":"ar.g058","card":"ar.c0251","a":"بِكَم التَّذْكِرَة إِلَى الْإِسْكَنْدَرِيَّة؟","b":"خَمْسُون جُنَيْهًا."}
{"id":"ar.g059","card":"ar.c0263","a":"أَيْنَ الْفُنْدُق؟","b":"هُنَاكَ، بِجَانِب الْبَنْك."}
{"id":"ar.g060","card":"ar.c0256","a":"مَاذَا تَفْعَل الْآن؟","b":"أَقْرَأ الْجَرِيدَة."}
{"id":"ar.g061","card":"ar.c0265","a":"مَتَى الدَّرْس؟","b":"الدَّرْس غَدًا صَبَاحًا."}
{"id":"ar.g062","card":"ar.c0264","a":"كَيْفَ تَذْهَب إِلَى الْجَامِعَة؟","b":"بِالْحَافِلَة."}
{"id":"ar.g063","card":"ar.c0262","a":"مَن هٰذَا؟","b":"هٰذَا أَخِي يُوسُف."}
{"id":"ar.g064","card":"ar.c0274","a":"أَهْلًا يَا كَرِيم! كَيْفَ الْعَائِلَة؟","b":"بِخَيْر، شُكْرًا."}
{"id":"ar.g065","card":"ar.c0275","a":"شُكْرًا عَلَى الْقَهْوَة!","b":"عَفْوًا."}
{"id":"ar.g066","card":"ar.c0276","a":"نَرَاكَ غَدًا؟","b":"إِن شَاءَ اللّٰه."}
{"id":"ar.g067","card":"ar.c0280","a":"تَفَضَّل، هٰذِهِ قَهْوَتُكَ.","b":"شُكْرًا جَزِيلًا."}
{"id":"ar.g068","card":"ar.c0278","a":"أَيْنَ مَحَطَّةْ الْقِطَار؟","b":"آسِف، لَا أَعْرِف."}
{"id":"ar.g069","card":"ar.c0293","a":"سَلِمَت يَدَاكِ، الطَّعَام لَذِيذ جِدًّا.","b":"بِالْهَنَاء وَالشِّفَاء!"}
{"id":"ar.g070","card":"ar.c0297","a":"هٰذَا الْحُمُّص رَائِع!","b":"بِالْهَنَاء وَالشِّفَاء."}
{"id":"ar.g071","card":"ar.c0296","a":"سُفْرَة دَائِمَة يَا خَالَة.","b":"شُكْرًا يَا اِبْنِي، أَهْلًا وَسَهْلًا."}
{"id":"ar.g072","card":"ar.c0316","a":"عَرَبِيَّتُكَ مُمْتَازَة!","b":"شُكْرًا، مَا زِلْتُ أَتَعَلَّم."}
{"id":"ar.g073","card":"ar.c0318","a":"أَيْنَ تَعَلَّمْتَ الْعَرَبِيَّة؟","b":"فِي الْجَامِعَة، فِي أَمْرِيكَا."}
{"id":"ar.g074","card":"ar.c0299","a":"تَكَلَّمْتُ بِالْعَرَبِيَّة فِي الْمَطْعَم!","b":"أَحْسَنْتَ!"}
{"id":"ar.g075","card":"ar.c0306","a":"اللّٰه يُعْطِيكَ الْعَافِيَة يَا أَحْمَد.","b":"اللّٰه يُعَافِيكِ."}
{"id":"ar.g076","card":"ar.c0307","a":"اللّٰه يُعْطِيكِ الْعَافِيَة يَا أُمِّي.","b":"اللّٰه يُعَافِيكَ يَا اِبْنِي."}
{"id":"ar.g077","card":"ar.c0314","a":"هٰذَا اِبْنِي يُوسُف.","b":"مَا شَاءَ اللّٰه عَلَيْهِ! اللّٰه يَحْفَظُهُ."}
{"id":"ar.g078","card":"ar.c0298","a":"بَيْتُكُم جَمِيل جِدًّا.","b":"شُكْرًا، أَهْلًا وَسَهْلًا."}
{"id":"ar.g079","card":"ar.c0309","a":"دَمُكَ خَفِيف يَا عُمَر!","b":"شُكْرًا، أَنْتِ أَيْضًا."}
{"id":"ar.g080","card":"ar.c0321","a":"أَنْتَ أَفْضَل مُهَنْدِس فِي الشَّرِكَة.","b":"أَنْتَ تُجَامِلُنِي!"}
{"id":"ar.g081","card":"ar.c0312","a":"نَعِيمًا!","b":"أَنْعَمَ اللّٰه عَلَيْكَ."}
{"id":"ar.g082","card":"ar.c0308","a":"سَاعَدْتُكَ لِأَنَّكَ صَدِيقِي.","b":"أَنْتَ طَيِّب جِدًّا، شُكْرًا."}
{"id":"ar.g083","card":"ar.c0345","a":"تَبْدِين جَمِيلَة اللَّيْلَة.","b":"شُكْرًا، وَأَنْتَ تَبْدُو أَنِيقًا."}
{"id":"ar.g084","card":"ar.c0359","a":"اِبْتِسَامَتُكِ جَمِيلَة.","b":"شُكْرًا، أَنْتَ لَطِيف."}
{"id":"ar.g085","card":"ar.c0354","a":"لِمَاذَا تَضْحَك؟","b":"أَنْتِ تُضْحِكِينَنِي دَائِمًا!"}
{"id":"ar.g086","card":"ar.c0370","a":"هَل تَشْرَبِين قَهْوَة مَعِي؟","b":"بِكُلّ سُرُور! مَتَى؟"}
{"id":"ar.g087","card":"ar.c0378","a":"هَل تَأْتِين مَعَنَا إِلَى الْمَطْعَم؟","b":"بِكُلّ سُرُور."}
{"id":"ar.g088","card":"ar.c0371","a":"هَل أَنْتِ مَشْغُولَة يَوْم الْجُمُعَة؟","b":"لَا، لِمَاذَا؟"}
{"id":"ar.g089","card":"ar.c0372","a":"هَل يُمْكِن أَن نَلْتَقِي مَرَّة أُخْرَى؟","b":"نَعَم، يُسْعِدُنِي ذٰلِكَ."}
{"id":"ar.g090","card":"ar.c0373","a":"عِنْدِي شَيْء أَقُولُهُ لَكِ: أَنْتِ تُعْجِبِينَنِي.","b":"حَقًّا؟ وَأَنْتَ أَيْضًا تُعْجِبُنِي."}
{"id":"ar.g091","card":"ar.c0383","a":"أَنْتِ تُعْجِبِينَنِي كَثِيرًا.","b":"شُكْرًا، أَنْتَ إِنْسَان طَيِّب، لٰكِن أُفَضِّل أَن نَبْقَى أَصْدِقَاء."}
{"id":"ar.g092","card":"ar.c0384","a":"هَل تَشْرَبِين قَهْوَة مَعِي يَوْم السَّبْت؟","b":"شُكْرًا، لٰكِنِّي مُرْتَبِطَة."}
{"id":"ar.g093","card":"ar.c0380","a":"عُيُونُكِ جَمِيلَة جِدًّا.","b":"تَقُول هٰذَا لِكُلّ الْبَنَات!"}
{"id":"ar.g094","card":"ar.c0363","a":"مَا شَاءَ اللّٰه عَلَيْكِ، تَبْدِين رَائِعَة.","b":"اللّٰه يَحْفَظُكَ."}
{"id":"ar.g095","card":"ar.c0364","a":"مَا شَاءَ اللّٰه عَلَيْكَ، أَنْتَ أَنِيق الْيَوْم.","b":"بَارَكَ اللّٰه فِيكِ."}
{"id":"ar.g096","card":"ar.c0375","a":"اِشْتَقْتُ إِلَيْكِ!","b":"وَأَنَا أَيْضًا. كَيْفَ كَانَت رِحْلَتُكَ؟"}
{"id":"ar.g097","card":"ar.c0367","a":"أُحِبّ الْحَدِيث مَعَكِ.","b":"وَأَنَا أَيْضًا، أَنْتَ ظَرِيف جِدًّا."}
{"id":"ar.g098","card":"ar.c0382","a":"هَل نَذْهَب إِلَى الْمَطْعَم اللَّيْلَة؟","b":"رُبَّمَا فِي وَقْت آخَر، أَنَا مُتْعَبَة."}
{"id":"ar.g099","card":"ar.c0377","a":"لِمَاذَا تُرِيد أَن تُقَابِل أَبِي؟","b":"لِأَنَّ نِيَّتِي جَادَّة."}
{"id":"ar.g100","card":"ar.c0385","a":"هَل يُمْكِن أَن نَتَكَلَّم قَلِيلًا؟","b":"عُذْرًا، لَسْتُ مُهْتَمَّة."}
{"id":"ar.g101","card":"ar.c0350","a":"كَيْفَ أَبْدُو؟","b":"أَنْتَ وَسِيم جِدًّا الْيَوْم."}
{"id":"ar.g102","card":"ar.c0352","a":"ذَوْقُكِ رَائِع!","b":"شُكْرًا، اِشْتَرَيْتُ هٰذِهِ الْحَقِيبَة أَمْس."}
{"id":"ar.g103","card":"ar.c0347","a":"رُوحُكِ حُلْوَة.","b":"وَكَلَامُكَ حُلْو!"}
{"id":"ar.g104","card":"ar.c0387","a":"لِمَاذَا لَا؟ مَرَّة وَاحِدَة فَقَط!","b":"قُلْتُ لَا. مِن فَضْلِكَ، تَوَقَّف."}
{"id":"ar.g105","card":"ar.c0386","a":"هَل أَنْتِ مَشْغُولَة اللَّيْلَة؟","b":"نَعَم، أَنَا مُتَزَوِّجَة."}
{"id":"ar.g106","card":"ar.c0735","a":"هَل فَهِمْتَ الدَّرْس؟","b":"آه، الْآن فَهِمْتُ!"}
{"id":"ar.g107","card":"ar.c0744","a":"مَاذَا حَدَثَ؟","b":"آخ! يَدِي!"}
{"id":"ar.g108","card":"ar.c0736","a":"الْقِطَار مُتَأَخِّر سَاعَة.","b":"أُفّ!"}
{"id":"ar.g109","card":"ar.c0741","a":"هٰذَا بَيْتِي الْجَدِيد.","b":"يَا سَلَام! جَمِيل جِدًّا."}
{"id":"ar.g110","card":"ar.c0751","a":"عِنْدِي عَمَل جَدِيد!","b":"وَاللّٰه؟ أَنَا سَعِيد جِدًّا!"}
{"id":"ar.g111","card":"ar.c0743","a":"قَابَلْتُ مُدَرِّسِي الْقَدِيم فِي لَنْدَن!","b":"سُبْحَانَ اللّٰه! الْعَالَم صَغِير."}
{"id":"ar.g112","card":"ar.c0745","a":"جَدَّتِي مَرِيضَة.","b":"يَا حَرَام! اللّٰه يَحْفَظُهَا."}
{"id":"ar.g113","card":"ar.c0747","a":"مَبْرُوك عَلَى الْعَمَل الْجَدِيد!","b":"اللّٰه يُبَارِك فِيكَ."}
{"id":"ar.g114","card":"ar.c0742","a":"سَافَرَ أَحْمَد إِلَى الْيَابَان أَمْس.","b":"مَعْقُول؟ لَم يَقُل شَيْئًا!"}
{"id":"ar.g115","card":"ar.c0732","a":"هَيَّا، نَحْنُ مُتَأَخِّرُون!","b":"دَقِيقَة وَاحِدَة!"}
{"id":"ar.g116","card":"ar.c0734","a":"أَنَا ذَاهِب الْآن.","b":"مَهْلًا! نَسِيتَ الْمِفْتَاح."}
{"id":"ar.g117","card":"ar.c0748","a":"سَارَة لَيْسَت فِي الْعَمَل الْيَوْم.","b":"عَجَبًا! هِيَ هُنَاكَ كُلّ يَوْم."}
{"id":"ar.g118","card":"ar.c0750","a":"أُسَافِر إِلَى الْقَاهِرَة غَدًا لِلْعَمَل.","b":"بِالتَّوْفِيق!"}
{"id":"ar.g119","card":"ar.c0738","a":"إِن شَاءَ اللّٰه يَكُون الْجَوّ جَمِيلًا غَدًا.","b":"يَا رَبّ!"}
{"id":"ar.g120","card":"ar.c0733","a":"سَيَّارَتِي لَيْسَت هُنَا!","b":"يَا إِلٰهِي! هَل نَتَّصِل بِالشُّرْطَة؟"}
{"id":"ar.g121","card":"ar.c0749","a":"أَلُو، مَن مَعِي؟","b":"أَنَا خَالِد."}
{"id":"ar.g122","card":"ar.c0739","a":"أُرِيد فِنْجَان قَهْوَة آخَر!","b":"كَفَى! شَرِبْتَ كَثِيرًا الْيَوْم."}
{"id":"ar.g123","card":"ar.c0740","a":"اِنْتَبِه! السَّيَّارَة!","b":"شُكْرًا، لَم أَرَهَا."}
{"id":"ar.g124","card":"ar.c0737","a":"النَّجْدَة!","b":"مَاذَا حَدَثَ؟ هَل أَنْتِ بِخَيْر؟"}
{"id":"ar.g125","card":"ar.c0746","a":"اللّٰه يَحْفَظُكَ.","b":"آمِين، وَإِيَّاكِ."}
