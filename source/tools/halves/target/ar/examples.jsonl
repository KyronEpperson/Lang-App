{"id":"ar.e001","card":"ar.c0012","ar":"السِّين أَوَّل حَرْف فِي «سَلَام»."}
{"id":"ar.e002","card":"ar.c0010","ar":"الرَّاء لَا تَتَّصِل بِالْحَرْف بَعْدَهَا."}
{"id":"ar.e003","card":"ar.c0018","ar":"الْعَيْن أَوَّل حَرْف فِي «عَرَبِيّ»."}
{"id":"ar.e004","card":"ar.c0027","ar":"الْوَاو فِي «نُور» تُقْرَأ ضَمَّة طَوِيلَة."}
{"id":"ar.e005","card":"ar.c0038","ar":"عِنْدِي سُؤَال، مِن فَضْلِكَ."}
{"id":"ar.e006","card":"ar.c0045","ar":"الْقَمَر جَمِيل اللَّيْلَة."}
{"id":"ar.e007","card":"ar.c0047","ar":"عِنْدَهُ قَلْب كَبِير."}
{"id":"ar.e008","card":"ar.c0062","ar":"دَرَّسَ الْعَرَبِيَّة فِي جَامِعَةْ تُولْسَا."}
{"id":"ar.e009","card":"ar.c0075","ar":"قَهْوَة عَرَبِيَّة، مِن فَضْلِكَ."}
{"id":"ar.e010","card":"ar.c0066","ar":"أَهْلًا وَسَهْلًا فِي عَمَّان!"}
{"id":"ar.e011","card":"ar.c0095","ar":"أَدْرُس الْعَرَبِيَّة فِي الْجَامِعَة."}
{"id":"ar.e012","card":"ar.c0088","ar":"أَنَا أَمْرِيكِيّ، وَأُمِّي مِن لُبْنَان."}
{"id":"ar.e013","card":"ar.c0113","ar":"عَائِلَتِي كَبِيرَة، وَنَأْكُل عِنْدَ جَدَّتِي كُلّ يَوْم جُمُعَة."}
{"id":"ar.e014","card":"ar.c0114","ar":"أُمِّي مُدَرِّسَة فِي مَدْرَسَة كَبِيرَة."}
{"id":"ar.e015","card":"ar.c0132","ar":"الْحِسَاب عِشْرُون رِيَالًا فَقَط."}
{"id":"ar.e016","card":"ar.c0124","ar":"عُمْر أَخِي وَاحِد وَعِشْرُون."}
{"id":"ar.e017","card":"ar.c0135","ar":"فِي الْبَيْت عِنْدَنَا قَهْوَة عَرَبِيَّة وَتَمْر."}
{"id":"ar.e018","card":"ar.c0138","ar":"أُرِيد قَهْوَة بِدُون سُكَّر، مِن فَضْلِكَ."}
{"id":"ar.e019","card":"ar.c0149","ar":"أَنَا نَبَاتِيَّة، لَا آكُل اللَّحْم."}
{"id":"ar.e020","card":"ar.c0161","ar":"غُرْفَةْ النَّوْم كَبِيرَة وَالْمَطْبَخ صَغِير."}
{"id":"ar.e021","card":"ar.c0166","ar":"لَيْسَ عِنْدِي وَقْت الْيَوْم، أَنَا مَشْغُول جِدًّا."}
{"id":"ar.e022","card":"ar.c0168","ar":"عِنْدَهَا قِطَّة صَغِيرَة اِسْمُهَا لُولُو."}
{"id":"ar.e023","card":"ar.c0184","ar":"مَرَّاكُش مَدِينَة جَمِيلَة وَقَدِيمَة."}
{"id":"ar.e024","card":"ar.c0180","ar":"الْجَوّ حَارّ جِدًّا فِي الصَّيْف."}
{"id":"ar.e025","card":"ar.c0185","ar":"أُحِبّ هٰذِهِ الْمَدِينَة الْجَمِيلَة."}
{"id":"ar.e026","card":"ar.c0189","ar":"أَنَا أَمْرِيكِيّ وَأَتَكَلَّم الْعَرَبِيَّة قَلِيلًا."}
{"id":"ar.e027","card":"ar.c0201","ar":"أُخْتِي طَبِيبَة، هِيَ تَعْمَل فِي مُسْتَشْفَى كَبِير."}
{"id":"ar.e028","card":"ar.c0203","ar":"يَشْرَب أَحْمَد الشَّاي بِالنَّعْنَاع كُلّ صَبَاح."}
{"id":"ar.e029","card":"ar.c0207","ar":"لَا نَعْمَل يَوْم الْجُمُعَة."}
{"id":"ar.e030","card":"ar.c0213","ar":"أَحْيَانًا أَشْرَب الشَّاي فِي الْمَسَاء."}
{"id":"ar.e031","card":"ar.c0220","ar":"أَمْس أَكَلْنَا فِي مَطْعَم لُبْنَانِيّ قَرِيب مِن الْبَيْت."}
{"id":"ar.e032","card":"ar.c0235","ar":"الْفُنْدُق فِي وَسَط الْمَدِينَة، قَرِيب مِن السُّوق."}
{"id":"ar.e033","card":"ar.c0232","ar":"لَوْ سَمَحْتِ، كَيْفَ أَذْهَب إِلَى الْمَتْحَف مِن هُنَا؟"}
{"id":"ar.e034","card":"ar.c0227","ar":"الصَّيْدَلِيَّة عَلَى الْيَسَار، بِجَانِب الْبَنْك."}
{"id":"ar.e035","card":"ar.c0238","ar":"مَحَطَّةْ الْقِطَار قَرِيبَة مِن الْفُنْدُق."}
{"id":"ar.e036","card":"ar.c0244","ar":"أَخَذْنَا سَيَّارَةْ أُجْرَة مِن الْمَطَار إِلَى الْفُنْدُق."}
{"id":"ar.e037","card":"ar.c0253","ar":"أَنَا مَرِيض وَأَحْتَاج إِلَى طَبِيب."}
{"id":"ar.e038","card":"ar.c0259","ar":"لِمَاذَا تَدْرُس الْعَرَبِيَّة؟"}
{"id":"ar.e039","card":"ar.c0270","ar":"يُوجَد مَطْعَم جَيِّد قَرِيب مِن هُنَا."}
{"id":"ar.e040","card":"ar.c0269","ar":"أَنَا فِي الْمَكْتَب الْآن."}
{"id":"ar.e041","card":"ar.c0279","ar":"مَا شَاءَ اللّٰه، بَيْتُكَ جَمِيل جِدًّا!"}
{"id":"ar.e042","card":"ar.c0285","ar":"أُحِبّ الْمُوسِيقَى الْعَرَبِيَّة كَثِيرًا."}
{"id":"ar.e043","card":"ar.c0290","ar":"اِسْمِي كَرِيم، وَعُمْرِي عِشْرُون سَنَة."}
{"id":"ar.e044","card":"ar.c0292","ar":"هٰذَا لَذِيذ جِدًّا! مَا اِسْمُهُ؟"}
{"id":"ar.e045","card":"ar.c0302","ar":"فِكْرَة رَائِعَة! نَذْهَب غَدًا."}
{"id":"ar.e046","card":"ar.c0313","ar":"صُورَة جَمِيلَة! أَيْنَ هٰذَا؟"}
{"id":"ar.e047","card":"ar.c0311","ar":"اللَّوْن يَلِيق بِكِ كَثِيرًا."}
{"id":"ar.e048","card":"ar.c0301","ar":"مُمْتَاز! هٰذَا صَحِيح."}
{"id":"ar.e049","card":"ar.c0303","ar":"عَمَل رَائِع يَا سَارَة!"}
{"id":"ar.e050","card":"ar.c0334","ar":"أَحْمَد شَابّ خَلُوق."}
{"id":"ar.e051","card":"ar.c0343","ar":"عِنْدِي مَوْعِد اللَّيْلَة."}
{"id":"ar.e052","card":"ar.c0335","ar":"أَخِي خَجُول قَلِيلًا."}
{"id":"ar.e053","card":"ar.c0326","ar":"أَبِي رَجُل أَنِيق دَائِمًا."}
{"id":"ar.e054","card":"ar.c0324","ar":"الشَّاي حُلْو جِدًّا."}
{"id":"ar.e055","card":"ar.c0365","ar":"تَبَارَكَ اللّٰه، صَوْتُكِ جَمِيل."}
{"id":"ar.e056","card":"ar.c0390","ar":"لَيْسَ عِنْدَنَا وَقْت كَثِير."}
{"id":"ar.e057","card":"ar.c0401","ar":"لَا مُشْكِلَة، أَنْتَظِر هُنَا."}
{"id":"ar.e058","card":"ar.c0430","ar":"هٰذِهِ صُورَة عَائِلَتِي."}
{"id":"ar.e059","card":"ar.c0409","ar":"الدَّرْس سَاعَة وَاحِدَة فَقَط."}
{"id":"ar.e060","card":"ar.c0466","ar":"كَانَ الْجَوّ جَمِيلًا أَمْس."}
{"id":"ar.e061","card":"ar.c0472","ar":"قَالَ أَحْمَد إِنَّهُ مَشْغُول."}
{"id":"ar.e062","card":"ar.c0471","ar":"مَاذَا فَعَلَ يُوسُف أَمْس؟"}
{"id":"ar.e063","card":"ar.c0467","ar":"عَرَفَ عُمَر الطَّرِيق إِلَى الْمَطْعَم."}
{"id":"ar.e064","card":"ar.c0468","ar":"أَرَادَ خَالِد قَهْوَة بِالْحَلِيب."}
{"id":"ar.e065","card":"ar.c0479","ar":"ذَهَبَ أَبِي إِلَى الْعَمَل بِالسَّيَّارَة."}
{"id":"ar.e066","card":"ar.c0497","ar":"جَاءَ صَدِيقِي مِن عَمَّان."}
{"id":"ar.e067","card":"ar.c0478","ar":"رَأَى أَحْمَد سَارَة فِي السُّوق."}
{"id":"ar.e068","card":"ar.c0492","ar":"أَخَذَ الطَّالِب الْكِتَاب مِن الْمَكْتَبَة."}
{"id":"ar.e069","card":"ar.c0502","ar":"وَجَدَ عُمَر الْمِفْتَاح تَحْت الطَّاوِلَة."}
{"id":"ar.e070","card":"ar.c0528","ar":"أَعْطَى أَبِي أُمِّي هَدِيَّة جَمِيلَة."}
{"id":"ar.e071","card":"ar.c0474","ar":"عَمِلَ أَخِي فِي مَطْعَم لُبْنَانِيّ."}
{"id":"ar.e072","card":"ar.c0480","ar":"أَحَبَّ يُوسُف الْمَدِينَة كَثِيرًا."}
{"id":"ar.e073","card":"ar.c0486","ar":"فَهِمَ الطُّلَّاب الدَّرْس."}
{"id":"ar.e074","card":"ar.c0516","ar":"تَكَلَّمَ الْمُدَرِّس بِبُطْء."}
{"id":"ar.e075","card":"ar.c0489","ar":"هَل سَمِعَ أَحْمَد الْخَبَر؟"}
{"id":"ar.e076","card":"ar.c0511","ar":"أَكَلَ الْوَلَد الْفَلَافِل."}
{"id":"ar.e077","card":"ar.c0523","ar":"شَرِبَ جَدِّي الشَّاي فِي الْمَسَاء."}
{"id":"ar.e078","card":"ar.c0524","ar":"نَامَ الطِّفْل مُبَكِّرًا."}
{"id":"ar.e079","card":"ar.c0512","ar":"كَتَبَ أَحْمَد رِسَالَة طَوِيلَة."}
{"id":"ar.e080","card":"ar.c0527","ar":"قَرَأَ أَبِي الْجَرِيدَة فِي الصَّبَاح."}
{"id":"ar.e081","card":"ar.c0541","ar":"سَكَنَ عُمَر فِي الْقَاهِرَة سَنَة."}
{"id":"ar.e082","card":"ar.c0503","ar":"عَاشَ جَدِّي فِي بَيْت صَغِير."}
{"id":"ar.e083","card":"ar.c0530","ar":"رَجَعَ أَخِي إِلَى الْبَيْت مُتَأَخِّرًا."}
{"id":"ar.e084","card":"ar.c0496","ar":"خَرَجَ أَحْمَد مِن الْبَيْت صَبَاحًا."}
{"id":"ar.e085","card":"ar.c0509","ar":"دَخَلَ الْمُدَرِّس الْمَكْتَب."}
{"id":"ar.e086","card":"ar.c0508","ar":"جَلَسَ الضَّيْف عَلَى الْكُرْسِيّ."}
{"id":"ar.e087","card":"ar.c0483","ar":"قَامَ أَبِي مُبَكِّرًا الْيَوْم."}
{"id":"ar.e088","card":"ar.c0537","ar":"مَشَى يُوسُف إِلَى الْجَامِعَة."}
{"id":"ar.e089","card":"ar.c0504","ar":"وَصَلَ الْقِطَار مُتَأَخِّرًا."}
{"id":"ar.e090","card":"ar.c0506","ar":"بَقِيَ خَالِد فِي الْبَيْت الْيَوْم."}
{"id":"ar.e091","card":"ar.c0481","ar":"اِنْتَظَرَ عُمَر الْحَافِلَة سَاعَة."}
{"id":"ar.e092","card":"ar.c0518","ar":"سَأَلَ الطَّالِب سُؤَالًا."}
{"id":"ar.e093","card":"ar.c0510","ar":"فَتَحَ الْوَلَد النَّافِذَة."}
{"id":"ar.e094","card":"ar.c0513","ar":"أَغْلَقَ أَبِي الْبَاب."}
{"id":"ar.e095","card":"ar.c0475","ar":"بَدَأَ الدَّرْس فِي الصَّبَاح."}
{"id":"ar.e096","card":"ar.c0532","ar":"اِشْتَرَى أَحْمَد سَيَّارَة جَدِيدَة."}
{"id":"ar.e097","card":"ar.c0505","ar":"دَفَعَ صَدِيقِي الْحِسَاب."}
{"id":"ar.e098","card":"ar.c0487","ar":"تَعَلَّمَ يُوسُف الْعَرَبِيَّة فِي الْأُرْدُنّ."}
{"id":"ar.e099","card":"ar.c0473","ar":"ظَنَّ أَحْمَد أَنَّ الْمَطْعَم بَعِيد."}
{"id":"ar.e100","card":"ar.c0519","ar":"نَسِيَ أَخِي الْمِفْتَاح فِي السَّيَّارَة."}
{"id":"ar.e101","card":"ar.c0517","ar":"سَاعَدَ الْجَار أُمِّي."}
{"id":"ar.e102","card":"ar.c0544","ar":"طَبَخَ أَبِي الْعَشَاء."}
{"id":"ar.e103","card":"ar.c0543","ar":"سَافَرَ خَالِد إِلَى دُبَيّ."}
{"id":"ar.e104","card":"ar.c0499","ar":"اِتَّصَلَ صَدِيقِي بِي أَمْس."}
{"id":"ar.e105","card":"ar.c0470","ar":"مَاذَا حَدَثَ هُنَا؟"}
{"id":"ar.e106","card":"ar.c0525","ar":"ضَحِكَ الْأَطْفَال كَثِيرًا."}
{"id":"ar.e107","card":"ar.c0476","ar":"نَظَرَ أَحْمَد إِلَى السَّمَاء."}
{"id":"ar.e108","card":"ar.c0490","ar":"أَصْبَحَ الْجَوّ بَارِدًا."}
{"id":"ar.e109","card":"ar.c0545","ar":"زَارَ عُمَر الْمَتْحَف."}
{"id":"ar.e110","card":"ar.c0534","ar":"اِخْتَارَ الطِّفْل اللَّوْن الْأَحْمَر."}
{"id":"ar.e111","card":"ar.c0549","ar":"عِنْدِي عَمَل كَثِير الْيَوْم."}
{"id":"ar.e112","card":"ar.c0559","ar":"عِنْدَنَا وَقْت قَلِيل."}
{"id":"ar.e113","card":"ar.c0555","ar":"هٰذِهِ أَوَّل مَرَّة فِي عَمَّان."}
{"id":"ar.e114","card":"ar.c0547","ar":"هٰذَا آخِر قِطَار الْيَوْم."}
{"id":"ar.e115","card":"ar.c0548","ar":"هَل عِنْدَكَ لَوْن آخَر؟"}
{"id":"ar.e116","card":"ar.c0550","ar":"الطَّعَام فِي هٰذَا الْمَطْعَم رَائِع."}
{"id":"ar.e117","card":"ar.c0572","ar":"الْجَوّ سَيِّئ الْيَوْم."}
{"id":"ar.e118","card":"ar.c0546","ar":"هٰذَا صَحِيح."}
{"id":"ar.e119","card":"ar.c0570","ar":"الرَّقْم خَاطِئ."}
{"id":"ar.e120","card":"ar.c0560","ar":"هٰذَا الْأَمْر مُهِمّ جِدًّا."}
{"id":"ar.e121","card":"ar.c0556","ar":"هَل هٰذَا مُمْكِن؟"}
{"id":"ar.e122","card":"ar.c0558","ar":"هٰذَا مُسْتَحِيل!"}
{"id":"ar.e123","card":"ar.c0553","ar":"أَنَا سَعِيد جِدًّا الْيَوْم."}
{"id":"ar.e124","card":"ar.c0586","ar":"لِمَاذَا أَنْتِ حَزِينَة؟"}
{"id":"ar.e125","card":"ar.c0585","ar":"أَنَا مُتْعَب، أُرِيد أَن أَنَام."}
{"id":"ar.e126","card":"ar.c0566","ar":"أَخِي مَرِيض الْيَوْم."}
{"id":"ar.e127","card":"ar.c0599","ar":"هَل أَنْتَ عَطْشَان؟"}
{"id":"ar.e128","card":"ar.c0573","ar":"الْمُدَرِّس مَشْغُول الْآن."}
{"id":"ar.e129","card":"ar.c0563","ar":"الْعَشَاء جَاهِز!"}
{"id":"ar.e130","card":"ar.c0565","ar":"الْمَطْعَم قَرِيب مِن الْفُنْدُق."}
{"id":"ar.e131","card":"ar.c0564","ar":"الْمَطَار بَعِيد عَن الْمَدِينَة."}
{"id":"ar.e132","card":"ar.c0576","ar":"الْقِطَار سَرِيع جِدًّا."}
{"id":"ar.e133","card":"ar.c0592","ar":"الْحَقِيبَة ثَقِيلَة."}
{"id":"ar.e134","card":"ar.c0597","ar":"هٰذَا الْمَطْعَم غَالِي."}
{"id":"ar.e135","card":"ar.c0587","ar":"الْغُرْفَة نَظِيفَة الْآن."}
{"id":"ar.e136","card":"ar.c0571","ar":"عِنْدِي قَلَم أَبْيَض."}
{"id":"ar.e137","card":"ar.c0575","ar":"أُرِيد الْقَلَم الْأَحْمَر."}
{"id":"ar.e138","card":"ar.c0581","ar":"لَوْن الْبَحْر أَزْرَق."}
{"id":"ar.e139","card":"ar.c0601","ar":"أُحِبّ الطَّعَام الْعَرَبِيّ."}
{"id":"ar.e140","card":"ar.c0598","ar":"هُوَ طَالِب أَجْنَبِيّ."}
{"id":"ar.e141","card":"ar.c0561","ar":"قَرَأْتُ الْكِتَاب كَامِلًا."}
{"id":"ar.e142","card":"ar.c0582","ar":"الْفِنْجَان فَارِغ."}
{"id":"ar.e143","card":"ar.c0569","ar":"الْقَهْوَة الْعَرَبِيَّة قَوِيَّة."}
{"id":"ar.e144","card":"ar.c0584","ar":"الشَّارِع هَادِئ فِي اللَّيْل."}
{"id":"ar.e145","card":"ar.c0589","ar":"هٰذَا الْكُرْسِيّ مُرِيح."}
{"id":"ar.e146","card":"ar.c0562","ar":"الْجَوّ هُنَا مُخْتَلِف."}
{"id":"ar.e147","card":"ar.c0590","ar":"هٰذَا الدَّرْس مُفِيد."}
{"id":"ar.e148","card":"ar.c0577","ar":"كَانَ الْعَشَاء مُمْتِعًا."}
{"id":"ar.e149","card":"ar.c0600","ar":"سَارَة طَالِبَة مُجْتَهِدَة."}
{"id":"ar.e150","card":"ar.c0603","ar":"أُرِيد قَهْوَة فَقَط."}
{"id":"ar.e151","card":"ar.c0609","ar":"أَتَكَلَّم الْفَرَنْسِيَّة أَيْضًا."}
{"id":"ar.e152","card":"ar.c0606","ar":"الْجَوّ حَارّ جِدًّا الْيَوْم."}
{"id":"ar.e153","card":"ar.c0615","ar":"أُحِبّ هٰذِهِ الْمَدِينَة كَثِيرًا."}
{"id":"ar.e154","card":"ar.c0614","ar":"اِنْتَظِر قَلِيلًا مِن فَضْلِكَ."}
{"id":"ar.e155","card":"ar.c0612","ar":"لَا يَأْكُل أَخِي اللَّحْم أَبَدًا."}
{"id":"ar.e156","card":"ar.c0626","ar":"طَبْعًا، أَتَكَلَّم الْإِنْجِلِيزِيَّة."}
{"id":"ar.e157","card":"ar.c0605","ar":"رُبَّمَا نُسَافِر الشَّهْر الْقَادِم."}
{"id":"ar.e158","card":"ar.c0623","ar":"سَأَرْجِع قَرِيبًا."}
{"id":"ar.e159","card":"ar.c0620","ar":"أَتَّصِل بِكَ لَاحِقًا."}
{"id":"ar.e160","card":"ar.c0625","ar":"وَصَلَ الْقِطَار أَخِيرًا."}
{"id":"ar.e161","card":"ar.c0619","ar":"نَدْرُس الْعَرَبِيَّة مَعًا."}
{"id":"ar.e162","card":"ar.c0624","ar":"عُمْرُهُ عِشْرُون سَنَة تَقْرِيبًا."}
{"id":"ar.e163","card":"ar.c0608","ar":"هٰذَا الطَّعَام لَذِيذ حَقًّا."}
{"id":"ar.e164","card":"ar.c0613","ar":"فَهِمْتُ تَمَامًا."}
{"id":"ar.e165","card":"ar.c0631","ar":"غَالِبًا أَشْرَب الشَّاي فِي الْمَسَاء."}
{"id":"ar.e166","card":"ar.c0617","ar":"هِيَ تَطْبُخ جَيِّدًا."}
{"id":"ar.e167","card":"ar.c0616","ar":"تَعَالَ بِسُرْعَة!"}
{"id":"ar.e168","card":"ar.c0629","ar":"وَصَلْتُ إِلَى الْعَمَل مُبَكِّرًا."}
{"id":"ar.e169","card":"ar.c0632","ar":"لَا أَشْرَب الْقَهْوَة لَيْلًا."}
{"id":"ar.e170","card":"ar.c0607","ar":"أُرِيد أَن أَتَعَلَّم أَكْثَر."}
{"id":"ar.e171","card":"ar.c0627","ar":"لِلْأَسَف، لَيْسَ عِنْدِي وَقْت الْيَوْم."}
{"id":"ar.e172","card":"ar.c0610","ar":"قُل ذٰلِكَ مَرَّة أُخْرَى، مِن فَضْلِكَ."}
{"id":"ar.e173","card":"ar.c0636","ar":"أَنَا مِن تُولْسَا."}
{"id":"ar.e174","card":"ar.c0638","ar":"أَنْتَ صَدِيقِي."}
{"id":"ar.e175","card":"ar.c0639","ar":"أَنْتِ طَالِبَة مُجْتَهِدَة."}
{"id":"ar.e176","card":"ar.c0640","ar":"هُوَ أَخِي الْكَبِير."}
{"id":"ar.e177","card":"ar.c0645","ar":"هِيَ مُهَنْدِسَة فِي شَرِكَة كَبِيرَة."}
{"id":"ar.e178","card":"ar.c0643","ar":"نَحْنُ فِي الْمَطْعَم الْآن."}
{"id":"ar.e179","card":"ar.c0662","ar":"أَنْتُم طُلَّاب مُمْتَازُون."}
{"id":"ar.e180","card":"ar.c0659","ar":"هُم مِن مِصْر."}
{"id":"ar.e181","card":"ar.c0664","ar":"هُنَّ مُدَرِّسَات فِي الْمَدْرَسَة."}
{"id":"ar.e182","card":"ar.c0663","ar":"هُمَا أَخَوَان."}
{"id":"ar.e183","card":"ar.c0646","ar":"بَيْتِي قَرِيب مِن الْجَامِعَة."}
{"id":"ar.e184","card":"ar.c0647","ar":"بَيْتُكَ جَمِيل جِدًّا."}
{"id":"ar.e185","card":"ar.c0648","ar":"أَيْنَ بَيْتُكِ؟"}
{"id":"ar.e186","card":"ar.c0649","ar":"بَيْتُهُ بَعِيد عَن هُنَا."}
{"id":"ar.e187","card":"ar.c0650","ar":"بَيْتُهَا فِي وَسَط الْمَدِينَة."}
{"id":"ar.e188","card":"ar.c0651","ar":"بَيْتُنَا صَغِير لٰكِن جَمِيل."}
{"id":"ar.e189","card":"ar.c0652","ar":"بَيْتُكُم كَبِير!"}
{"id":"ar.e190","card":"ar.c0653","ar":"بَيْتُهُم قَدِيم."}
{"id":"ar.e191","card":"ar.c0641","ar":"هٰذِهِ سَيَّارَتِي."}
{"id":"ar.e192","card":"ar.c0637","ar":"ذٰلِكَ الرَّجُل أُسْتَاذ."}
{"id":"ar.e193","card":"ar.c0654","ar":"تِلْكَ الْمَدِينَة جَمِيلَة."}
{"id":"ar.e194","card":"ar.c0660","ar":"هٰؤُلَاءِ أَصْدِقَائِي."}
{"id":"ar.e195","card":"ar.c0644","ar":"أَيّ لَوْن تُرِيد؟"}
{"id":"ar.e196","card":"ar.c0656","ar":"هَل هُنَاكَ أَحَد فِي الْبَيْت؟"}
{"id":"ar.e197","card":"ar.c0642","ar":"أَشْرَب الْقَهْوَة كُلّ صَبَاح."}
{"id":"ar.e198","card":"ar.c0655","ar":"بَعْض الطُّلَّاب هُنَا."}
{"id":"ar.e199","card":"ar.c0661","ar":"نَحْنُ فِي نَفْس الْجَامِعَة."}
{"id":"ar.e200","card":"ar.c0657","ar":"مَاذَا تُرِيد؟ لَا شَيْء، شُكْرًا."}
{"id":"ar.e201","card":"ar.c0658","ar":"لَا أَحَد فِي الْمَكْتَب الْآن."}
{"id":"ar.e202","card":"ar.c0666","ar":"الْمِفْتَاح فِي الْحَقِيبَة."}
{"id":"ar.e203","card":"ar.c0665","ar":"هٰذِهِ الْقَهْوَة مِن الْيَمَن."}
{"id":"ar.e204","card":"ar.c0669","ar":"نَذْهَب إِلَى الْبَحْر يَوْم السَّبْت."}
{"id":"ar.e205","card":"ar.c0670","ar":"نَتَكَلَّم عَن الْعَمَل."}
{"id":"ar.e206","card":"ar.c0671","ar":"أَسْكُن مَعَ عَائِلَتِي."}
{"id":"ar.e207","card":"ar.c0667","ar":"أَكْتُب بِالْقَلَم."}
{"id":"ar.e208","card":"ar.c0668","ar":"هٰذِهِ الْهَدِيَّة لِأُمِّي."}
{"id":"ar.e209","card":"ar.c0681","ar":"هِيَ كَالْأُمّ لِي."}
{"id":"ar.e210","card":"ar.c0691","ar":"أَنَا عِنْد صَدِيقِي الْآن."}
{"id":"ar.e211","card":"ar.c0677","ar":"أَشْرَب الْقَهْوَة قَبْل الْعَمَل."}
{"id":"ar.e212","card":"ar.c0676","ar":"نَلْتَقِي بَعْد الدَّرْس."}
{"id":"ar.e213","card":"ar.c0688","ar":"الْبَنْك بَيْن الْمَطْعَم وَالْفُنْدُق."}
{"id":"ar.e214","card":"ar.c0675","ar":"أَعْمَل حَتَّى الْمَسَاء."}
{"id":"ar.e215","card":"ar.c0679","ar":"أَدْرُس الْعَرَبِيَّة مُنْذُ سَنَة."}
{"id":"ar.e216","card":"ar.c0692","ar":"الْقِطَّة تَحْت السَّرِير."}
{"id":"ar.e217","card":"ar.c0695","ar":"الْكُتُب فَوْق الطَّاوِلَة."}
{"id":"ar.e218","card":"ar.c0698","ar":"أَنْتَظِرُكَ أَمَام الْبَاب."}
{"id":"ar.e219","card":"ar.c0701","ar":"السَّيَّارَة خَلْف الْبَيْت."}
{"id":"ar.e220","card":"ar.c0696","ar":"الْأَطْفَال دَاخِل الْبَيْت."}
{"id":"ar.e221","card":"ar.c0693","ar":"أَبِي يَعْمَل خَارِج الْمَدِينَة."}
{"id":"ar.e222","card":"ar.c0678","ar":"أَنْتَ مِثْل أَخِي."}
{"id":"ar.e223","card":"ar.c0690","ar":"أَشْرَب الشَّاي بِدُون سُكَّر."}
{"id":"ar.e224","card":"ar.c0687","ar":"سَأُسَافِر خِلَال الصَّيْف."}
{"id":"ar.e225","card":"ar.c0674","ar":"هَل هٰذَا الْقَلَم لِي؟"}
{"id":"ar.e226","card":"ar.c0672","ar":"هٰذِهِ الْقَهْوَة لَكَ."}
{"id":"ar.e227","card":"ar.c0673","ar":"هٰذَا الْكِتَاب لَكِ."}
{"id":"ar.e228","card":"ar.c0685","ar":"هَل تَأْتِي مَعِي؟"}
{"id":"ar.e229","card":"ar.c0683","ar":"هَل الْمِفْتَاح مَعَكِ؟"}
{"id":"ar.e230","card":"ar.c0700","ar":"عِنْدِي دَرْس فِي الصَّبَاح."}
{"id":"ar.e231","card":"ar.c0706","ar":"عِنْدَهُ سَيَّارَة حَمْرَاء."}
{"id":"ar.e232","card":"ar.c0705","ar":"عِنْدَنَا ضُيُوف اللَّيْلَة."}
{"id":"ar.e233","card":"ar.c0694","ar":"عَلَيَّ أَن أَعْمَل غَدًا."}
{"id":"ar.e234","card":"ar.c0709","ar":"أُحِبّ الْقَهْوَة وَالشَّاي."}
{"id":"ar.e235","card":"ar.c0713","ar":"نَذْهَب الْيَوْم أَوْ غَدًا."}
{"id":"ar.e236","card":"ar.c0710","ar":"أُرِيد أَن أَذْهَب، لٰكِن لَيْسَ عِنْدِي وَقْت."}
{"id":"ar.e237","card":"ar.c0716","ar":"كُنْتُ جَائِعًا فَأَكَلْتُ."}
{"id":"ar.e238","card":"ar.c0717","ar":"أَكَلْنَا ثُمَّ ذَهَبْنَا إِلَى الْبَيْت."}
{"id":"ar.e239","card":"ar.c0720","ar":"لَا أَشْرَب الْقَهْوَة لِأَنَّهَا قَوِيَّة."}
{"id":"ar.e240","card":"ar.c0711","ar":"إِذَا كَانَ الْجَوّ جَمِيلًا، نَذْهَب إِلَى الْبَحْر."}
{"id":"ar.e241","card":"ar.c0714","ar":"لَوْ كَانَ عِنْدِي وَقْت، لَسَافَرْتُ."}
{"id":"ar.e242","card":"ar.c0707","ar":"أَظُنّ أَنَّ الْمَطْعَم قَرِيب."}
{"id":"ar.e243","card":"ar.c0708","ar":"أُرِيد أَن أَتَعَلَّم الْعَرَبِيَّة."}
{"id":"ar.e244","card":"ar.c0712","ar":"عِنْدَمَا أَصِل، أَتَّصِل بِكَ."}
{"id":"ar.e245","card":"ar.c0725","ar":"أَسْمَع الْمُوسِيقَى بَيْنَمَا أَطْبُخ."}
{"id":"ar.e246","card":"ar.c0721","ar":"هَل تُرِيدِين قَهْوَة أَم شَاي؟"}
{"id":"ar.e247","card":"ar.c0722","ar":"أَحْمَد لَيْسَ مُهَنْدِسًا بَل طَبِيب."}
{"id":"ar.e248","card":"ar.c0719","ar":"أَنَا مُتْعَب، لِذٰلِكَ أَنَام مُبَكِّرًا."}
{"id":"ar.e249","card":"ar.c0729","ar":"ذَهَبْنَا إِلَى الْبَحْر مَعَ أَنَّ الْجَوّ كَانَ بَارِدًا."}
{"id":"ar.e250","card":"ar.c0724","ar":"أَشْرَب الْحَلِيب قَبْل أَن أَنَام."}
{"id":"ar.e251","card":"ar.c0726","ar":"خَرَجْنَا بَعْد أَن أَكَلْنَا."}
{"id":"ar.e252","card":"ar.c0715","ar":"كَمَا تُرِيدِين."}
