{"id":"ceb.g001","card":"ceb.c0001","a":"Asa ang inyong balay?","b":"Sa Talisay, duol sa simbahan."}
{"id":"ceb.g002","card":"ceb.c0002","a":"Kinsa kanang bata?","b":"Akong anak siya."}
{"id":"ceb.g003","card":"ceb.c0010","a":"Imo ba ning iro?","b":"Oo. Bantay ang iyang ngalan."}
{"id":"ceb.g004","card":"ceb.c0005","a":"Asa ang mga bata?","b":"Didto sa gawas, nagdula."}
{"id":"ceb.g005","card":"ceb.c0019","a":"Maayong buntag, Nang!","b":"Maayong buntag sab."}
{"id":"ceb.g006","card":"ceb.c0023","a":"Kumusta ka, Ana?","b":"Maayo man. Ikaw?"}
{"id":"ceb.g007","card":"ceb.c0026","a":"Daghang salamat sa tabang.","b":"Walay sapayan."}
{"id":"ceb.g008","card":"ceb.c0030","a":"Pwede mosulod?","b":"Oo, dayon lang!"}
{"id":"ceb.g009","card":"ceb.c0033","a":"Pasensya na, ulahi ko.","b":"Sige lang."}
{"id":"ceb.g010","card":"ceb.c0035","a":"Una na ko, ha?","b":"Sige, amping!"}
{"id":"ceb.g011","card":"ceb.c0039","a":"Unsay imong ngalan?","b":"Ako si Emma. Ikaw?"}
{"id":"ceb.g012","card":"ceb.c0042","a":"Taga-asa ka?","b":"Taga-Amerika ko, pero nagpuyo ko sa Cebu karon."}
{"id":"ceb.g013","card":"ceb.c0045","a":"Asa ka nagpuyo?","b":"Sa Lapu-Lapu."}
{"id":"ceb.g014","card":"ceb.c0046","a":"Siya si Ana, akong higala.","b":"Nalipay ko nga nakaila nimo, Ana."}
{"id":"ceb.g015","card":"ceb.c0051","a":"Unsay imong trabaho?","b":"Maestra ko sa usa ka eskuwelahan."}
{"id":"ceb.g016","card":"ceb.c0055","a":"Naa kay igsoon?","b":"Oo, duha: usa ka lalaki ug usa ka babaye."}
{"id":"ceb.g017","card":"ceb.c0061","a":"Kinsa siya?","b":"Akong asawa, si Rosa."}
{"id":"ceb.g018","card":"ceb.c0071","a":"Taga-asa mo?","b":"Taga-Amerika mi."}
{"id":"ceb.g019","card":"ceb.c0063","a":"Asa si Lola?","b":"Naa sa kusina, nagluto."}
{"id":"ceb.g020","card":"ceb.c0089","a":"Pila ka buok?","b":"Tulo lang."}
{"id":"ceb.g021","card":"ceb.c0081","a":"Pila ang kape?","b":"Baynte pesos."}
{"id":"ceb.g022","card":"ceb.c0087","a":"Pila imong anak?","b":"Duha akong anak, usa ka lalaki ug usa ka babaye."}
{"id":"ceb.g023","card":"ceb.c0090","a":"Mopalit ka og litson?","b":"Dili, wala koy kuwarta."}
{"id":"ceb.g024","card":"ceb.c0091","a":"Unsa nang orasa?","b":"Alas dos na."}
{"id":"ceb.g025","card":"ceb.c0100","a":"Moadto ka sa simbahan karon?","b":"Dili, ugma pa."}
{"id":"ceb.g026","card":"ceb.c0097","a":"Kanus-a ka moadto sa Bohol?","b":"Ugma sa buntag."}
{"id":"ceb.g027","card":"ceb.c0104","a":"Kanus-a ka mobalik?","b":"Sa Lunes."}
{"id":"ceb.g028","card":"ceb.c0102","a":"Mokaon na ta?","b":"Unya na lang, busog pa ko."}
{"id":"ceb.g029","card":"ceb.c0121","a":"Nang, unsa inyong naa?","b":"Naay manok, isda ug sabaw."}
{"id":"ceb.g030","card":"ceb.c0123","a":"Unsay imong kaonon?","b":"Sinugbang isda ug kan-on."}
{"id":"ceb.g031","card":"ceb.c0124","a":"Kumusta ang litson?","b":"Lami kaayo!"}
{"id":"ceb.g032","card":"ceb.c0125","a":"Kaon pa!","b":"Busog na ko, salamat."}
{"id":"ceb.g033","card":"ceb.c0122","a":"Unsay imong imnon?","b":"Tubig lang."}
{"id":"ceb.g034","card":"ceb.c0127","a":"Tagpila ang mangga, Nang?","b":"Kuwarenta pesos ang usa."}
{"id":"ceb.g035","card":"ceb.c0133","a":"Pwede pahangyo?","b":"Sige, traynta na lang."}
{"id":"ceb.g036","card":"ceb.c0130","a":"Pila tanan?","b":"Siyen pesos tanan."}
{"id":"ceb.g037","card":"ceb.c0136","a":"Unsa kana?","b":"Kini? Danggit ni, uga nga isda."}
{"id":"ceb.g038","card":"ceb.c0146","a":"Nindot ang inyong balay!","b":"Salamat! Lingkod usa."}
{"id":"ceb.g039","card":"ceb.c0154","a":"Naa bay tawo?","b":"Oo, kadiyot lang!"}
{"id":"ceb.g040","card":"ceb.c0157","a":"Naa ka sa balay?","b":"Wala, naa ko sa trabaho."}
{"id":"ceb.g041","card":"ceb.c0155","a":"Nganong init kaayo?","b":"Walay kuryente."}
{"id":"ceb.g042","card":"ceb.c0161","a":"Nang, asa ang kasilyas?","b":"Naa sa likod."}
{"id":"ceb.g043","card":"ceb.c0171","a":"Layo ba ang merkado?","b":"Dili, duol ra."}
{"id":"ceb.g044","card":"ceb.c0170","a":"Hain ang imong balay?","b":"Kadtong puti duol sa simbahan."}
{"id":"ceb.g045","card":"ceb.c0178","a":"Asa si Pedro?","b":"Naa siya sa gawas."}
{"id":"ceb.g046","card":"ceb.c0169","a":"Nong, asa ang tindahan?","b":"Naa sa kilid sa dalan, duol sa simbahan."}
{"id":"ceb.g047","card":"ceb.c0179","a":"Para, Nong!","b":"Sige."}
{"id":"ceb.g048","card":"ceb.c0186","a":"Nong, asa ni moagi?","b":"Moagi ni sa merkado."}
{"id":"ceb.g049","card":"ceb.c0188","a":"Nong, pila ang plete?","b":"Trese pesos."}
{"id":"ceb.g050","card":"ceb.c0194","a":"Asa ka paingon, Ana?","b":"Paingon ko sa Talisay."}
{"id":"ceb.g051","card":"ceb.c0185","a":"Lugar lang, Nong!","b":"Diri lang?"}
{"id":"ceb.g052","card":"ceb.c0203","a":"Asa ang masakit?","b":"Masakit akong tiyan."}
{"id":"ceb.g053","card":"ceb.c0210","a":"Nang, naa moy tambal sa ubo?","b":"Naa. Pila ka buok?"}
{"id":"ceb.g054","card":"ceb.c0204","a":"Kumusta ka?","b":"Dili maayo. Naa koy hilanat."}
{"id":"ceb.g055","card":"ceb.c0211","a":"Moadto ka ugma?","b":"Dili ko makaadto. Naa koy sip-on."}
{"id":"ceb.g056","card":"ceb.c0213","a":"Makasabot ka og Iningles?","b":"Oo, gamay ra."}
{"id":"ceb.g057","card":"ceb.c0220","a":"Kini o kana?","b":"Kini. Mas dako kini."}
{"id":"ceb.g058","card":"ceb.c0223","a":"Lahi ba kini?","b":"Dili, parehas ra."}
{"id":"ceb.g059","card":"ceb.c0231","a":"Lisod ba ang Binisaya?","b":"Oo, lisod kaayo!"}
{"id":"ceb.g060","card":"ceb.c0230","a":"Limpyo ba ang kasilyas?","b":"Dili, hugaw kaayo."}
{"id":"ceb.g061","card":"ceb.c0233","a":"Gigutom ko, Ma.","b":"Kaon na ta!"}
{"id":"ceb.g062","card":"ceb.c0239","a":"Gimingaw ko nimo.","b":"Ako sab!"}
{"id":"ceb.g063","card":"ceb.c0247","a":"Unsay imong gusto?","b":"Gusto ko og kape."}
{"id":"ceb.g064","card":"ceb.c0243","a":"Ganahan ka og durian?","b":"Dili ko ganahan."}
{"id":"ceb.g065","card":"ceb.c0235","a":"Kumusta ang trabaho?","b":"Kapoy kaayo ko."}
{"id":"ceb.g066","card":"ceb.c0252","a":"Kinsa siya?","b":"Si Maria, akong igsoon."}
{"id":"ceb.g067","card":"ceb.c0256","a":"Kanus-a ka mobalik?","b":"Mobalik ko ugma."}
{"id":"ceb.g068","card":"ceb.c0260","a":"Amerikano ka ba?","b":"Oo, Taga-Amerika ko."}
{"id":"ceb.g069","card":"ceb.c0254","a":"Dili ko moadto.","b":"Ngano?"}
{"id":"ceb.g070","card":"ceb.c0259","a":"Nong, unsaon pag-adto sa merkado?","b":"Diretso lang, dayon liko sa wala."}
{"id":"ceb.g071","card":"ceb.c0269","a":"Nikaon na ka?","b":"Oo, nikaon na ko."}
{"id":"ceb.g072","card":"ceb.c0272","a":"Makaadto ka ugma?","b":"Oo, makaadto ko."}
{"id":"ceb.g073","card":"ceb.c0283","a":"Nakaadto na ka sa Bohol?","b":"Wala pa."}
{"id":"ceb.g074","card":"ceb.c0282","a":"Lami kaayo! Kinsay naghimo niini?","b":"Gihimo nako."}
{"id":"ceb.g075","card":"ceb.c0284","a":"Kaon na ta!","b":"Sige, gigutom na ko."}
{"id":"ceb.g076","card":"ceb.c0294","a":"Asa ka gikan?","b":"Gikan ko sa merkado."}
{"id":"ceb.g077","card":"ceb.c0286","a":"Libre nako ang kape.","b":"Salamat kaayo!"}
{"id":"ceb.g078","card":"ceb.c0293","a":"Gusto ka og kape?","b":"Dili, salamat."}
{"id":"ceb.g079","card":"ceb.c0298","a":"Naa bay tubig?","b":"Wala, walay tubig karon."}
{"id":"ceb.g080","card":"ceb.c0299","a":"Niadto ka sa simbahan gahapon?","b":"Wala ko moadto."}
{"id":"ceb.g081","card":"ceb.c0295","a":"Pila na ang imong edad?","b":"Baynte singko anyos na ko."}
{"id":"ceb.g082","card":"ceb.c0291","a":"Mokaon na ta?","b":"Unya na lang. Busog pa ko."}
{"id":"ceb.g083","card":"ceb.c0303","a":"Taga-Bohol si Ana.","b":"Diay? Wa ko kahibalo."}
{"id":"ceb.g084","card":"ceb.c0306","a":"Asa si Pedro?","b":"Ambot."}
{"id":"ceb.g085","card":"ceb.c0314","a":"Naay saging, Nang?","b":"Wala na."}
{"id":"ceb.g086","card":"ceb.c0313","a":"Unsay balita, Lito?","b":"Maayo man."}
{"id":"ceb.g087","card":"ceb.c0312","a":"Kinsa to?","b":"Akong higala."}
{"id":"ceb.g088","card":"ceb.c0315","a":"Salamat kaayo, Ben!","b":"Walay problema."}
{"id":"ceb.g089","card":"ceb.c0777","a":"Lami kaayo ang imong luto, Nang!","b":"Salamat! Kaon pa."}
{"id":"ceb.g090","card":"ceb.c0783","a":"Maayo kaayo ang imong trabaho, Nong.","b":"Salamat kaayo."}
{"id":"ceb.g091","card":"ceb.c0791","a":"Kyut kaayo ang imong anak!","b":"Salamat! Duha na ka tuig siya."}
{"id":"ceb.g092","card":"ceb.c0793","a":"Limpyo kaayo ang inyong balay.","b":"Ay, salamat! Dayon lang."}
{"id":"ceb.g093","card":"ceb.c0797","a":"Kahibalo diay ka mag-Bisaya!","b":"Salamat, nagtuon pa ko."}
{"id":"ceb.g094","card":"ceb.c0798","a":"Maayo na kaayo ka mag-Bisaya!","b":"Tinuod? Salamat!"}
{"id":"ceb.g095","card":"ceb.c0796","a":"Nindot kaayo ka mokanta.","b":"Dili ra kaayo."}
{"id":"ceb.g096","card":"ceb.c0786","a":"Buotan kaayo ka, salamat sa tabang.","b":"Walay sapayan."}
{"id":"ceb.g097","card":"ceb.c0789","a":"Nindot ang imong sinina.","b":"Salamat, ikaw pod."}
{"id":"ceb.g098","card":"ceb.c0823","a":"Gwapo kaayo ka karon.","b":"Tinuod? Salamat!"}
{"id":"ceb.g099","card":"ceb.c0825","a":"Gwapa kaayo ka karong gabii.","b":"Ay sus, salamat."}
{"id":"ceb.g100","card":"ceb.c0828","a":"Kyut kaayo ang imong pahiyom.","b":"Swit kaayo ka."}
{"id":"ceb.g101","card":"ceb.c0831","a":"Kataw-anan kaayo ka!","b":"Salamat, ikaw sab."}
{"id":"ceb.g102","card":"ceb.c0837","a":"Nindot kaayo ang imong tingog.","b":"Salamat! Ganahan ko mokanta."}
{"id":"ceb.g103","card":"ceb.c0838","a":"Nindot ang imong porma.","b":"Salamat, bag-o ni nga sinina."}
{"id":"ceb.g104","card":"ceb.c0839","a":"Bagay kaayo nimo ang pula.","b":"Tinuod? Salamat."}
{"id":"ceb.g105","card":"ceb.c0840","a":"Ganahan ko makig-istorya nimo.","b":"Ako sab. Lingaw kaayo ka."}
{"id":"ceb.g106","card":"ceb.c0842","a":"Libre ka sa Sabado?","b":"Oo, ngano man?"}
{"id":"ceb.g107","card":"ceb.c0843","a":"Kape ta usahay?","b":"Sige, ganahan ko ana."}
{"id":"ceb.g108","card":"ceb.c0844","a":"Pwede nako makuha ang imong numero?","b":"Sige, ania."}
{"id":"ceb.g109","card":"ceb.c0845","a":"Naa ka bay uyab?","b":"Wala pa. Ngano man?"}
{"id":"ceb.g110","card":"ceb.c0846","a":"Gusto ko nga magkita ta pag-usab.","b":"Oo, magkita ta sa Sabado."}
{"id":"ceb.g111","card":"ceb.c0848","a":"Ganahan ko nimo.","b":"Salamat, pero naa na koy uyab."}
{"id":"ceb.g112","card":"ceb.c0847","a":"Pirmi tika hunahunaon.","b":"Bolero ka gyud!"}
{"id":"ceb.g113","card":"ceb.c0830","a":"Lingaw kaayo ko karong gabii.","b":"Ako sab. Kape ta pag-usab?"}
{"id":"ceb.g114","card":"ceb.c0832","a":"Si Ana? Gwapa na, utokan pa!","b":"Mao ba? Gusto ko makaila niya!"}
{"id":"ceb.g115","card":"ceb.c0855","a":"Gusto ka mokuyog nako sa Sabado?","b":"Salamat, pero dili pa ko andam."}
{"id":"ceb.g116","card":"ceb.c0854","a":"Ganahan ko nimo, Ana.","b":"Pasensya, higala ra gyud tika."}
{"id":"ceb.g117","card":"ceb.c0690","a":"Ay! Mahal kaayo!","b":"Barato ra ni."}
{"id":"ceb.g118","card":"ceb.c0691","a":"Aray! Masakit akong tiil.","b":"Lingkod usa."}
{"id":"ceb.g119","card":"ceb.c0692","a":"Agoy! Init kaayo ang kape.","b":"Hinay-hinay lang."}
{"id":"ceb.g120","card":"ceb.c0693","a":"Uy! Kumusta ka?","b":"Maayo man. Ikaw?"}
{"id":"ceb.g121","card":"ceb.c0694","a":"Hoy! Ayaw diha!","b":"Pasensya na."}
{"id":"ceb.g122","card":"ceb.c0695","a":"Gwapa kaayo ka.","b":"Ay sus! Bolero!"}
{"id":"ceb.g123","card":"ceb.c0696","a":"Kini ang among balay.","b":"Wow! Dako kaayo!"}
{"id":"ceb.g124","card":"ceb.c0697","a":"Duha ka oras sa dyip.","b":"Grabe! Kapoy kaayo!"}
{"id":"ceb.g125","card":"ceb.c0698","a":"Nakaadto ko sa bukid sa habal-habal.","b":"Kuyaw!"}
{"id":"ceb.g126","card":"ceb.c0699","a":"Nakalimtan nako ang yawe.","b":"Hala ka!"}
{"id":"ceb.g127","card":"ceb.c0700","a":"Alas tres ang barko.","b":"Ha? Alas tres?"}
{"id":"ceb.g128","card":"ceb.c0701","a":"Niabot na ang dyip.","b":"Hay salamat!"}
{"id":"ceb.g129","card":"ceb.c0702","a":"Sori, ulahi ko!","b":"Okay ra."}
{"id":"ceb.g130","card":"ceb.c0703","a":"Mokaon ta alas sais?","b":"Okay!"}
{"id":"ceb.g131","card":"ceb.c0704","a":"Moadto ta sa dagat ugma.","b":"Yehey!"}
{"id":"ceb.g132","card":"ceb.c0705","a":"Dali! Naa na ang dyip!","b":"Kadiyot lang!"}
{"id":"ceb.g133","card":"ceb.c0706","a":"Bantay! Naay motor!","b":"Salamat!"}
{"id":"ceb.g134","card":"ceb.c0707","a":"Una na ko.","b":"Sige, ayo-ayo!"}
{"id":"ceb.g135","card":"ceb.c0708","a":"Asa ang akong selpon?","b":"Ania! Naa sa lamesa."}
{"id":"ceb.g136","card":"ceb.c0709","a":"Sulayi ang litson.","b":"Kalami!"}
{"id":"ceb.g137","card":"ceb.c0710","a":"Wala na koy kuwarta.","b":"Pastilan! Ngano man?"}
{"id":"ceb.g138","card":"ceb.c0711","a":"Tan-awa! Ang barko!","b":"Dako kaayo!"}
{"id":"ceb.g139","card":"ceb.c0712","a":"Taga-Bohol ang akong asawa.","b":"Mao ba? Ako sab!"}
