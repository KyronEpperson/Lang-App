{"id":"ceb.e001","card":"ceb.c0003","ceb":"Maayo kaayo imong Bisaya!"}
{"id":"ceb.e002","card":"ceb.c0009","ceb":"Mopalit ko og duha ka itlog sa tindahan."}
{"id":"ceb.e003","card":"ceb.c0017","ceb":"Ganahan ko og kape sa buntag."}
{"id":"ceb.e004","card":"ceb.c0022","ceb":"Maayong gabii sa inyong tanan."}
{"id":"ceb.e005","card":"ceb.c0036","ceb":"Amping ka sa imong biyahe."}
{"id":"ceb.e006","card":"ceb.c0029","ceb":"Maayong pag-abot sa Cebu!"}
{"id":"ceb.e007","card":"ceb.c0047","ceb":"Traynta anyos ko, ug minyo na ko."}
{"id":"ceb.e008","card":"ceb.c0054","ceb":"Nagtuon ko og Bisaya kay taga-Cebu akong asawa."}
{"id":"ceb.e009","card":"ceb.c0072","ceb":"Mga higala nako sila gikan sa trabaho."}
{"id":"ceb.e010","card":"ceb.c0066","ceb":"Nagpuyo sa Bohol ang akong manghod."}
{"id":"ceb.e011","card":"ceb.c0058","ceb":"Taga-Amerika ang akong ginikanan."}
{"id":"ceb.e012","card":"ceb.c0073","ceb":"Mokaon ko og usa ka saging matag buntag."}
{"id":"ceb.e013","card":"ceb.c0074","ceb":"Duha ka adlaw lang mi sa Bohol."}
{"id":"ceb.e014","card":"ceb.c0085","ceb":"Siyen pesos ra ang usa ka kilo."}
{"id":"ceb.e015","card":"ceb.c0094","ceb":"Moabot ang barko alas tres sa hapon."}
{"id":"ceb.e016","card":"ceb.c0101","ceb":"Nikaon mi og litson gahapon."}
{"id":"ceb.e017","card":"ceb.c0105","ceb":"Moadto mi sa Bohol sa Sabado."}
{"id":"ceb.e018","card":"ceb.c0109","ceb":"Duha ka kan-on ug usa ka sabaw, palihug."}
{"id":"ceb.e019","card":"ceb.c0118","ceb":"Ganahan ko og puso ug manok."}
{"id":"ceb.e020","card":"ceb.c0126","ceb":"Pasensya, dili ko mokaon og baboy."}
{"id":"ceb.e021","card":"ceb.c0131","ceb":"Mahal kaayo ang mangga karon."}
{"id":"ceb.e022","card":"ceb.c0140","ceb":"Nang, naa ba moy bugas ug itlog?"}
{"id":"ceb.e023","card":"ceb.c0141","ceb":"Nindot kaayo ni. Kuhaon nako ni."}
{"id":"ceb.e024","card":"ceb.c0147","ceb":"Dako ang balay ni Pedro."}
{"id":"ceb.e025","card":"ceb.c0159","ceb":"Gabii na, matulog na ta."}
{"id":"ceb.e026","card":"ceb.c0158","ceb":"Gabii na. Mopauli na ko."}
{"id":"ceb.e027","card":"ceb.c0166","ceb":"Mopalit ko og isda sa merkado."}
{"id":"ceb.e028","card":"ceb.c0165","ceb":"Nagpuyo ko dinhi sa Cebu."}
{"id":"ceb.e029","card":"ceb.c0175","ceb":"Naa ang iro sa likod sa balay."}
{"id":"ceb.e030","card":"ceb.c0182","ceb":"Diretso lang, dayon liko sa tuo."}
{"id":"ceb.e031","card":"ceb.c0190","ceb":"Nisakay mi og habal-habal paingon sa bukid."}
{"id":"ceb.e032","card":"ceb.c0196","ceb":"Hinay-hinay lang, Nong, kay nag-ulan."}
{"id":"ceb.e033","card":"ceb.c0214","ceb":"Ayaw kabalaka, maayo na ko."}
{"id":"ceb.e034","card":"ceb.c0206","ceb":"Palihug, kinahanglan ko og doktor karon."}
{"id":"ceb.e035","card":"ceb.c0208","ceb":"Mopalit ko og tambal sa botika."}
{"id":"ceb.e036","card":"ceb.c0215","ceb":"Naa silay dakong balay sa Talisay."}
{"id":"ceb.e037","card":"ceb.c0226","ceb":"Gusto ko og bugnaw nga tubig."}
{"id":"ceb.e038","card":"ceb.c0225","ceb":"Gwapo si Ben, ug taas siya."}
{"id":"ceb.e039","card":"ceb.c0244","ceb":"Gusto ko og kape ug pan."}
{"id":"ceb.e040","card":"ceb.c0245","ceb":"Gusto ko moadto sa Bohol."}
{"id":"ceb.e041","card":"ceb.c0238","ceb":"Nahadlok ko sa iro."}
{"id":"ceb.e042","card":"ceb.c0263","ceb":"Dili ko mokaon kay busog pa ko."}
{"id":"ceb.e043","card":"ceb.c0267","ceb":"Mokaon ta sa karinderya kung gusto nimo."}
{"id":"ceb.e044","card":"ceb.c0265","ceb":"Gamay ra ang balay, pero limpyo."}
{"id":"ceb.e045","card":"ceb.c0270","ceb":"Nagluto siya og adobo sa kusina."}
{"id":"ceb.e046","card":"ceb.c0275","ceb":"Moadto ko sa merkado ugma sa buntag."}
{"id":"ceb.e047","card":"ceb.c0281","ceb":"Kaonon nako ang mangga unya."}
{"id":"ceb.e048","card":"ceb.c0300","ceb":"Dili ko moadto ugma kay naa koy trabaho."}
{"id":"ceb.e049","card":"ceb.c0296","ceb":"Ganahan ko og kape, pero dili ko ganahan og gatas."}
{"id":"ceb.e050","card":"ceb.c0285","ceb":"Kini nga pan para nimo."}
{"id":"ceb.e051","card":"ceb.c0304","ceb":"Lami gyud ang litson sa Cebu."}
{"id":"ceb.e052","card":"ceb.c0317","ceb":"Sige, magkita ta ugma."}
{"id":"ceb.e053","card":"ceb.c0780","ceb":"Maayo kaayo! Nakasabot na ka."}
{"id":"ceb.e054","card":"ceb.c0781","ceb":"Hanas kaayo ka mag-Bisaya!"}
{"id":"ceb.e055","card":"ceb.c0790","ceb":"Bag-o imong buhok? Bagay kaayo nimo!"}
{"id":"ceb.e056","card":"ceb.c0800","ceb":"Maayo ka mag-Bisaya! Dili ra kaayo."}
{"id":"ceb.e057","card":"ceb.c0806","ceb":"Gwapo kaayo ang imong manghod."}
{"id":"ceb.e058","card":"ceb.c0808","ceb":"Kyut kaayo ang iring."}
{"id":"ceb.e059","card":"ceb.c0810","ceb":"Lingaw kaayo ang Sabado."}
{"id":"ceb.e060","card":"ceb.c0812","ceb":"Utokan kaayo ang akong maestra."}
{"id":"ceb.e061","card":"ceb.c0813","ceb":"Salamat, palangga."}
{"id":"ceb.e062","card":"ceb.c0816","ceb":"Ganahan ko sa iyang pahiyom."}
{"id":"ceb.e063","card":"ceb.c0817","ceb":"Itom ang iyang mata."}
{"id":"ceb.e064","card":"ceb.c0818","ceb":"Nindot ang tingog sa iyang inahan."}
{"id":"ceb.e065","card":"ceb.c0820","ceb":"Nindot kaayo ang porma ni Pedro karon."}
{"id":"ceb.e066","card":"ceb.c0821","ceb":"Naa na koy uyab."}
{"id":"ceb.e067","card":"ceb.c0320","ceb":"Init kaayo ang adlaw karon."}
{"id":"ceb.e068","card":"ceb.c0326","ceb":"Asa ang imong trabaho?"}
{"id":"ceb.e069","card":"ceb.c0328","ceb":"Layo ba ang dalan paingon sa merkado?"}
{"id":"ceb.e070","card":"ceb.c0347","ceb":"Mopalit ko og saging sa merkado."}
{"id":"ceb.e071","card":"ceb.c0359","ceb":"Hugasi ang imong kamot."}
{"id":"ceb.e072","card":"ceb.c0382","ceb":"Asa man ang akong selpon?"}
{"id":"ceb.e073","card":"ceb.c0393","ceb":"Kusog kaayo ang ulan gahapon."}
{"id":"ceb.e074","card":"ceb.c0410","ceb":"Moadto ko sa simbahan ugma."}
{"id":"ceb.e075","card":"ceb.c0411","ceb":"Nikaon na ka?"}
{"id":"ceb.e076","card":"ceb.c0412","ceb":"Kahibalo ka asa ang botika?"}
{"id":"ceb.e077","card":"ceb.c0413","ceb":"Gusto ko og bugnaw nga tubig."}
{"id":"ceb.e078","card":"ceb.c0414","ceb":"Niingon siya nga moabot siya unya."}
{"id":"ceb.e079","card":"ceb.c0415","ceb":"Kinsa ang nihimo ani?"}
{"id":"ceb.e080","card":"ceb.c0416","ceb":"Nipalit ko og isda ganina."}
{"id":"ceb.e081","card":"ceb.c0417","ceb":"Kuhaon nako ang dako."}
{"id":"ceb.e082","card":"ceb.c0418","ceb":"Gihatagan ko niya og mangga."}
{"id":"ceb.e083","card":"ceb.c0419","ceb":"Motan-aw ko sa mga bata."}
{"id":"ceb.e084","card":"ceb.c0420","ceb":"Moinom ko og kape sa buntag."}
{"id":"ceb.e085","card":"ceb.c0421","ceb":"Mobalik ko sa Lunes."}
{"id":"ceb.e086","card":"ceb.c0422","ceb":"Ganahan ko og sikwate."}
{"id":"ceb.e087","card":"ceb.c0423","ceb":"Kinahanglan ko og tubig."}
{"id":"ceb.e088","card":"ceb.c0424","ceb":"Mosulti ko sa akong inahan."}
{"id":"ceb.e089","card":"ceb.c0425","ceb":"Makasabot ko og gamay nga Bisaya."}
{"id":"ceb.e090","card":"ceb.c0426","ceb":"Nagpuyo mi sa Talisay."}
{"id":"ceb.e091","card":"ceb.c0427","ceb":"Nagtuon ko og Bisaya matag adlaw."}
{"id":"ceb.e092","card":"ceb.c0428","ceb":"Unsay imong gibuhat gahapon?"}
{"id":"ceb.e093","card":"ceb.c0429","ceb":"Nidala siya og pan."}
{"id":"ceb.e094","card":"ceb.c0430","ceb":"Nagluto si Mama og sabaw."}
{"id":"ceb.e095","card":"ceb.c0431","ceb":"Natulog ko sayo gabii."}
{"id":"ceb.e096","card":"ceb.c0432","ceb":"Molakaw na ko."}
{"id":"ceb.e097","card":"ceb.c0433","ceb":"Mouli ko sa balay alas singko."}
{"id":"ceb.e098","card":"ceb.c0434","ceb":"Niabot na ang dyip."}
{"id":"ceb.e099","card":"ceb.c0435","ceb":"Mobiya ang barko alas otso."}
{"id":"ceb.e100","card":"ceb.c0436","ceb":"Moanhi ang akong higala ugma."}
{"id":"ceb.e101","card":"ceb.c0437","ceb":"Mosakay ko og dyip paingon sa lungsod."}
{"id":"ceb.e102","card":"ceb.c0438","ceb":"Monaog ko diri, Nong."}
{"id":"ceb.e103","card":"ceb.c0439","ceb":"Palihug hulat kadiyot."}
{"id":"ceb.e104","card":"ceb.c0440","ceb":"Naa koy pangutana, Nang."}
{"id":"ceb.e105","card":"ceb.c0442","ceb":"Tawagan tika unya."}
{"id":"ceb.e106","card":"ceb.c0445","ceb":"Paminaw sa imong maestra."}
{"id":"ceb.e107","card":"ceb.c0447","ceb":"Nahinumdom ka sa iyang ngalan?"}
{"id":"ceb.e108","card":"ceb.c0448","ceb":"Dali ra ko makalimot."}
{"id":"ceb.e109","card":"ceb.c0449","ceb":"Nagbasa ko og libro."}
{"id":"ceb.e110","card":"ceb.c0452","ceb":"Molingkod ko diri."}
{"id":"ceb.e111","card":"ceb.c0456","ceb":"Maligo sa ko."}
{"id":"ceb.e112","card":"ceb.c0457","ceb":"Nagdula ang mga bata sa gawas."}
{"id":"ceb.e113","card":"ceb.c0461","ceb":"Mosugod ang trabaho alas otso."}
{"id":"ceb.e114","card":"ceb.c0462","ceb":"Nihunong na ang ulan."}
{"id":"ceb.e115","card":"ceb.c0464","ceb":"Mosuroy mi sa Bohol."}
{"id":"ceb.e116","card":"ceb.c0467","ceb":"Ablihi ang bintana, palihug."}
{"id":"ceb.e117","card":"ceb.c0472","ceb":"Unsay imong pangitaon?"}
{"id":"ceb.e118","card":"ceb.c0475","ceb":"Sulayi ni, lami kaayo."}
{"id":"ceb.e119","card":"ceb.c0477","ceb":"Mohatod ko nimo sa balay."}
{"id":"ceb.e120","card":"ceb.c0491","ceb":"Dako kaayo ang ilang balay."}
{"id":"ceb.e121","card":"ceb.c0492","ceb":"Nindot kaayo ang dagat diri."}
{"id":"ceb.e122","card":"ceb.c0493","ceb":"Lami kaayo ang litson."}
{"id":"ceb.e123","card":"ceb.c0495","ceb":"Lain ang lami sa sabaw."}
{"id":"ceb.e124","card":"ceb.c0496","ceb":"Taas kaayo ang iyang buhok."}
{"id":"ceb.e125","card":"ceb.c0498","ceb":"Init pa ang kape."}
{"id":"ceb.e126","card":"ceb.c0499","ceb":"Gusto ko og bugnaw nga tubig."}
{"id":"ceb.e127","card":"ceb.c0501","ceb":"Mahal kaayo ang plete."}
{"id":"ceb.e128","card":"ceb.c0503","ceb":"Layo ra ba ang merkado?"}
{"id":"ceb.e129","card":"ceb.c0504","ceb":"Lisod ang Bisaya, pero nindot."}
{"id":"ceb.e130","card":"ceb.c0505","ceb":"Sayon ra ang pangutana."}
{"id":"ceb.e131","card":"ceb.c0506","ceb":"Limpyo na ang kuwarto."}
{"id":"ceb.e132","card":"ceb.c0508","ceb":"Tigulang na ang akong lolo."}
{"id":"ceb.e133","card":"ceb.c0509","ceb":"Batan-on pa ang iyang inahan."}
{"id":"ceb.e134","card":"ceb.c0510","ceb":"Buotan kaayo ang imong anak."}
{"id":"ceb.e135","card":"ceb.c0511","ceb":"Paspas kaayo ang habal-habal."}
{"id":"ceb.e136","card":"ceb.c0518","ceb":"Busog pa ko, salamat."}
{"id":"ceb.e137","card":"ceb.c0521","ceb":"Kapoy kaayo ang trabaho karon."}
{"id":"ceb.e138","card":"ceb.c0525","ceb":"Andam na ka?"}
{"id":"ceb.e139","card":"ceb.c0526","ceb":"Lahi ang sabaw sa Bohol."}
{"id":"ceb.e140","card":"ceb.c0528","ceb":"Tinuod ba nga taga-Cebu ka?"}
{"id":"ceb.e141","card":"ceb.c0529","ceb":"Sakto ang imong tubag."}
{"id":"ceb.e142","card":"ceb.c0530","ceb":"Sayop ang akong pangutana."}
{"id":"ceb.e143","card":"ceb.c0531","ceb":"Bug-at kaayo ang imong bag."}
{"id":"ceb.e144","card":"ceb.c0539","ceb":"Halang ba ang sud-an?"}
{"id":"ceb.e145","card":"ceb.c0541","ceb":"Hilom kaayo ang balay karong gabii."}
{"id":"ceb.e146","card":"ceb.c0546","ceb":"Presko ang hangin sa bukid."}
{"id":"ceb.e147","card":"ceb.c0547","ceb":"Hinog na ang mangga."}
{"id":"ceb.e148","card":"ceb.c0549","ceb":"Importante kaayo ang tubig."}
{"id":"ceb.e149","card":"ceb.c0500","ceb":"Tugnaw kaayo sa bukid."}
{"id":"ceb.e150","card":"ceb.c0502","ceb":"Barato ra ang mangga karon."}
{"id":"ceb.e151","card":"ceb.c0507","ceb":"Hugaw ang akong sinina."}
{"id":"ceb.e152","card":"ceb.c0512","ceb":"Puti ang ilang balay."}
{"id":"ceb.e153","card":"ceb.c0553","ceb":"Kanunay ko mokaon og isda."}
{"id":"ceb.e154","card":"ceb.c0554","ceb":"Pirmi siyang ulahi."}
{"id":"ceb.e155","card":"ceb.c0555","ceb":"Usahay moadto mi sa dagat."}
{"id":"ceb.e156","card":"ceb.c0556","ceb":"Moadto ko dayon."}
{"id":"ceb.e157","card":"ceb.c0557","ceb":"Hinay ra ang dyip karon."}
{"id":"ceb.e158","card":"ceb.c0558","ceb":"Nimata ko sayo karong adlawa."}
{"id":"ceb.e159","card":"ceb.c0559","ceb":"Pasensya, ulahi ko."}
{"id":"ceb.e160","card":"ceb.c0560","ceb":"Dugay na ka diri sa Cebu?"}
{"id":"ceb.e161","card":"ceb.c0561","ceb":"Gigutom gihapon ko."}
{"id":"ceb.e162","card":"ceb.c0563","ceb":"Moadto ko pag-usab ugma."}
{"id":"ceb.e163","card":"ceb.c0564","ceb":"Tingali moulan unya."}
{"id":"ceb.e164","card":"ceb.c0565","ceb":"Basin moulan karon."}
{"id":"ceb.e165","card":"ceb.c0566","ceb":"Siguro naa siya sa balay."}
{"id":"ceb.e166","card":"ceb.c0568","ceb":"Sobra ka init karon!"}
{"id":"ceb.e167","card":"ceb.c0569","ceb":"Hapit na ta."}
{"id":"ceb.e168","card":"ceb.c0570","ceb":"Medyo layo ang ospital."}
{"id":"ceb.e169","card":"ceb.c0574","ceb":"Ngari ka, Dong!"}
{"id":"ceb.e170","card":"ceb.c0575","ceb":"Kaniadto, nagpuyo ko sa Bohol."}
{"id":"ceb.e171","card":"ceb.c0579","ceb":"Kadiyot lang, Nang."}
{"id":"ceb.e172","card":"ceb.c0583","ceb":"Moadto mi sa merkado karong gabii."}
{"id":"ceb.e173","card":"ceb.c0584","ceb":"Ako ang maestra."}
{"id":"ceb.e174","card":"ceb.c0585","ceb":"Gigutom na ko."}
{"id":"ceb.e175","card":"ceb.c0586","ceb":"Ikaw ba si Pedro?"}
{"id":"ceb.e176","card":"ceb.c0587","ceb":"Taga-asa ka?"}
{"id":"ceb.e177","card":"ceb.c0588","ceb":"Siya ang akong manghod."}
{"id":"ceb.e178","card":"ceb.c0589","ceb":"Kami ang taga-Amerika."}
{"id":"ceb.e179","card":"ceb.c0590","ceb":"Nagpuyo mi sa Talisay."}
{"id":"ceb.e180","card":"ceb.c0591","ceb":"Kita ang mopalit og pan."}
{"id":"ceb.e181","card":"ceb.c0592","ceb":"Kaon na ta!"}
{"id":"ceb.e182","card":"ceb.c0593","ceb":"Kamo ba ang mga estudyante?"}
{"id":"ceb.e183","card":"ceb.c0594","ceb":"Taga-asa mo?"}
{"id":"ceb.e184","card":"ceb.c0595","ceb":"Sila ang akong ginikanan."}
{"id":"ceb.e185","card":"ceb.c0596","ceb":"Kuhaon nako ni."}
{"id":"ceb.e186","card":"ceb.c0597","ceb":"Unsa ang ngalan nimo?"}
{"id":"ceb.e187","card":"ceb.c0598","ceb":"Gipalit niya ang mangga."}
{"id":"ceb.e188","card":"ceb.c0599","ceb":"Gihimo namo kini."}
{"id":"ceb.e189","card":"ceb.c0600","ceb":"Paliton nato ang isda."}
{"id":"ceb.e190","card":"ceb.c0601","ceb":"Kinsa ang inahan ninyo?"}
{"id":"ceb.e191","card":"ceb.c0602","ceb":"Gikaon nila ang tanan."}
{"id":"ceb.e192","card":"ceb.c0603","ceb":"Si Ana ang akong higala."}
{"id":"ceb.e193","card":"ceb.c0604","ceb":"Asa ang imong balay?"}
{"id":"ceb.e194","card":"ceb.c0605","ceb":"Maestra ang iyang inahan."}
{"id":"ceb.e195","card":"ceb.c0606","ceb":"Gamay ra ang among balay."}
{"id":"ceb.e196","card":"ceb.c0607","ceb":"Naa na ang atong dyip!"}
{"id":"ceb.e197","card":"ceb.c0608","ceb":"Nindot ang inyong kusina."}
{"id":"ceb.e198","card":"ceb.c0609","ceb":"Duha ang ilang anak."}
{"id":"ceb.e199","card":"ceb.c0610","ceb":"Ihatag kanako ang libro."}
{"id":"ceb.e200","card":"ceb.c0611","ceb":"Para kanimo kini."}
{"id":"ceb.e201","card":"ceb.c0612","ceb":"Ihatag kaniya ang kape."}
{"id":"ceb.e202","card":"ceb.c0613","ceb":"Mobisita sila kanamo ugma."}
{"id":"ceb.e203","card":"ceb.c0614","ceb":"Para kanato ang litson!"}
{"id":"ceb.e204","card":"ceb.c0615","ceb":"Salamat kaninyo tanan."}
{"id":"ceb.e205","card":"ceb.c0616","ceb":"Ihatag kanila ang kuwarta."}
{"id":"ceb.e206","card":"ceb.c0617","ceb":"Akoa kanang bag."}
{"id":"ceb.e207","card":"ceb.c0618","ceb":"Imoha ba kining selpon?"}
{"id":"ceb.e208","card":"ceb.c0619","ceb":"Iyaha ang pula."}
{"id":"ceb.e209","card":"ceb.c0620","ceb":"Akong anak kini."}
{"id":"ceb.e210","card":"ceb.c0621","ceb":"Unsa kana?"}
{"id":"ceb.e211","card":"ceb.c0622","ceb":"Kadto ang among balay."}
{"id":"ceb.e212","card":"ceb.c0623","ceb":"Ganahan ko niini."}
{"id":"ceb.e213","card":"ceb.c0624","ceb":"Mas dako kini kaysa niana."}
{"id":"ceb.e214","card":"ceb.c0625","ceb":"Ganahan ko niadtong pula."}
{"id":"ceb.e215","card":"ceb.c0626","ceb":"Kinsa ang imong maestra?"}
{"id":"ceb.e216","card":"ceb.c0627","ceb":"Unsa ang imong gusto?"}
{"id":"ceb.e217","card":"ceb.c0628","ceb":"Salamat sa tanan."}
{"id":"ceb.e218","card":"ceb.c0629","ceb":"Asa ang uban?"}
{"id":"ceb.e219","card":"ceb.c0630","ceb":"Pwede ang bisan kinsa."}
{"id":"ceb.e220","card":"ceb.c0631","ceb":"Bisan unsa lang, salamat."}
{"id":"ceb.e221","card":"ceb.c0632","ceb":"Lami ang sabaw."}
{"id":"ceb.e222","card":"ceb.c0633","ceb":"Naa ko sa merkado."}
{"id":"ceb.e223","card":"ceb.c0634","ceb":"Mopalit ko og tubig."}
{"id":"ceb.e224","card":"ceb.c0635","ceb":"Asa si Pedro?"}
{"id":"ceb.e225","card":"ceb.c0636","ceb":"Kini ang balay ni Ana."}
{"id":"ceb.e226","card":"ceb.c0637","ceb":"Ihatag kang Pedro ang libro."}
{"id":"ceb.e227","card":"ceb.c0638","ceb":"Gusto ko og gamay nga kape."}
{"id":"ceb.e228","card":"ceb.c0639","ceb":"Busog na ko."}
{"id":"ceb.e229","card":"ceb.c0640","ceb":"Wala pa ko kakaon."}
{"id":"ceb.e230","card":"ceb.c0641","ceb":"Usa lang, Nang."}
{"id":"ceb.e231","card":"ceb.c0642","ceb":"Duol ra ang simbahan."}
{"id":"ceb.e232","card":"ceb.c0643","ceb":"Maayo man ko."}
{"id":"ceb.e233","card":"ceb.c0644","ceb":"Init ba ang kape?"}
{"id":"ceb.e234","card":"ceb.c0645","ceb":"Gigutom sab ko."}
{"id":"ceb.e235","card":"ceb.c0646","ceb":"Ganahan ko pod."}
{"id":"ceb.e236","card":"ceb.c0647","ceb":"Lami kaayo!"}
{"id":"ceb.e237","card":"ceb.c0648","ceb":"Moabot unta siya karon."}
{"id":"ceb.e238","card":"ceb.c0649","ceb":"Moulan kuno ugma."}
{"id":"ceb.e239","card":"ceb.c0651","ceb":"Wala gani ko kahibalo sa iyang ngalan."}
{"id":"ceb.e240","card":"ceb.c0654","ceb":"Gikan ko sa merkado."}
{"id":"ceb.e241","card":"ceb.c0655","ceb":"Naa ko diri hangtod ugma."}
{"id":"ceb.e242","card":"ceb.c0656","ceb":"Wala ko moadto tungod sa ulan."}
{"id":"ceb.e243","card":"ceb.c0659","ceb":"Naa sa ibabaw sa lamesa ang yawe."}
{"id":"ceb.e244","card":"ceb.c0660","ceb":"Naa ang iring sa ilalom sa higdaanan."}
{"id":"ceb.e245","card":"ceb.c0661","ceb":"Naa sa sulod sa bag."}
{"id":"ceb.e246","card":"ceb.c0663","ceb":"Naa ang botika sa tupad sa simbahan."}
{"id":"ceb.e247","card":"ceb.c0669","ceb":"Naa sa taliwala sa duha ka tindahan."}
{"id":"ceb.e248","card":"ceb.c0671","ceb":"Naa si Mama sa ubos."}
{"id":"ceb.e249","card":"ceb.c0673","ceb":"Kape ug pan, palihug."}
{"id":"ceb.e250","card":"ceb.c0674","ceb":"Kape o tubig?"}
{"id":"ceb.e251","card":"ceb.c0675","ceb":"Kon moulan, dili ko moadto."}
{"id":"ceb.e252","card":"ceb.c0677","ceb":"Gigutom ko, mao nga mokaon ko."}
{"id":"ceb.e253","card":"ceb.c0678","ceb":"Nagtuon ko aron makasabot ko."}
{"id":"ceb.e254","card":"ceb.c0679","ceb":"Nagtan-aw ko samtang nagluto si Mama."}
{"id":"ceb.e255","card":"ceb.c0680","ceb":"Mouli ko human sa trabaho."}
{"id":"ceb.e256","card":"ceb.c0681","ceb":"Nagpuyo ko diri sukad gahapon."}
{"id":"ceb.e257","card":"ceb.c0682","ceb":"Mokaon ko bisan gamay."}
{"id":"ceb.e258","card":"ceb.c0684","ceb":"Sige, basta mobalik ka."}
{"id":"ceb.e259","card":"ceb.c0687","ceb":"Hugasi ang kamot sa wala pa mokaon."}
{"id":"ceb.e260","card":"ceb.c0688","ceb":"Moadto ko, gawas kon moulan."}
