{"id":"tl.g001","card":"tl.c0002","a":"May aso ka ba?","b":"Oo, Max ang pangalan niya."}
{"id":"tl.g002","card":"tl.c0007","a":"Kumain ka na ba?","b":"Oo, kumain ako ng mangga kanina."}
{"id":"tl.g003","card":"tl.c0009","a":"Nasaan ang tsinelas ko?","b":"Nasa labas, sa tabi ng pinto."}
{"id":"tl.g004","card":"tl.c0005","a":"Nasaan ang mga bata?","b":"Nandoon sila sa bahay ni Lola."}
{"id":"tl.g005","card":"tl.c0018","a":"Magandang umaga po, Lola!","b":"Magandang umaga rin, anak. Kumain ka na?"}
{"id":"tl.g006","card":"tl.c0022","a":"Kumusta po kayo, Tita?","b":"Mabuti naman. Ikaw, kumusta ka?"}
{"id":"tl.g007","card":"tl.c0023","a":"Uy, Joy! Kumusta ka?","b":"Okay lang. Ikaw?"}
{"id":"tl.g008","card":"tl.c0026","a":"Ito po ang sukli ninyo.","b":"Salamat po."}
{"id":"tl.g009","card":"tl.c0031","a":"Mano po, Lolo.","b":"Kaawaan ka ng Diyos."}
{"id":"tl.g010","card":"tl.c0030","a":"Tao po!","b":"Tuloy po kayo."}
{"id":"tl.g011","card":"tl.c0038","a":"Ano ang pangalan mo?","b":"Bea. Ikaw?"}
{"id":"tl.g012","card":"tl.c0042","a":"Taga-saan po kayo?","b":"Taga-Cebu ako, pero nakatira ako sa Maynila."}
{"id":"tl.g013","card":"tl.c0046","a":"Ilang taon ka na?","b":"Dalawampu't isa."}
{"id":"tl.g014","card":"tl.c0051","a":"Marunong ka bang mag-Ingles?","b":"Oo, pero gusto kong mag-aral ng Tagalog."}
{"id":"tl.g015","card":"tl.c0052","a":"Ano ang trabaho mo?","b":"Nars ako sa isang ospital sa Makati."}
{"id":"tl.g016","card":"tl.c0056","a":"Sino siya?","b":"Si Kuya Jun, ang kuya ko."}
{"id":"tl.g017","card":"tl.c0062","a":"Ilan ang kapatid mo?","b":"Dalawa: isang lalaki at isang babae."}
{"id":"tl.g018","card":"tl.c0070","a":"Tita, siya si Juan, kaibigan ko.","b":"Kumusta, Juan? Tuloy ka."}
{"id":"tl.g019","card":"tl.c0065","a":"May asawa ka na ba?","b":"Wala pa."}
{"id":"tl.g020","card":"tl.c0058","a":"Nasaan si Lola?","b":"Nasa kusina, nagluluto ng sinigang."}
{"id":"tl.g021","card":"tl.c0083","a":"Magkano po ito?","b":"Bente pesos po."}
{"id":"tl.g022","card":"tl.c0085","a":"Ito po ang bayad.","b":"Salamat po. Ito po ang sukli ninyo."}
{"id":"tl.g023","card":"tl.c0087","a":"Bente pesos po.","b":"Pasensya na po, wala po akong barya. Isang daan lang po."}
{"id":"tl.g024","card":"tl.c0084","a":"Magkano po lahat?","b":"Dalawang daan po lahat."}
{"id":"tl.g025","card":"tl.c0088","a":"Anong oras na?","b":"Alas-tres na."}
{"id":"tl.g026","card":"tl.c0095","a":"Kailan ka uuwi?","b":"Bukas ng umaga."}
{"id":"tl.g027","card":"tl.c0097","a":"Anong araw ngayon?","b":"Biyernes. Sa wakas!"}
{"id":"tl.g028","card":"tl.c0092","a":"Gaano katagal ang biyahe papuntang Batangas?","b":"Mga tatlong oras."}
{"id":"tl.g029","card":"tl.c0109","a":"Kumain ka na?","b":"Hindi pa. Gutom na nga ako!"}
{"id":"tl.g030","card":"tl.c0110","a":"Kumain na po kayo, Lola?","b":"Oo, apo. Kumain ka na rin."}
{"id":"tl.g031","card":"tl.c0108","a":"Kain tayo!","b":"Salamat, busog pa ako."}
{"id":"tl.g032","card":"tl.c0121","a":"May tubig ba?","b":"Oo, nasa ref."}
{"id":"tl.g033","card":"tl.c0119","a":"Ano po ang sa inyo?","b":"Isang kape nga po, saka isang pandesal."}
{"id":"tl.g034","card":"tl.c0125","a":"Pabili po!","b":"Ano po iyon?"}
{"id":"tl.g035","card":"tl.c0131","a":"Magkano po iyan?","b":"Singkwenta po ang isa."}
{"id":"tl.g036","card":"tl.c0137","a":"Ano po'ng sa inyo, ma'am?","b":"Isang kilo po ng mangga."}
{"id":"tl.g037","card":"tl.c0134","a":"Tatlong daan po ito.","b":"Ang mahal naman! Wala po bang tawad?"}
{"id":"tl.g038","card":"tl.c0136","a":"Alin po ang gusto ninyo?","b":"Ito na lang po."}
{"id":"tl.g039","card":"tl.c0149","a":"Gising ka pa?","b":"Oo, hindi ako makatulog."}
{"id":"tl.g040","card":"tl.c0147","a":"Nasaan si Nanay?","b":"Nagluluto si Nanay sa kusina."}
{"id":"tl.g041","card":"tl.c0151","a":"Maligo ka na.","b":"Naligo na ako kanina."}
{"id":"tl.g042","card":"tl.c0156","a":"Nandito na ba si Tatay?","b":"Oo, umuwi na si Tatay kanina."}
{"id":"tl.g043","card":"tl.c0157","a":"Bea, nasaan ang CR?","b":"Doon, sa tabi ng kusina."}
{"id":"tl.g044","card":"tl.c0160","a":"Malapit ba ang botika?","b":"Oo, malapit lang. Nasa kanto."}
{"id":"tl.g045","card":"tl.c0173","a":"Saan ka pupunta, Jun?","b":"Sa simbahan. Sama ka?"}
{"id":"tl.g046","card":"tl.c0172","a":"Kuya, nasaan po ang ospital?","b":"Diretso lang po, tapos kumanan po kayo sa kanto."}
{"id":"tl.g047","card":"tl.c0163","a":"Malayo pa ba?","b":"Hindi na. Malapit na tayo."}
{"id":"tl.g048","card":"tl.c0175","a":"Para po, sa tabi lang!","b":"Sige."}
{"id":"tl.g049","card":"tl.c0184","a":"Magkano po ang pamasahe papuntang Makati?","b":"Labinlimang piso po."}
{"id":"tl.g050","card":"tl.c0186","a":"Dadaan po ba ito sa Maynila?","b":"Opo, sakay na po kayo."}
{"id":"tl.g051","card":"tl.c0179","a":"Kuya, sa Makati po.","b":"Sige po, ma'am."}
{"id":"tl.g052","card":"tl.c0194","a":"Saan masakit?","b":"Masakit ang tiyan ko, Dok."}
{"id":"tl.g053","card":"tl.c0195","a":"Bakit wala ka sa trabaho?","b":"May sakit ako. May lagnat ako."}
{"id":"tl.g054","card":"tl.c0208","a":"Okey ka lang ba?","b":"Hindi, masama ang pakiramdam ko."}
{"id":"tl.g055","card":"tl.c0204","a":"Puwede po bang magtanong?","b":"Opo, ano po iyon?"}
{"id":"tl.g056","card":"tl.c0215","a":"Saan po kayo nagtatrabaho?","b":"Sa ospital. Nars ako."}
{"id":"tl.g057","card":"tl.c0220","a":"May pasok ka bukas?","b":"Wala. Sabado bukas."}
{"id":"tl.g058","card":"tl.c0223","a":"Ano ang kurso mo?","b":"Nursing. Nag-aaral pa ako sa Maynila."}
{"id":"tl.g059","card":"tl.c0217","a":"Nag-aral ka ba kahapon?","b":"Oo, nag-aral ako kahapon sa bahay."}
{"id":"tl.g060","card":"tl.c0239","a":"Ito ang bahay namin.","b":"Ang ganda!"}
{"id":"tl.g061","card":"tl.c0228","a":"Mabait ba si Tita Baby?","b":"Oo, mabait siya sa lahat."}
{"id":"tl.g062","card":"tl.c0240","a":"Alin ang gusto mo?","b":"Ito. Mas malaki ito kaysa diyan."}
{"id":"tl.g063","card":"tl.c0229","a":"Sino si Carlo?","b":"Siya ang matangkad na lalaki doon."}
{"id":"tl.g064","card":"tl.c0245","a":"Tara, sayaw tayo!","b":"Pagod na ako. Bukas na lang."}
{"id":"tl.g065","card":"tl.c0259","a":"Pupunta kami sa mall. Gusto mo bang sumama?","b":"Sige, sasama ako!"}
{"id":"tl.g066","card":"tl.c0255","a":"Ano ang hilig mo?","b":"Mahilig akong kumanta."}
{"id":"tl.g067","card":"tl.c0246","a":"Bakit tahimik si Mark?","b":"Galit siya sa akin."}
{"id":"tl.g068","card":"tl.c0263","a":"Pupunta ako sa Cebu.","b":"Kailan?"}
{"id":"tl.g069","card":"tl.c0269","a":"Nasaan ka?","b":"Nasa bahay pa ako."}
{"id":"tl.g070","card":"tl.c0272","a":"Lola, kumain na po ba kayo?","b":"Oo, kumain na ako. Ikaw?"}
{"id":"tl.g071","card":"tl.c0275","a":"Gusto ko ng kape.","b":"Ako rin."}
{"id":"tl.g072","card":"tl.c0282","a":"May tubig ba?","b":"Wala."}
{"id":"tl.g073","card":"tl.c0279","a":"Tapos ka na ba?","b":"Hindi pa."}
{"id":"tl.g074","card":"tl.c0289","a":"Kilala mo ba si Ana?","b":"Oo, kilala ko si Ana. Kaibigan ko siya."}
{"id":"tl.g075","card":"tl.c0290","a":"Marunong ka bang magsalita ng Tagalog?","b":"Oo, marunong akong magsalita ng Tagalog, pero kaunti lang."}
{"id":"tl.g076","card":"tl.c0300","a":"Pupunta ako sa Boracay bukas!","b":"Talaga? Ang suwerte mo!"}
{"id":"tl.g077","card":"tl.c0301","a":"Masarap ang adobo ni Lola, 'di ba?","b":"Oo, sobra!"}
{"id":"tl.g078","card":"tl.c0311","a":"Tara na!","b":"Wait lang, nasaan 'yung cellphone ko?"}
{"id":"tl.g079","card":"tl.c0296","a":"Nasaan si Mark?","b":"Ewan ko."}
{"id":"tl.g080","card":"tl.c0309","a":"Ang init! Paki-on ang aircon.","b":"Sige."}
{"id":"tl.g081","card":"tl.c0312","a":"Masarap po ang luto ninyo, Tita.","b":"Salamat! Kain ka pa."}
{"id":"tl.g082","card":"tl.c0316","a":"Puwede pa po ba?","b":"Siyempre! Marami pa."}
{"id":"tl.g083","card":"tl.c0315","a":"Kain ka pa!","b":"Salamat po, busog na busog ako."}
{"id":"tl.g084","card":"tl.c0317","a":"Tapos ko na ang report.","b":"Ang husay mo!"}
{"id":"tl.g085","card":"tl.c0319","a":"Naglinis ako ng buong bahay.","b":"Ang sipag mo naman!"}
{"id":"tl.g086","card":"tl.c0324","a":"Ano sa tingin mo?","b":"Bagay sa iyo!"}
{"id":"tl.g087","card":"tl.c0327","a":"Tuloy ka.","b":"Salamat po. Ang ganda po ng bahay ninyo."}
{"id":"tl.g088","card":"tl.c0330","a":"Si Carlo na ba ito? Malaki na ang anak mo!","b":"Oo, sampung taon na siya."}
{"id":"tl.g089","card":"tl.c0332","a":"Salamat po.","b":"Uy, marunong ka palang mag-Tagalog!"}
{"id":"tl.g090","card":"tl.c0333","a":"Ang husay mong mag-Tagalog!","b":"Salamat, pero nag-aaral pa lang ako."}
{"id":"tl.g091","card":"tl.c0335","a":"Ang galing mong kumanta!","b":"Hindi naman."}
{"id":"tl.g092","card":"tl.c0336","a":"Ang ganda ng sulat mo, iha.","b":"Hindi naman po. Salamat po."}
{"id":"tl.g093","card":"tl.c0338","a":"Ang ganda ng damit mo!","b":"Salamat, ikaw rin!"}
{"id":"tl.g094","card":"tl.c0370","a":"Masaya kang kasama.","b":"Ikaw rin! Tara, kain tayo."}
{"id":"tl.g095","card":"tl.c0385","a":"Salamat sa gabing ito. Kain tayo ulit sa Sabado?","b":"Gusto ko rin."}
{"id":"tl.g096","card":"tl.c0383","a":"Sige na, sumayaw tayo!","b":"Sige na nga."}
{"id":"tl.g097","card":"tl.c0358","a":"Ang gwapo mo ngayon, ah.","b":"Talaga? Salamat! Bago ang damit ko."}
{"id":"tl.g098","card":"tl.c0361","a":"Pasensya na, late ako.","b":"Okay lang. Ang ganda mo ngayong gabi."}
{"id":"tl.g099","card":"tl.c0362","a":"Liza ang pangalan ko.","b":"Ang ganda ng pangalan mo."}
{"id":"tl.g100","card":"tl.c0363","a":"Nag-aaral ako ng Tagalog, Hapon at Espanyol.","b":"Matalino ka pala!"}
{"id":"tl.g101","card":"tl.c0365","a":"Ang ganda ng boses mo.","b":"Naku, hindi naman."}
{"id":"tl.g102","card":"tl.c0368","a":"Pormang-porma ka ngayon! Saan ka pupunta?","b":"Sa kasal ng pinsan ko."}
{"id":"tl.g103","card":"tl.c0369","a":"Masarap kang kausap.","b":"Ikaw rin. Kape ulit tayo bukas?"}
{"id":"tl.g104","card":"tl.c0372","a":"Masaya akong kasama ka.","b":"Ako rin."}
{"id":"tl.g105","card":"tl.c0374","a":"Puwede ba kitang ligawan?","b":"Bakit hindi?"}
{"id":"tl.g106","card":"tl.c0375","a":"Gusto ko si Bea, pero nahihiya ako.","b":"Huwag kang torpe! Kausapin mo siya."}
{"id":"tl.g107","card":"tl.c0376","a":"Kape tayo minsan?","b":"Sige, gusto ko iyan."}
{"id":"tl.g108","card":"tl.c0377","a":"Libre ka ba sa Sabado?","b":"Oo naman! Saan tayo?"}
{"id":"tl.g109","card":"tl.c0379","a":"May gusto ako sa iyo.","b":"Talaga? Ako rin!"}
{"id":"tl.g110","card":"tl.c0381","a":"Ikaw ang pinakamaganda rito.","b":"Bolero ka talaga!"}
{"id":"tl.g111","card":"tl.c0380","a":"Ang ganda mo talaga.","b":"Ikaw talaga!"}
{"id":"tl.g112","card":"tl.c0386","a":"Puwede ba kitang yayaing kumain?","b":"Salamat, pero may kasintahan na ako."}
{"id":"tl.g113","card":"tl.c0387","a":"Libre ka ba mamayang gabi?","b":"Pasensya na, hindi ako interesado."}
{"id":"tl.g114","card":"tl.c0388","a":"Gusto kita, Joy.","b":"Salamat, pero kaibigan lang talaga tayo."}
{"id":"tl.g115","card":"tl.c0686","a":"Uy, Ana! Kumusta?","b":"Uy! Okay lang ako."}
{"id":"tl.g116","card":"tl.c0680","a":"Hoy! Akin iyan!","b":"Sorry, sa iyo pala."}
{"id":"tl.g117","card":"tl.c0688","a":"Sarado na ang tindahan.","b":"Sayang! Gusto ko pa namang bumili."}
{"id":"tl.g118","card":"tl.c0689","a":"Walang pasok bukas!","b":"Yehey!"}
{"id":"tl.g119","card":"tl.c0682","a":"Alas-singko ang alis natin bukas.","b":"Ha? Ang aga naman!"}
{"id":"tl.g120","card":"tl.c0681","a":"Tara na!","b":"Teka, kukunin ko lang ang bag ko."}
{"id":"tl.g121","card":"tl.c0690","a":"Pagod ka?","b":"Hay! Ang daming trabaho."}
{"id":"tl.g122","card":"tl.c0691","a":"Nandito na tayo.","b":"Hay, salamat!"}
{"id":"tl.g123","card":"tl.c0683","a":"May libreng kape sa opisina.","b":"Ayos!"}
{"id":"tl.g124","card":"tl.c0692","a":"Ang init ngayon!","b":"Oo nga!"}
{"id":"tl.g125","card":"tl.c0685","a":"Halika, kain tayo!","b":"Sige, salamat!"}
{"id":"tl.g126","card":"tl.c0687","a":"Mabuhay ang bagong kasal!","b":"Mabuhay!"}
{"id":"tl.g127","card":"tl.c0693","a":"May ipis sa kusina!","b":"Kadiri!"}
{"id":"tl.g128","card":"tl.c0694","a":"Iniwan ako ng jeep.","b":"Buti nga! Ang tagal mo kasi."}
{"id":"tl.g129","card":"tl.c0695","a":"Sumama ka na sa amin. Sige na!","b":"Sige, sasama ako."}
{"id":"tl.g130","card":"tl.c0696","a":"Ano ba! Ang ingay ninyo!","b":"Pasensya na po."}
{"id":"tl.g131","card":"tl.c0684","a":"Nasaan ang susi?","b":"Heto!"}
{"id":"tl.g132","card":"tl.c0697","a":"Taga-Cebu rin ako.","b":"Hindi nga? Ako rin!"}
{"id":"tl.g133","card":"tl.c0698","a":"Lola, natapon ko ang kape.","b":"Susmaryosep! Linisin mo agad."}
