{"id":"ko.g137","card":"ko.c0503","a":"콘서트 어땠어?","b":"떼창 할 때 소름 돋았어."}
{"id":"ko.g138","card":"ko.c0514","a":"인스타 해요?","b":"네, 방금 팔로우했어요."}
{"id":"ko.g139","card":"ko.c0513","a":"사진 올렸어. 좋아요 눌러 줘.","b":"벌써 눌렀지."}
{"id":"ko.g140","card":"ko.c0516","a":"아까 내 농담에 왜 아무도 안 웃었어?","b":"갑분싸였어…"}
{"id":"ko.g141","card":"ko.c0519","a":"여기 떡볶이 어때?","b":"존맛탱. 또 올 거야."}
{"id":"ko.g142","card":"ko.c0521","a":"이 노래 중독성 있어.","b":"ㄹㅇ 하루 종일 듣는 중."}
{"id":"ko.g143","card":"ko.c0518","a":"오늘 뭐 입지?","b":"꾸안꾸로 가. 청바지에 흰 티."}
{"id":"ko.g144","card":"ko.c0613","a":"주말에 뭐 해요?","b":"가족이랑 밥 먹어요."}
{"id":"ko.g145","card":"ko.c0614","a":"누구랑 왔어요?","b":"친구랑 왔어요."}
{"id":"ko.g146","card":"ko.c0609","a":"저 사람 누구예요?","b":"우리 오빠예요."}
{"id":"ko.g147","card":"ko.c0610","a":"언니, 이거 어때요?","b":"잘 어울려. 사."}
{"id":"ko.g148","card":"ko.c0611","a":"형제 있어요?","b":"네, 동생 한 명 있어요."}
{"id":"ko.g149","card":"ko.c0615","a":"선생님, 질문 있어요.","b":"네, 말해 보세요."}
{"id":"ko.g150","card":"ko.c1031","a":"그 식당 월요일에 닫아요.","b":"아, 그래요? 그럼 화요일에 가요."}
{"id":"ko.g151","card":"ko.c1033","a":"이거 제가 만든 케이크예요.","b":"와, 진짜 예뻐요!"}
{"id":"ko.g152","card":"ko.c1032","a":"민수야, 나 왔어.","b":"어, 왔어? 들어와."}
{"id":"ko.g153","card":"ko.c1035","a":"내일 같이 점심 먹을래?","b":"응, 좋아. 몇 시?"}
{"id":"ko.g154","card":"ko.c1037","a":"뭐 먹고 싶어요?","b":"음… 오늘은 비빔밥이요."}
{"id":"ko.g155","card":"ko.c1034","a":"이거 제 첫 월급으로 샀어요.","b":"오, 멋있다!"}
{"id":"ko.g156","card":"ko.c1038","a":"여기가 남산타워예요.","b":"우와, 서울이 다 보여요!"}
{"id":"ko.g157","card":"ko.c1046","a":"저 다음 달에 결혼해요.","b":"어머, 정말요? 축하해요!"}
{"id":"ko.g158","card":"ko.c1044","a":"아야! 문에 손을 부딪쳤어요.","b":"괜찮아요? 어디 봐요."}
{"id":"ko.g159","card":"ko.c1051","a":"얼굴 빨개졌어요!","b":"아이참, 그만 봐요."}
{"id":"ko.g160","card":"ko.c1040","a":"이 영화 재미있을까?","b":"글쎄, 잘 모르겠어."}
{"id":"ko.g161","card":"ko.c1041","a":"나 어제 BTS 봤어.","b":"에이, 거짓말!"}
{"id":"ko.g162","card":"ko.c1052","a":"오늘 회식 없대요.","b":"아싸! 집에 일찍 가야지."}
{"id":"ko.g163","card":"ko.c1047","a":"벌써 열한 시예요.","b":"헉, 빨리 가야 돼요!"}
{"id":"ko.g164","card":"ko.c1048","a":"앗, 커피 쏟았어요!","b":"괜찮아요, 제가 닦을게요."}
{"id":"ko.g165","card":"ko.c1049","a":"우산 가져왔어요?","b":"아차, 집에 두고 왔어요."}
{"id":"ko.g166","card":"ko.c1043","a":"시험 끝났어요?","b":"네, 휴, 이제 좀 쉬어야겠어요."}
{"id":"ko.g167","card":"ko.c1045","a":"오늘도 야근이에요?","b":"에휴, 네. 일이 너무 많아요."}
{"id":"ko.g168","card":"ko.c1053","a":"쉿, 아기 자요.","b":"아, 미안해요. 조용히 할게요."}
{"id":"ko.g169","card":"ko.c1036","a":"자, 이제 시작할까요?","b":"네, 시작해요!"}
{"id":"ko.g170","card":"ko.c1039","a":"여보세요? 민지 씨예요?","b":"네, 저예요. 무슨 일이에요?"}
{"id":"ko.g171","card":"ko.c1042","a":"이 가방이 백만 원이에요.","b":"세상에, 너무 비싸요!"}
{"id":"ko.g172","card":"ko.c1050","a":"왁!","b":"아, 깜짝이야! 놀랐잖아."}
{"id":"ko.g173","card":"ko.c1054","a":"으악, 벌레다!","b":"가만히 있어요. 제가 잡을게요."}
{"id":"ko.g174","card":"ko.c1055","a":"짜잔! 생일 선물이에요.","b":"와, 고마워요! 뭐예요?"}
{"id":"ko.g175","card":"ko.c1056","a":"이 우유 날짜 지났어요.","b":"웩, 벌써 마셨는데!"}
{"id":"ko.g176","card":"ko.c1140","a":"오늘따라 더 예뻐요.","b":"진짜요? 머리 좀 바꿨어요."}
{"id":"ko.g177","card":"ko.c1141","a":"제 이름은 하늘이에요.","b":"이름도 예쁘네요."}
{"id":"ko.g178","card":"ko.c1143","a":"왜 이렇게 귀여워요?","b":"에이, 농담하지 마세요."}
{"id":"ko.g179","card":"ko.c1146","a":"실물이 더 잘생겼어요.","b":"하하, 사진이 잘 안 나왔나 봐요."}
{"id":"ko.g180","card":"ko.c1148","a":"일하는 모습이 멋있어요.","b":"갑자기요? 고마워요."}
{"id":"ko.g181","card":"ko.c1152","a":"미소가 예뻐요.","b":"감사합니다. 그런 말 처음 들어요."}
{"id":"ko.g182","card":"ko.c1153","a":"눈웃음이 정말 예뻐요.","b":"아이참, 부끄러워요."}
{"id":"ko.g183","card":"ko.c1156","a":"웬일이에요? 전화를 다 하고.","b":"그냥, 목소리 듣고 싶었어요."}
{"id":"ko.g184","card":"ko.c1159","a":"저 어때요?","b":"솔직히, 완전 제 스타일이에요."}
{"id":"ko.g185","card":"ko.c1161","a":"이상형이 뭐예요?","b":"음… 웃음이 많은 사람이요."}
{"id":"ko.g186","card":"ko.c1162","a":"첫인상이 좋았어요.","b":"저도요. 처음부터 편했어요."}
{"id":"ko.g187","card":"ko.c1165","a":"밥 먹었어요?","b":"아직이요. 같이 먹을래요?"}
{"id":"ko.g188","card":"ko.c1171","a":"라면 먹고 갈래요?","b":"하하, 그 영화 대사죠? 오늘은 집에 갈게요."}
{"id":"ko.g189","card":"ko.c1167","a":"이번 주말에 같이 밥 먹을래요?","b":"좋아요, 언제 만날까요?"}
{"id":"ko.g190","card":"ko.c1169","a":"오늘 즐거웠어요. 연락해도 돼요?","b":"마음은 고맙지만 괜찮아요."}
{"id":"ko.g191","card":"ko.c1170","a":"다음에 또 볼 수 있어요?","b":"죄송하지만 만나는 사람이 있어요."}
{"id":"ko.g192","card":"ko.c1168","a":"수업 끝나고 제가 커피 살게요.","b":"좋은 분인데, 친구로 지내고 싶어요."}
{"id":"ko.g193","card":"ko.c1179","a":"음식이 정말 맛있네요.","b":"별거 아니에요. 많이 드세요."}
{"id":"ko.g194","card":"ko.c1181","a":"이거 어떻게 만드셨어요?","b":"간단해요. 다음에 알려 드릴게요."}
{"id":"ko.g195","card":"ko.c1182","a":"정말 잘하시네요.","b":"아니에요, 아직 멀었어요."}
{"id":"ko.g196","card":"ko.c1184","a":"보고서 봤어요. 꼼꼼하시네요.","b":"좋게 봐 주셔서 감사해요."}
{"id":"ko.g197","card":"ko.c1190","a":"마흔이에요? 동안이시네요.","b":"과찬이세요."}
{"id":"ko.g198","card":"ko.c1193","a":"아이가 정말 귀엽네요.","b":"감사해요. 집에서는 말썽꾸러기예요."}
{"id":"ko.g199","card":"ko.c1196","a":"그 옷 잘 어울리세요.","b":"칭찬해 주셔서 감사해요."}
{"id":"ko.g200","card":"ko.c1197","a":"발음이 정말 좋으시네요.","b":"아니에요. 선생님 덕분이에요."}
{"id":"ko.g201","card":"ko.c1202","a":"오늘 발표에서 많이 배웠습니다.","b":"별말씀을요. 들어 줘서 고마워요."}
