{"k":"0906d694097147","t":"डॉक्टर साहब, मुझे खाँसी है।. यह दवाई लीजिए, और आपको आराम करना चाहिए।"},
{"k":"091099ee86fcdf","t":"प्रिया को भूख लगी है"},
{"k":"0920d8c91ca35e","t":"दो समोसे और दो चाय, प्लीज़।"},
{"k":"09379f0fb53b15","t":"मुझे जाना है"},
{"k":"0937bc4fc4a162","t":"मैं शाकाहारी हूँ।"},
{"k":"09421ea884ca7c","t":"मेरा नाम सारा है।"},
{"k":"0958f395249ca5","t":"ये शर्मा जी के बच्चे हैं।"},
{"k":"09673a30cfefb1","t":"यह"},
{"k":"096b9eb93f3aa4","t":"क्या आप हिंदी बोलते हैं. हाँ, थोड़ी-थोड़ी बोलता हूँ।"},
{"k":"096dc514c931cf","t":"मैं शादीशुदा हूँ।"},
{"k":"0974d1644f62e7","t":"त से तोता।"},
{"k":"0985d5080d3ec5","t":"चिंता मत कीजिए।"},
{"k":"0993ab32fc97c9","t":"अरे रवि, तुम कैसे हो. बढ़िया तुम सुनाओ।"},
{"k":"09a59d277b0af9","t":"गरम चाय"},
{"k":"09b7d2fec9c706","t":"दस"},
{"k":"09bbf3136b8f67","t":"अभी चलाता हूँ।"},
{"k":"09bff8179b29d7","t":"कुल कितना हुआ"},
{"k":"09c72e1fae0370","t":"भैया, लाल क़िला चलेंगे. हाँ, बैठिए।"},
{"k":"09cb80a5be0630","t":"नमस्ते।"},
{"k":"09ce9abd42ee51","t":"मैं अमरीका से हूँ, बोस्टन से।"},
{"k":"09dcdcf6526ca2","t":"शाम को"},
{"k":"09e00b74fca93f","t":"ये आम मीठे हैं, आप भी खाइए।"},
{"k":"09e12de8ae1eb0","t":"क्या आपके पास पैसे हैं"},
{"k":"09f60d6a4c4017","t":"दाल बहुत तीखी है।"},
{"k":"09f8e6b2e84963","t":"इस कमरे में कौन है"},
{"k":"0a19b98034bc45","t":"सौ रुपये"},
{"k":"0a1b347c223d2a","t":"कमरे"},
{"k":"0a22e3c12277d9","t":"खा"},
{"k":"0a2dfa52b1bbc5","t":"मैंने चाय पी"},
{"k":"0a2e739d31381e","t":"मेरा फ़ोन कहाँ है. मेज़ पर है, किताब के पास।"},
{"k":"0a3f0d8f1c11b3","t":"यह किसकी किताब है. यह मेरी बहन की किताब है।"},
{"k":"0a4422d32516ab","t":"मेरे पास समय नहीं है।"},
{"k":"0a469c4b15a964","t":"नमस्ते आंटी, आप कैसी हैं. मैं ठीक हूँ, बेटा। तुम कैसे हो"},
{"k":"0a576f93926bf3","t":"आपने क्या किया"},
{"k":"0a63c59a1a2157","t":"बहुत गर्मी है, पंखा चलाइए।. अभी चलाता हूँ।"},
{"k":"0a72dfaa395eac","t":"कुर्सी"},
{"k":"0a7320836ded38","t":"मैं हर रविवार नानी से वीडियो कॉल पर बात करती हूँ।"},
{"k":"0a81512dad942e","t":"नमस्ते, वर्मा जी। आप कैसे हैं"},
{"k":"0a8f0846450f41","t":"माफ़ कीजिए, मुझे देर हो गई।"},
{"k":"0a9669e22e9883","t":"भैया, यहाँ रुकिए।"},
{"k":"0a9f7a85160971","t":"मैं रात को ग्यारह बजे सोती हूँ।"},
{"k":"0abc65559d4266","t":"मेरे पेट में दर्द है।"},
{"k":"0aca6016804bc1","t":"आप बहुत अच्छी हिंदी बोलती हैं. शुक्रिया, मैं हिंदी सीख रही हूँ।"},
{"k":"0acdcb351e30bf","t":"मैं शिकागो में रहता हूँ।"},
{"k":"0ade3799dab08e","t":"आम"},
{"k":"0ade4a7964d6e0","t":"सवा चार बजे"},
{"k":"0ae463f79e860c","t":"इसमें"},
{"k":"0af5c20ade5bb5","t":"सीधे जाइए, फिर बाएँ मुड़िए।"},
{"k":"0af683fece424b","t":"आपका कमरा कैसा है"},
{"k":"0aff4ba1883fde","t":"मैं बहुत ख़ुश हूँ, आज मेरा जन्मदिन है"},
{"k":"0b1903ffbffe08","t":"किताब नई है"},
{"k":"0b1dd612d2b239","t":"मैं रोज़ सात बजे उठती हूँ।"},
{"k":"0b1e2c2ec6245b","t":"र"},
{"k":"0b2703f8abd168","t":"कृपया"},
{"k":"0b27d3787a065b","t":"नमस्ते, आपका स्वागत है अंदर आइए।"},
{"k":"0b2ec64eb4fff2","t":"वह नहीं आई क्योंकि वह बीमार थी"},
{"k":"0b32ff6a841036","t":"क्या आप घर पर थीं"},
{"k":"0b36190329d23c","t":"क्या आप चाय पिएँगे"},
{"k":"0b3cb9b730614e","t":"मुझे ज़ुकाम है।"},
{"k":"0b45eef33b04a9","t":"चाय में चीनी. बस थोड़ी सी।"},
{"k":"0b4a46822b20bb","t":"ड"},
{"k":"0b4b76d8bc324c","t":"बारिश हो रही है, इसलिए हम घर पर हैं।"},
{"k":"0b5533398f32ec","t":"अमित"},
{"k":"0b65992eb13005","t":"ठंडा"},
{"k":"0b6981462e3939","t":"मेरी ट्रेन सवा चार बजे जाएगी।"},
{"k":"0b7306b288197c","t":"प"},
{"k":"0b7ac671713c4a","t":"आपका स्वागत है।"},
{"k":"0b7c6ad073f8fc","t":"तो"},
{"k":"0b87270a1dd5d7","t":"मैं कल नहीं आऊँगा।"},
{"k":"0b8afed7c23690","t":"मैं चाय पीती हूँ"},
{"k":"0b9b1fa6ff3813","t":"मेरे पिताजी छह बजे उठते हैं"},
{"k":"0b9e0c85b0b59b","t":"आपको कौन-सा फल पसंद है"},
{"k":"0ba43de4c2b00a","t":"आज कौन-सा दिन है"},
{"k":"0bbf8305a3c93f","t":"मुझे कल दिल्ली जाना है।"},
{"k":"0bcdb841ce28ca","t":"मेरे"},
{"k":"0bd1d8ae99dd19","t":"मेरे पास टिकट है।"},
{"k":"0bd2986c2db0ba","t":"फल"},
{"k":"0bd41ba902f976","t":"इसलिए"},
{"k":"0bd4969d5d8fb1","t":"मेरी है। मेरे पिताजी ने दी।"},
{"k":"0be1163b1587d3","t":"मैंने दो समोसे खाए।"},
{"k":"0be4e4a65337dd","t":"क्योंकि"},
{"k":"0bf3a881e1ab19","t":"मेरा एक भाई है"},
{"k":"0c15274ea20443","t":"टी का"},
{"k":"0c1fccfe8360bc","t":"मेज़ पर है, किताब के पास।"},
{"k":"0c211bc375410a","t":"दो बजे हैं"},
{"k":"0c54b4c304abcd","t":"पानी बोतल में है।"},
{"k":"0c629e058e1f62","t":"दाएँ मुड़िए।"},
{"k":"0c8aafa4f1e4ed","t":"दो"},
{"k":"0c9a3d17369b76","t":"क्या हाल है, अमित"},
{"k":"0cb53f1c3e7d80","t":"मैं डॉक्टर नहीं हूँ।"},
{"k":"0ccb4fac12797d","t":"आपकी उम्र क्या है. मैं पच्चीस साल का हूँ।"},
{"k":"0cd3e3e7d3c095","t":"मुझे नीला रंग पसंद है।"},
{"k":"0ce4d6c5553e85","t":"मैं"},
{"k":"0cfbca509074b2","t":"आपको"},
{"k":"0d1a7047acea75","t":"मुझे चाँदनी चौक जाना है, कौन-सी मेट्रो लूँ"},
{"k":"0d1b25ad2a8e16","t":"यह किताब बहुत अच्छी है।"},
{"k":"0d1c7115e45d2f","t":"बहुत महँगा है, थोड़ा कम कीजिए।"},
{"k":"0d1f5c7d15054d","t":"वह फ़ोन पर बात कर रही है"},
{"k":"0d2335f3826e4f","t":"बैंक के सामने"},
{"k":"0d24f10f537a09","t":"सब ठीक है।"},
{"k":"0d2682602b89d9","t":"ये मेरी किताबें हैं"},
{"k":"0d2cc4d843c0b2","t":"मेरे पास गाड़ी है।"},
{"k":"0d344a999284f8","t":"मैं कल आपको फ़ोन करूँगी।"},
{"k":"0d4408db9e9240","t":"बारिश हो रही है।"},
{"k":"0d4adbcc51bc24","t":"या"},
{"k":"0d5785c4f9e1fb","t":"चेक-आउट कितने बजे है"},
{"k":"0d605f71d68db5","t":"कल सात बजे मिलें"},
{"k":"0d66ea1d9ee7d3","t":"तू"},
{"k":"0d71bcfbe21310","t":"लीजिए, आपकी चाय।"},
{"k":"0d82a4551c838b","t":"मुझे आम पसंद है।"},
{"k":"0d871e5658c8ff","t":"चाय"},
{"k":"0d87c48a4368bf","t":"यह कौन है. यह मेरा दोस्त अमित है।"},
{"k":"0d8c762e1b9e56","t":"थोड़ा कम कीजिए"},
{"k":"0d9b3e05dbe0de","t":"मुझे भूख लगी है।"},
{"k":"0d9c03ab005e15","t":"यह किसकी किताब है"},
{"k":"0da781cb227a1f","t":"ठीक है, शाम को छह बजे।"},
{"k":"0daa18a89bf0f8","t":"मैं अंग्रेज़ी बोलती हूँ।"},
{"k":"0db611b97c4472","t":"शुक्रिया, मैं हिंदी सीख रही हूँ।"},
{"k":"0dc701d6e91aca","t":"मुझे यह पसंद है, लेकिन यह थोड़ा बड़ा है।"},
{"k":"0dcb7194c096b8","t":"मेन्यू दिखाइए।"},
{"k":"0dd4a89d451ab1","t":"मुं"},
{"k":"0dd708a4833765","t":"क्या हाल है"},
{"k":"0ddb63a6038c76","t":"कितने बजे हैं"},
{"k":"0ddc71775efee4","t":"मुझे मूँगफली से एलर्जी है।"},
{"k":"0de4dc008ec6eb","t":"नीली कमीज़"},
{"k":"0de894fa771476","t":"अरे रवि, तुम कैसे हो"},
{"k":"0e043ff1a452dd","t":"मुझे यह पसंद नहीं है।"},
{"k":"0e11957b9e9bee","t":"मुझे एक किलो आलू चाहिए।"},
{"k":"0e1d43f4df3e21","t":"बारिश"},
{"k":"0e281518c4677d","t":"कम मिर्च, प्लीज़।"},
{"k":"0e3b85f96f277d","t":"महँगी घड़ी"},
{"k":"0e3cf4acf68413","t":"मेरा परिवार भारत से है।"},
{"k":"0e42d3a0bb56ae","t":"कुल डेढ़ सौ रुपये हुए।"},
{"k":"0e569b04e13d1e","t":"ओ"},
{"k":"0e5fc22a3b85b6","t":"मेरे पिताजी"},
{"k":"0e653132921c1b","t":"स्टेशन कहाँ है"},
{"k":"0e6590d2353870","t":"ल"},
{"k":"0e81455e1906bc","t":"आपका घर कैसा है"},
{"k":"0e88ebb9db61e2","t":"प्रिया अभी फ़ोन पर नहीं आ सकती, वह नहा रही है।"},
{"k":"0e952aa999af6c","t":"ठं"},
{"k":"0eabd109899a73","t":"हम कल जयपुर गए।"},
{"k":"0eb1741400f188","t":"ये मेरी दोस्त सारा हैं।. आपसे मिलकर ख़ुशी हुई, सारा जी।"},
{"k":"0eda7cf64e996f","t":"मेरी माँ डॉक्टर हैं।"},
{"k":"0ee53231ff6499","t":"अ से अनार।"},
{"k":"0eef56f8e359c9","t":"मैं जाना चाहता हूँ लेकिन मैं बीमार हूँ"},
{"k":"0ef07834b2c75a","t":"आप कहाँ से हैं"},
{"k":"0f21df609a8cc0","t":"मैं टीचर हूँ।"},
{"k":"0f22b992fa0fe0","t":"छाछ"},
{"k":"0f24351ece14ee","t":"हिं दी"},
{"k":"0f252a59d6b89d","t":"बच्चे बाहर खेल रहे हैं"},
{"k":"0f28df415a7755","t":"तीन सौ रुपये का है।"},
{"k":"0f3f1189875f48","t":"कुल कितना हुआ. कुल डेढ़ सौ रुपये हुए।"},
{"k":"0f6a0cc4c53dda","t":"यह दुपट्टा कितने का है. तीन सौ रुपये का।"},
{"k":"0f70d5610a2ba3","t":"लड़कों"},
{"k":"0f78441afd5882","t":"आपके कमरे में"},
{"k":"0f84a87a7e41fe","t":"नाना"},
{"k":"0f85256bc3aef9","t":"वह लड़की लंबी है।"},
{"k":"0f86fd53edd4f8","t":"ये मेरी दादी जी हैं।"},
{"k":"0fa972f13b0c3e","t":"नमस्ते, आपका स्वागत है अंदर आइए।. शुक्रिया, आंटी।"},
{"k":"0fcf78344d47e4","t":"माफ़ कीजिए।"},
{"k":"0fefd186f2cf3a","t":"सब ठीक है, चिंता मत कीजिए।"},
{"k":"0ff6e6a6649313","t":"मैं हिंदी सीख रही हूँ क्योंकि मेरे पति का परिवार दिल्ली में है।"},
{"k":"1000ab1b2eae65","t":"ये मेरी दोस्त सारा हैं।"},
{"k":"10068d6e84c73a","t":"यहाँ बैठिए।"},
{"k":"1019c26067622c","t":"यह मेरी बहन की किताब है।"},
{"k":"101b0bb0b2f028","t":"क्या आप चाय पिएँगे. हाँ, ज़रूर।"},
{"k":"10204d2ca6037b","t":"चार लड़के"},
{"k":"1039a48cc94c8a","t":"क्या नाश्ता शामिल है. जी हाँ, सुबह सात से दस बजे तक।"},
{"k":"103c5f4d838fcb","t":"कितने लोग हैं"},
{"k":"1043718df2f12f","t":"छ"},
{"k":"105d6b94423ac5","t":"भैया, यह समोसा कितने का है. यह बीस रुपये का है।"},
{"k":"1065250af28faf","t":"मैं न्यूयॉर्क में रहती हूँ।"},
{"k":"10672039eb2175","t":"यह सच है"},
{"k":"1070b77a1ea9ce","t":"आपके पिताजी क्या करते हैं"},
{"k":"107197194def49","t":"आपको आराम करना चाहिए।"},
{"k":"107d238aa39c5f","t":"घी"},
{"k":"1087acad482ff9","t":"परिवार"},
{"k":"108ce2a9526c93","t":"मेरा नाम डेविड है।"},
{"k":"108d0e0f9d6558","t":"सुनिए, कितने बजे हैं"},
{"k":"109a704c018cfd","t":"डा क"},
{"k":"109ec551339f12","t":"मुझे अस्पताल जाना है।"},
{"k":"109ee46c7afbe9","t":"मैंने ताज महल देखा। बहुत सुंदर था"},
{"k":"10b050e8123cda","t":"रोटी पर घी लगाऊँ"},
{"k":"10b2e94b1e6b9f","t":"मैं रास्ता भूल गई हूँ। मेट्रो स्टेशन कहाँ है"},
{"k":"10b75277a171ca","t":"परसों"},
{"k":"10bff462cdd0a4","t":"बहुत-बहुत शुक्रिया।"},
{"k":"10c6440652d7d7","t":"सवा"},
{"k":"10d19322be85a6","t":"हाँ, थोड़ा सा।"},
{"k":"10d36d3a2c4342","t":"क्या आपके भाई-बहन हैं. हाँ, मेरा एक भाई है।"},
{"k":"10d8e03cb61e0c","t":"कोई बात नहीं।"},
{"k":"10e86ef0599fa8","t":"आज बहुत ठंड है।. हाँ, दिल्ली में दिसंबर में ठंड होती है।"},
{"k":"10e99ebf43e811","t":"उ से उल्लू।"},
{"k":"10f3ea615c1892","t":"ये कौन हैं"},
{"k":"110ad822064bf1","t":"मुझे खाँसी है।"},
{"k":"11231303b0a7d8","t":"सारा को चाय पसंद है।"},
{"k":"113a61a7658a34","t":"नमस्ते"},
{"k":"113ba7b2ef20d8","t":"आप बहुत ख़ुश लग रही हैं. हाँ, आज मेरा जन्मदिन है।"},
{"k":"113ec8ae0b3319","t":"औ"},
{"k":"1140bd2d3a263b","t":"मौसी"},
{"k":"11410641573958","t":"चलिए, कुछ खाते हैं।"},
{"k":"11464dca8e3e88","t":"किताबें अलमारी में हैं।"},
{"k":"1163ea2b8d375d","t":"मीटर से चलिए।"},
{"k":"11642ef72f2250","t":"आपके कितने बच्चे हैं. दो बच्चे हैं, एक बेटा और एक बेटी।"},
{"k":"116738673a3e58","t":"यह बीस रुपये का है।"},
{"k":"116d8fe2952015","t":"चिंता मत कीजिए, हम आपकी मदद करेंगे।"},
{"k":"1174a371738e5d","t":"मैं नहीं आ सकता क्योंकि मैं बीमार हूँ।"},
{"k":"117667203f3139","t":"ज"},
{"k":"118e25b5b513f3","t":"एक"},
{"k":"11a64315ecc157","t":"क्या आपके पास टिकट है"},
{"k":"11afeccc8b58e2","t":"सीधे जाइए।"},
{"k":"11b12d34d69b51","t":"धीरे बोलिए, बच्चे सो रहे हैं।"},
{"k":"11b15511cd365a","t":"मेरे दादा जी दिल्ली में हैं।"},
{"k":"11b69837f28075","t":"ठीक नहीं है, मुझे बुख़ार है।"},
{"k":"11b7e1d50a9483","t":"होटल के पीछे"},
{"k":"11bf333d7e4790","t":"अभी लाया।"},
{"k":"11c1e96948efbb","t":"मेरे पति शिकागो में काम करते हैं।"},
{"k":"11cc8572acf3a3","t":"यह किताब कितने की है"},
{"k":"11d7d3ff8faecf","t":"यह महँगी घड़ी किसकी है"},
{"k":"11f56109c8ca21","t":"कु"},
{"k":"11f8384f415a7d","t":"दीदी, ये कितने के हैं"},
{"k":"11fd2ffda6abea","t":"मुझे बुख़ार है, इसलिए मैं घर पर हूँ।"},
{"k":"1206fb69252ee8","t":"कि"},
{"k":"12079eadf8c4c2","t":"मैं ठीक हूँ, बेटा। तुम कैसे हो"},
{"k":"120b3d8031a744","t":"यह बस कनॉट प्लेस जाती है।"},
{"k":"12115a92404120","t":"ए"},
{"k":"1223c01ce87a17","t":"भ से भालू।"},
{"k":"123253c4eba1dc","t":"मैं डॉक्टर हूँ"},
{"k":"1232a300c8e273","t":"दो स्त"},
{"k":"1239af39f1526f","t":"मैं कल दिल्ली जाऊँगी और परसों वापस आऊँगी।"},
{"k":"1253b328583839","t":"मेरा बैग नहीं मिल रहा है"},
{"k":"127b68c440597b","t":"आज गुरुवार है।"},
{"k":"129abe06a6f990","t":"मेरा परिवार भारत से है, लेकिन मैं शिकागो में बड़ी हुई।"},
{"k":"12a5bac81ef246","t":"सब ठीक है। तुम्हारा क्या हाल है"},
{"k":"12b2e4e0c36d0d","t":"उ"},
{"k":"12b74aec7fdf21","t":"मेरी चाबी"},
{"k":"12bb80defdbc36","t":"ठी"},
{"k":"12c2cff881a299","t":"न"},
{"k":"12cb5403d72334","t":"आपको क्या चाहिए. कुछ नहीं, मैं बस देख रहा हूँ।"},
{"k":"12d09042b8993b","t":"मैं रास्ता भूल गई हूँ। मेट्रो स्टेशन कहाँ है. बैंक के सामने है, दो मिनट पैदल।"},
{"k":"12df79a8c33d88","t":"राहुल घर पर है"},
{"k":"12e02fa062276a","t":"पौने पाँच बजे"},
{"k":"12e2783a4ae820","t":"राहुल, यहाँ आओ"},
{"k":"12eacf81d9229e","t":"मेरे दो भाई हैं"},
{"k":"12ebcee55dd97c","t":"आगरा के लिए दो टिकट दीजिए।"},
{"k":"12fa7b530ccca7","t":"आपका नाम बताइए।"},
{"k":"1307b7da52d5bc","t":"दुकानें बंद थीं।"},
{"k":"130aef73a50051","t":"यह बस कहाँ जाती है"},
{"k":"130e152ef5e34b","t":"कार्ड चलेगा"},
{"k":"131fbf48dd0693","t":"एक बजा है।"},
{"k":"1322db7cf095bb","t":"ये केले कितने के हैं"},
{"k":"133ec2908c0110","t":"पुराना शहर बहुत सुंदर है, लेकिन वहाँ बहुत भीड़ है।"},
{"k":"134e9f67eeb4ff","t":"दिल्ली से आगरा तक"},
{"k":"1356040b916260","t":"ये किसके बच्चे हैं. ये शर्मा जी के बच्चे हैं।"},
{"k":"136302bd0af488","t":"गंदे कपड़े"},
{"k":"1380f37cd859f3","t":"सब्ज़ी"},
{"k":"13b6f9b8eefdfd","t":"गर्मी में ठंडी लस्सी सबसे अच्छी लगती है।"},
{"k":"13b9026c2c3885","t":"सोमवार को"},
{"k":"13b92a8db5ece6","t":"भैया, बिल लाइए।. जी, अभी लाता हूँ।"},
{"k":"13cb713496cf02","t":"बड़े कमरे"},
{"k":"13ce098d94262b","t":"बहुत तीखा है।"},
{"k":"13dca3dc66a6f0","t":"बीस"},
{"k":"13f73dcac845de","t":"बहुत महँगा है, थोड़ा कम कीजिए।. ठीक है, ढाई सौ दीजिए।"},
{"k":"13f8c35c7656ed","t":"नहीं, सिर्फ़ कैश।"},
{"k":"13fd54471ea722","t":"लाल साड़ी"},
{"k":"140a2d849330b6","t":"क्या हुआ. मेरे सिर में दर्द है।"},
{"k":"14176296ea6fdb","t":"आज बहुत ठंड है।"},
{"k":"1421abe82704c2","t":"हाँ, थोड़ी-थोड़ी बोलता हूँ।"},
{"k":"1421af1d8cf650","t":"क्या"},
{"k":"1421c1e8afdbc7","t":"मैंने ताज महल देखा"},
{"k":"145018d2996ca6","t":"हम रात को नौ बजे खाना खाते हैं।"},
{"k":"145c32dc41487d","t":"नानी"},
{"k":"146ccbef553e84","t":"लीजिए, आपकी चाय।. शुक्रिया, भैया।"},
{"k":"147d2d715fc654","t":"बच्चे बाहर खेलेंगे"},
{"k":"1495e8a0e65466","t":"बस थोड़ी सी।"},
{"k":"1499bfa7bc4479","t":"आप कल आएँगे न"},
{"k":"14a49ea397a487","t":"फ़ोन"},
{"k":"14a582066c0f81","t":"शुक्रवार को मिलते हैं।. ठीक है, शाम को छह बजे।"},
{"k":"14a5d706073e4d","t":"झूठ"},
{"k":"14aa7365ec66f9","t":"थोड़ा कम कीजिए।"},
{"k":"14ab1e07ecc53c","t":"पचास"},
{"k":"14b4cea0f70f45","t":"ट मा ट र"},
{"k":"14c854a56fa9cc","t":"और"},
{"k":"14cfd94395229f","t":"पाँ च"},
{"k":"14d7cd07e314e9","t":"आ से आम।"},
{"k":"14df37c5d94943","t":"मैं ऑफ़िस में काम करता हूँ।"},
{"k":"14e66061dff4df","t":"हाँ, बैठिए।"},
{"k":"14e6998f7d621a","t":"मैं नौ बजे दफ़्तर जाता हूँ और छह बजे घर आता हूँ।"},
{"k":"14e78cdd051f80","t":"वह"},
{"k":"14eb435e4c34ff","t":"उसने"},
{"k":"14f1aadafcfe07","t":"पहले हम चाय पिएँगे, फिर बाज़ार जाएँगे।"},
{"k":"14f7ef6550b45f","t":"आप कल आएँगे न. हाँ, ज़रूर आऊँगा।"},
{"k":"14fe741282619a","t":"अगला स्टेशन कौन-सा है"},
{"k":"15041e611f5146","t":"मैं कभी-कभी योग करता हूँ।"},
{"k":"151b4b1f01e98c","t":"लस्सी"},
{"k":"151edc7bbfb003","t":"सारा"},
{"k":"1521fc416433fc","t":"आप कैसी हैं"},
{"k":"152213cd967766","t":"हाँ"},
{"k":"152813b2fee9ab","t":"मेरी माँ हिंदी बोलती हैं"},
{"k":"1536386e43f592","t":"मैं पहले बोस्टन में रहता था।"},
{"k":"153d9062f2a459","t":"चावल"},
{"k":"1544e905f6a2c6","t":"मुझे पानी चाहिए"},
{"k":"154e8d2dd0e466","t":"मेरी माँ"},
{"k":"1553305f9210d9","t":"हाँ, आज मेरा जन्मदिन है।"},
{"k":"156bc15987e981","t":"छुट्टे पैसे हैं"},
{"k":"157df604b1b937","t":"इ से इमली।"},
{"k":"15909663b8f0e7","t":"ए क"},
{"k":"15afd3d79066a4","t":"सुनिए, कितने बजे हैं. साढ़े चार बजे हैं।"},
{"k":"15bf7ff8699f16","t":"मैं यहाँ घूमने आई हूँ, काम के लिए नहीं।"},
{"k":"15c852fbba5c9b","t":"खाना बहुत अच्छा है।"},
{"k":"15e4c38d714e94","t":"मैं हिंदी सीख रही हूँ।"},
{"k":"15fc63ed6290b4","t":"जी"},
{"k":"16004493d4ea2c","t":"मैं अभी टीवी देख रहा हूँ।"},
{"k":"1603ed80206e67","t":"पैदल दस मिनट लगते हैं।"},
{"k":"160e306bd25728","t":"स्टेशन बड़े मंदिर के पास है"},
{"k":"1611c25cb2443e","t":"आपसे मिलकर ख़ुशी हुई, सारा जी।"},
{"k":"1621e488ff390f","t":"मेरे पिताजी डॉक्टर हैं।"},
{"k":"1622b715bb0bf5","t":"छुट्टे पैसे हैं. नहीं, सिर्फ़ पाँच सौ का नोट है।"},
{"k":"1627262f281e42","t":"नौ, दस, ग्यारह, बारह"},
{"k":"16276c2cb8dab8","t":"लड़कियाँ यहाँ हैं।"},
{"k":"163f734c26e2ea","t":"आ ओ"},
{"k":"1654d3451fd37b","t":"यह किसका फ़ोन है"},
{"k":"165afc9ac10c57","t":"यह मेरा कमरा है।"},
{"k":"165eaeca30becb","t":"मुझे ठंडा पानी चाहिए"},
{"k":"1663cf477bcf0d","t":"क्या नाश्ता शामिल है"},
{"k":"167d04455d61d7","t":"हम स्टेशन पर हैं"},
{"k":"168007a2e6efe9","t":"आपका कमरा तीसरी मंज़िल पर है।"},
{"k":"16921a042a84a0","t":"डेविड ने आज नीली कमीज़ पहनी है।"},
{"k":"16973fac7a172f","t":"भा ई"},
{"k":"16a948d8d575aa","t":"आपका पासपोर्ट दिखाइए।"},
{"k":"16ab02ef5b5aa3","t":"लड़के ख़ुश हैं"},
{"k":"16c18412852316","t":"एक रात के लिए"},
{"k":"16c4133f83843f","t":"बड़े"},
{"k":"16c4f15f232e7d","t":"दो समोसे"},
{"k":"16c8c580fb2562","t":"यह कितने का है"},
{"k":"16cf89e666a87b","t":"मुझे चाँदनी चौक जाना है।"},
{"k":"16d5f17ff0fde6","t":"क्या आपके पास छुट्टे हैं"},
{"k":"16d7f64bb52802","t":"क्या आपको भारत पसंद है"},
{"k":"16ddd9f78367bf","t":"म"},
{"k":"16e9902781df77","t":"क्या आपको कुछ चाहिए"},
{"k":"16ea96280b5319","t":"मेरा"},
{"k":"16f3f001111a64","t":"बहुत तीखा है"},
{"k":"16f694739d433a","t":"फिर"},
{"k":"17095613835adb","t":"की"},
{"k":"170b51bb528b40","t":"आपसे मिलकर ख़ुशी हुई।"},
{"k":"1722be0a0256a2","t":"मेरी किताब"},
{"k":"172b1a2d49a5e9","t":"पानी ठंडा है"},
{"k":"17318d273744c0","t":"आप क्या करते हैं"},
{"k":"17329e361c5179","t":"कमरा साफ़ है।"},
{"k":"1737c9a3510b49","t":"ये आम मीठे हैं।"},
{"k":"17487b531441da","t":"यह कौन है"},
{"k":"175b69ba7513ec","t":"नहीं, यह झूठ है।"},
{"k":"17720c3467e708","t":"मेरे पिताजी घर पर हैं।"},
{"k":"177335acd98f10","t":"भैया, तीन समोसे दीजिए।"},
{"k":"178055000303c3","t":"ग"},
{"k":"17918dd453f374","t":"मैं बचपन में हिंदी बोलती थी।"},
{"k":"1794469ca8886f","t":"हम"},
{"k":"17b1d9ec3efb04","t":"मैं खाना बना रहा हूँ।"},
{"k":"17b38f7960a65a","t":"कमरे में दो खिड़कियाँ हैं।"},
{"k":"17c41dd34fa3d2","t":"ऊ"},
{"k":"17c435df871c27","t":"तुम कहाँ हो"},
{"k":"17c64960355578","t":"आपके कितने भाई हैं. मेरे दो भाई हैं।"},
{"k":"17d38603cd36ee","t":"आपको कौन-सा रंग पसंद है"},
{"k":"17e07d6aafe004","t":"बच्चे"},
{"k":"17e97103263e43","t":"रोटी पर घी लगाऊँ. हाँ, थोड़ा सा।"},
{"k":"17ea602491a893","t":"ब"},
{"k":"17ed4d8c419a00","t":"पच्चीस"},
{"k":"18108b4aefaa5a","t":"हाँ, और बहुत शांत भी है।"},
{"k":"181a42c544e3a5","t":"बहन"},
{"k":"182bf4d5bfb169","t":"ट्रेन किस प्लेटफ़ॉर्म पर आएगी"},
{"k":"1831b9324a2fd3","t":"नमस्ते, मेरी बुकिंग है।. आपका नाम बताइए।"},
{"k":"183ba43982b751","t":"तीन सौ रुपये का।"},
{"k":"1867d93014eb45","t":"ध"},
{"k":"1873117ee8ce89","t":"यह महँगी घड़ी किसकी है. मेरी है। मेरे पिताजी ने दी।"},
{"k":"187774a2de212e","t":"भ"},
{"k":"188e9490e755ff","t":"नहीं, सिर्फ़ पाँच सौ का नोट है।"},
{"k":"1898d139d58da8","t":"दिवाली पर हम सबको मिठाई देते हैं।"},
{"k":"189c36566c0b01","t":"ख"},
{"k":"18a29f51f581a6","t":"आप बहुत अच्छी हिंदी बोलती हैं"},
{"k":"18adcde857dd47","t":"मैं छात्रा हूँ।"},
{"k":"18bb837ecb5bab","t":"आपको डॉक्टर के पास जाना चाहिए"},
{"k":"18d0fce82ad53a","t":"नमस्ते, नमस्ते। आइए, बैठिए।"},
{"k":"18d14c797219a4","t":"आपको कौन-सा रंग पसंद है. मुझे नीला रंग पसंद है।"},
{"k":"18deb59e22117b","t":"खिड़की"},
{"k":"18e2d364e77e19","t":"मेरी माँ दिल्ली में रहती हैं।"},
{"k":"18e6d18ec937ee","t":"शुक्रिया, भैया।"},
{"k":"18e90bc7672e43","t":"तीन"},
{"k":"18ed07d20405a8","t":"के"},
{"k":"18edf9c3305eb2","t":"दिल्ली से आगरा तक ट्रेन है।"},
{"k":"1901ea791547cd","t":"ट्रेन"},
{"k":"19124defa984a0","t":"अलविदा"},
{"k":"1917346cd6f832","t":"मैंने खाना खाया।"},
{"k":"19201c1aa24d31","t":"आप बहुत ख़ुश लग रही हैं"},
{"k":"19205db89d8a4a","t":"आप कहाँ रहते हैं. मैं शिकागो में रहता हूँ।"},
{"k":"1923379bbb7ba4","t":"आइए, बैठिए।"},
{"k":"193077a0e3c255","t":"लाल क़िला कितनी दूर है"},
{"k":"195974e326777c","t":"यह किसका फ़ोन है. यह राहुल का फ़ोन है।"},
{"k":"195ad894828a9e","t":"घर"},
{"k":"1974b9ccd4c7fb","t":"ज़रा पानी दीजिए।"},
{"k":"197ab0bab69df2","t":"हैं"},
{"k":"198215e6903c60","t":"आप कैसी हैं, सारा"},
{"k":"1990e2e59e27fa","t":"ख़ुश"},
{"k":"19933dc22b70dd","t":"नमस्ते आंटी, आप कैसी हैं"},
{"k":"19a71dca7a713f","t":"आप भारत पहले भी आए हैं"},
{"k":"19aca28e7de499","t":"आगरा की ट्रेन कितने बजे जाएगी"},
{"k":"19b1be63262031","t":"ज्ञान"},
{"k":"19c6fd344ab052","t":"कौआ"},
{"k":"19eb7bfb3325c8","t":"पास में दवाई की दुकान कहाँ है. अस्पताल के सामने एक दुकान है।"},
{"k":"1a110506348459","t":"मैं सोमवार को ऑफ़िस जाता हूँ।"},
{"k":"1a274d595ace9a","t":"मेरे दो भाई हैं।"},
{"k":"1a2828058f2908","t":"नमस्कार।"},
{"k":"1a2a4b08d7669e","t":"आपकी तबीयत कैसी है. ठीक नहीं है, मुझे बुख़ार है।"},
{"k":"1a3176fcde32b4","t":"शुक्रिया, आंटी।"},
{"k":"1a47a3b21018c1","t":"वे हिंदी नहीं बोलते।"},
{"k":"1a50f4ce518324","t":"बहुत गर्मी है, पंखा चलाइए।"},
{"k":"1a685920b591ce","t":"पौने सात बजे जाएगी।"},
{"k":"1a7154cbce2860","t":"दिल्ली में मौसम कैसा है. आज बहुत गर्मी है।"},
{"k":"1a7b0d18d320ef","t":"रसोई"},
{"k":"1a7e237d158f99","t":"प्रिया रोज़ चाय पीती है।"},
{"k":"1a8878c12e1564","t":"लड़कियाँ"},
{"k":"1a8cb9bf1f42fb","t":"वह नहा रही है।"},
{"k":"1ab18414b896f4","t":"फिर से बोलिए।"},
{"k":"1ab79b14237eb0","t":"मुझे यह पसंद है।"},
{"k":"1ab82204dadee6","t":"मुझे भूख लगी है।. चलिए, कुछ खाते हैं।"},
{"k":"1abb7cb5d87dec","t":"मैं घर जाना चाहता हूँ"},
{"k":"1aced3dc300101","t":"निन्यानवे"},
{"k":"1aeca1eee47184","t":"आपके चाचा कहाँ रहते हैं"},
{"k":"1af0ce2aa07cc7","t":"वे यहाँ हैं"},
{"k":"1af85a4696a1bf","t":"मेरे दोस्त के पास गाड़ी है"},
{"k":"1b054d532c5dff","t":"सुनिए, स्टेशन कहाँ है"},
{"k":"1b0b50d4ee62a6","t":"मैं यह लूँगी।"},
{"k":"1b0edf38df8155","t":"ये किसके बच्चे हैं"},
{"k":"1b1622473a70e2","t":"मैं कल दिल्ली जाऊँगा"},
{"k":"1b2e8ee0f89d0d","t":"यह बैग किसका है"},
{"k":"1b41e5e281e9fa","t":"यह सारा की किताब है।"},
{"k":"1b465ffbd72fae","t":"व"},
{"k":"1b47c052e00215","t":"मत करो"},
{"k":"1b4afb579800d3","t":"मैं कल नहीं आऊँगा।. क्यों"},
{"k":"1b4b6f5d5a381b","t":"आ"},
{"k":"1b507570733144","t":"घ"},
{"k":"1b58bf93b96b7a","t":"कितनी दूर है"},
{"k":"1b6031b6a4d057","t":"इस"},
{"k":"1b725d073ffbc4","t":"यह बस कहाँ जाती है. यह बस कनॉट प्लेस जाती है।"},
{"k":"1b768269be8814","t":"इन कमरों में"},
{"k":"1b7931333e73bc","t":"मेट्रो स्टेशन के पास"},
{"k":"1b79815046c14a","t":"बैंक के सामने है, दो मिनट पैदल।"},
{"k":"1b8bdc2276d4ca","t":"कार्ड चलेगा. नहीं, सिर्फ़ कैश।"},
{"k":"1b9b8eef15c6b9","t":"बेटा"},
{"k":"1ba67188f092f3","t":"साढ़े तीन बजे"},
{"k":"1ba72cb40765fc","t":"दोस्त"},
{"k":"1bad02f070e78a","t":"क्या इसमें बड़ा साइज़ है. जी हाँ, एक मिनट रुकिए।"},
{"k":"1bc6a13019f0c0","t":"ज़रा मदद कीजिए।"},
{"k":"1bd66c6e763446","t":"कोई बात नहीं, बैठिए।"},
{"k":"1bdf812223516c","t":"मैं बचपन में हिंदी बोलती थी, लेकिन अब भूल गई हूँ।"},
{"k":"1bfa68ef845b2a","t":"आपके पिताजी क्या करते हैं. मेरे पिताजी डॉक्टर हैं।"},
{"k":"1c00e15b52a4f5","t":"आपके चाचा कहाँ रहते हैं. मेरे चाचा जयपुर में रहते हैं।"},
{"k":"1c0330e2fe8075","t":"आज कौन-सा दिन है. आज गुरुवार है।"},
{"k":"1c05e7fa804ec5","t":"ठ"},
{"k":"1c07f9c22f850b","t":"मुझे बुख़ार है इसलिए मैं घर पर हूँ"},
{"k":"1c0a5663292e07","t":"पुलिस को बुलाइए"},
{"k":"1c0c6ae51d5f64","t":"आपका नाम क्या है"},
{"k":"1c0d52274ae991","t":"आप कहाँ से हैं. मैं अमरीका से हूँ, बोस्टन से।"},
{"k":"1c146fe9db7c4e","t":"मेरा होटल मेट्रो स्टेशन के पास है।"},
{"k":"1c151f717433c4","t":"वह कौन है"},
{"k":"1c25febf6285b7","t":"भैया, एक चाय दीजिए।"},
{"k":"1c2672abbf071d","t":"ऋ"},
{"k":"1c5020f0d624e2","t":"दादी"},
{"k":"1c613d310fe82d","t":"होटल मेट्रो स्टेशन के पास है।"},
{"k":"1c67ce4cdb0adb","t":"भैया, एक चाय दीजिए।. अभी लाया।"},
{"k":"1c76567b8dfa1c","t":"तीन लड़कियाँ"},
{"k":"1c8854f207f06b","t":"मैं बहुत थकी हुई थी।"},
{"k":"1c907fa525ce94","t":"पैसे"},
{"k":"1c97055b6d4d91","t":"एक मसाला डोसा और एक कॉफ़ी।"},
{"k":"1c999a472aeccd","t":"मैं यहाँ घूमने आई हूँ।"},
{"k":"1c9c5b0a0e7b2f","t":"क्या मैं यहाँ बैठ सकता हूँ"},
{"k":"1ca310ece06ee7","t":"मेरे पति"},
{"k":"1ca8e31def1ab0","t":"किताबें कमरों में हैं।"},
{"k":"1cacf73f4be7a9","t":"कल सात बजे मिलें. ठीक है, सात बजे।"},
{"k":"1cb3570314754e","t":"मेरे पिताजी डॉक्टर हैं"},
{"k":"1cc20abf1095ab","t":"आप कैसी हैं, सारा. मैं बहुत ख़ुश हूँ, आज मेरा जन्मदिन है"},
{"k":"1cc7d1241917bd","t":"आपने आगरा में क्या देखा. मैंने ताज महल देखा। बहुत सुंदर था"},
{"k":"1ccf286855c356","t":"आप कब आएँगे"},
{"k":"1cdea0860e7b05","t":"मिठाई"},
{"k":"1ce66c004caa0a","t":"त"},
{"k":"1cfa70be29245d","t":"बेटी"},
{"k":"1cfe69d58eb2cc","t":"क्या हाल है, अमित. सब ठीक है। तुम्हारा क्या हाल है"},
{"k":"1d065faf952cbe","t":"मैं अमरीका से हूँ"},
{"k":"1d309841470c79","t":"दो बच्चे हैं, एक बेटा और एक बेटी।"},
{"k":"1d33087032ae79","t":"उस"},
{"k":"1d3337b07a22ce","t":"ठीक है, ढाई सौ दीजिए।"},
{"k":"1d3bd0e3227913","t":"आप कहाँ रहते हैं"},
{"k":"1d3e51a58f1fe9","t":"मेरे सिर में दर्द है।"},
{"k":"1d494547a7bf81","t":"सुबह आठ बजे"},
{"k":"1d4d5be9622628","t":"इस लड़के को पानी दीजिए, यह बहुत थका हुआ है।"},
{"k":"1d54d4446a45d9","t":"दादा"},
{"k":"1d582ae35f7a99","t":"भैया, ज़रा पानी दीजिए, यह बहुत तीखा है।"},
{"k":"1d7e0a136af9f9","t":"भैया, दो किलो आम का आख़िरी दाम क्या है"},
{"k":"1d84f422bdd904","t":"डॉक्टर साहब, मुझे खाँसी है।"},
{"k":"1d91a7729a1687","t":"आप क्या लेंगे"},
{"k":"1d93473416a640","t":"का"},
{"k":"1d9c0b33d0b399","t":"आइए, बैठिए।. शुक्रिया।"},
{"k":"1da2b279592620","t":"अरे, शुक्रिया"},
{"k":"1dbbcb55fb4063","t":"बच्चे सो रहे हैं।"},
{"k":"1dbde91955da2b","t":"कमरा"},
{"k":"1dc77d94a4c159","t":"मौसम कैसा है"},
{"k":"1dcdc3057e564d","t":"आपका नाम क्या है. मेरा नाम डेविड है।"},
{"k":"1dce05167fc623","t":"दाल और रोटी"},
{"k":"1dd04b6d6dd0d0","t":"पास में दवाई की दुकान कहाँ है"},
{"k":"1df0bc2249b8a5","t":"हिंदी"},
{"k":"1df7c9c6a338a2","t":"कै"},
{"k":"1df7f9a5440c51","t":"लड़कियाँ यहाँ हैं"},
{"k":"1e00379f06160b","t":"मैं ठीक हूँ, शुक्रिया। और आप"},
{"k":"1e0a47b473d92c","t":"आप कहाँ रहती हैं"},
{"k":"1e17617bf6e78a","t":"ट्रेन लेट है।"},
{"k":"1e22058cc3d379","t":"पानी"},
{"k":"1e2afc74ac6fc5","t":"फ"},
{"k":"1e2bd1944a598a","t":"ढाई बजे"},
{"k":"1e3347b8bf03b2","t":"वे यहाँ नहीं हैं"},
{"k":"1e35dec19db5e4","t":"ड़"},
{"k":"1e362600efe54d","t":"आख़िरी दाम क्या है"},
{"k":"1e3a2fd9b68981","t":"आप क्या करती हैं"},
{"k":"1e4be722f51aaa","t":"मैं कल दिल्ली जाऊँगी।"},
{"k":"1e567f2e7a7551","t":"आप क्या कर रहे हैं"},
{"k":"1e6221f680ef93","t":"चिंता मत करो"},
{"k":"1e6bed4dcd93dc","t":"यह क्या है"},
{"k":"1e6d017e476aab","t":"हाँ, मेरा एक भाई है।"},
{"k":"1e6ee5c70d56cf","t":"मुझे एक टिकट चाहिए।"},
{"k":"1e70b3677c694d","t":"डेढ़ सौ रुपये"},
{"k":"1e7d5a1715753e","t":"झू ठ"},
{"k":"1e82576fa7ffcf","t":"तोता"},
{"k":"1e85dd848348cb","t":"अच्छी लड़की"},
{"k":"1e8cd7d5d95af0","t":"दिल्ली से आगरा की ट्रेन सुबह छह बजे है।"},
{"k":"1e8e694f7a9a43","t":"मैं घर नहीं जा रहा"},
{"k":"1e9bc96c858aa2","t":"ढ"},
{"k":"1eabcf06935e41","t":"अस्पताल के सामने एक दुकान है।"},
{"k":"1ebc2f4977acdf","t":"ऐ"},
{"k":"1ec6fdb05d2404","t":"यह सच है. नहीं, यह झूठ है।"},
{"k":"1ed2cc67b3149b","t":"नमस्ते, मेरी बुकिंग है।"},
{"k":"1ee84df41eb9cd","t":"आपको कौन-सा फल पसंद है. मुझे आम पसंद है।"},
{"k":"1eea58d445d6f0","t":"मेरे पास गाड़ी है, मैं आपको स्टेशन छोड़ दूँगा।"},
{"k":"1eec79b12514e7","t":"पहले हम आगरा गए, फिर जयपुर।"},
{"k":"1efbe6a358bb10","t":"एक लाख"},
{"k":"1f15ff871d9501","t":"लाल क़िला कितनी दूर है. यहाँ से पाँच किलोमीटर है।"},
{"k":"1f1c4535974343","t":"आपकी माँ कहाँ रहती हैं"},
{"k":"1f23e591aaba8c","t":"कौ"},
{"k":"1f31f8bfe70555","t":"हाँ, दिल्ली में दिसंबर में ठंड होती है।"},
{"k":"1f331ac266bc35","t":"जी हाँ, मैं सारा हूँ।"},
{"k":"1f3a7d6c33bd29","t":"मुझे ठंड लग रही है, खिड़की बंद कीजिए।"},
{"k":"1f523777d9ce75","t":"आप क्या करती हैं. मैं टीचर हूँ।"},
{"k":"1f61f905d35add","t":"अच्छा लड़का"},
{"k":"1f6adb3b01f62c","t":"य"},
{"k":"1f73ce3dab344b","t":"मेरी बहन"},
{"k":"1f7e39af76fba2","t":"इस शहर में एक लाख लोग रहते हैं।"},
{"k":"1f7f4422c4a10e","t":"ह से हाथी।"},
{"k":"1f8524f35aaf30","t":"आप"},
{"k":"1f85f8258fa115","t":"अच्छा, नमस्ते। फिर मिलेंगे।. हाँ, ज़रूर। अपना ध्यान रखिए।"},
{"k":"1f8968a77ef87c","t":"यह दवाई दिन में दो बार लीजिए, खाने के बाद।"},
{"k":"1fc6cac923bfca","t":"ण"},
{"k":"1fcd3fce83a9fd","t":"क्यों"},
{"k":"1fdd7feb061c08","t":"ई"},
{"k":"1fedfa0d97376f","t":"लड़की"},
{"k":"1fee5b6f510a50","t":"पैक कर दीजिए।"},
{"k":"1ff317641ef5ce","t":"किताब"},
{"k":"1ff932ac997392","t":"बढ़िया तुम सुनाओ।"},
{"k":"1ffc3107119dd7","t":"अच्छा"}]}
